+/*
+ * H96 v6.0 cursor fix, part 2: sticky HW-cursor re-latch.
+ *
+ * Part 1 (rockchip_atomic_helper_update_plane) only guarantees that a cursor IMAGE
+ * commit's own shadow write reaches the active register bank. It does not cover the
+ * steady state where the cursor is stationary (no cursor commit running) while
+ * another plane on the same video port commits continuously (mpv Xv fullscreen, a
+ * Chromium animated page, a Plasma splash). Every such flush arms this VP's cfg_done
+ * and latches the VP shadow bank at frame-start without re-writing the cursor
+ * window; observed on RK3588, that can drop the cursor window's content so the
+ * cursor stays on its previous (transparent/hidden) image until the next cursor
+ * commit.
+ *
+ * Re-assert the cursor window's content-latching registers (yrgb_mst + win and
+ * cluster enable) on every non-cursor flush while the cursor is up, so the cursor
+ * rides along with each video-port latch. The address comes from vp->cursor_mst,
+ * a snapshot written under reg_lock by the cursor window's own atomic_update
+ * (and cleared by its disable), not from cursor->state: plane state is swapped
+ * before the commit tail takes ovl_lock, so reading it here could program a cursor
+ * fb whose geometry has not been written yet. The snapshot always matches what the
+ * hardware was last programmed with, so the write is idempotent in the common case
+ * and self-healing when the content had been dropped.
+ */
+static void vop2_crtc_relatch_cursor(struct drm_crtc *crtc, struct drm_atomic_state *state)
+{
+	struct vop2_video_port *vp = to_vop2_video_port(crtc);
+	struct rockchip_crtc_state *vcstate = to_rockchip_crtc_state(crtc->state);
+	struct vop2 *vop2 = vp->vop2;
+	struct drm_plane *cursor = crtc->cursor;
+	struct vop2_win *cwin;
+
+	/* no cursor plane bound to this crtc, or crtc is off */
+	if (!cursor || !crtc->state->active)
+		return;
+
+	/* leave splice (two VPs driving one output) paths alone */
+	if (vcstate->splice_mode)
+		return;
+
+	/*
+	 * If the cursor plane is part of THIS commit, its own win update already
+	 * (re)programs and latches it; don't double-program or race its newer write.
+	 */
+	if (drm_atomic_get_new_plane_state(state, cursor))
+		return;
+
+	cwin = to_vop2_win(cursor);
+
+	/*
+	 * Re-assert content + visibility only. Do NOT call vop2_win_enable(): the cursor
+	 * is already up so its power domain is already held; a per-frame pd_get would
+	 * imbalance the refcount. These writes are armed by the vop2_cfg_done() that this
+	 * flush issues right after, exactly like every other shadow write here.
+	 */
+	spin_lock(&vop2->reg_lock);
+	if (vp->cursor_armed) {
+		VOP_WIN_SET(vop2, cwin, yrgb_mst, vp->cursor_mst);
+		VOP_WIN_SET(vop2, cwin, enable, 1);
+		VOP_CLUSTER_SET(vop2, cwin, enable, 1);
+	}
+	spin_unlock(&vop2->reg_lock);
+}
