@@ -2053,6 +2062,18 @@ static void vop2_power_domain_put(struct vop2_power_domain *pd)
 		vop2_power_domain_put(pd->parent);
 }
 
+/* power on a domain that was turned off under held references */
+static void vop2_power_domain_ensure_on(struct vop2_power_domain *pd)
+{
+	if (pd->parent)
+		vop2_power_domain_ensure_on(pd->parent);
+
+	spin_lock(&pd->lock);
+	if (!pd->on)
+		vop2_power_domain_on(pd);
+	spin_unlock(&pd->lock);
+}
+
 static void vop2_power_domain_put_sync(struct vop2_power_domain *pd)
 {
 	vop2_power_domain_put(pd);
@@ -2090,9 +2111,9 @@ static void vop2_win_enable(struct vop2_win *win)
 	 * take effect, but the pd is disable in progress, we should do pd_get
 	 * at this situation.
 	 *
-	 * check the backup register for previous enable operation.
+	 * The reference is tracked in win->pd_held: register readback lags a frame.
 	 */
-	if (!VOP_WIN_GET_REG_BAK(win->vop2, win, enable)) {
+	if (!win->pd_held) {
 		if (win->pd) {
 			if ((win->pd->data->id == VOP2_PD_ESMART && win->vop2->version == VOP_VERSION_RK3588) ||
 			    win->vop2->version == VOP_VERSION_RK3576)
@@ -2100,10 +2121,25 @@ static void vop2_win_enable(struct vop2_win *win)
 
 			vop2_power_domain_get(win->pd);
 			win->pd->vp_mask |= win->vp_mask;
+			win->pd_held = true;
 		}
+	} else if (!win->pd->on) {
+		vop2_power_domain_ensure_on(win->pd);
+		win->pd->vp_mask |= win->vp_mask;
 	}
 }
 
+/* drop the domain reference this window holds, if any */
+static void vop2_win_pd_release(struct vop2_win *win)
+{
+	if (!win->pd || !win->pd_held || win->pd->data->id == VOP2_PD_ESMART)
+		return;
+
+	vop2_power_domain_put(win->pd);
+	win->pd->vp_mask &= ~win->vp_mask;
+	win->pd_held = false;
+}
+
 static void vop2_win_multi_area_disable(struct vop2_win *parent)
 {
