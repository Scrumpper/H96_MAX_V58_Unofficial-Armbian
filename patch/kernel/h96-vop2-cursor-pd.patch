@@ -7754,6 +7790,7 @@ static int vop2_crtc_loader_protect(struct drm_crtc *crtc, bool on, void *data)
 					    VOP_WIN_GET(vop2, splice_win, enable)) {
 						splice_win->pd->ref_count++;
 						splice_win->pd->vp_mask |= BIT(splice_vp->id);
