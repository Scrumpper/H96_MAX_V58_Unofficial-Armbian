 };
 
+/* iommu bind runs once, after the last available rga node has probed */
+static DEFINE_MUTEX(rga_bind_lock);
+static unsigned int rga_expected_nodes;
+
+static unsigned int rga_count_available_nodes(void)
+{
+	const struct of_device_id *tables[] = { rga3_dt_ids, rga2_dt_ids };
+	struct device_node *np;
+	unsigned int n = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(tables); i++)
+		for_each_matching_node(np, tables[i])
+			if (of_device_is_available(np))
+				n++;
+
+	return n;
+}
+
+/* force: bind with whatever has probed (first open fallback) */
+static int rga_try_bind(bool force)
+{
+	int ret = 0;
+
+	mutex_lock(&rga_bind_lock);
+	if (rga_bound)
+		goto out;
+	if (!force && rga_drvdata->num_of_scheduler < rga_expected_nodes)
+		goto out;
+	if (rga_drvdata->num_of_scheduler == 0) {
+		ret = -ENODEV;
+		goto out;
+	}
+
+	ret = rga_iommu_bind();
+	if (ret < 0)
+		pr_err("rga iommu bind failed!\n");
+	else
+		rga_bound = true;
+out:
+	mutex_unlock(&rga_bind_lock);
+
+	return ret;
+}
+
+/* scheduler probed after a forced bind: share the default mapping domain */
+static void rga_attach_late_scheduler(struct rga_scheduler_t *scheduler)
+{
+	struct rga_iommu_info *main_iommu;
+	int idx;
+
+	mutex_lock(&rga_bind_lock);
+	idx = rga_drvdata->map_scheduler_index;
+	if (!rga_bound || idx < 0 || !scheduler->iommu_info ||
+	    scheduler->data->mmu != RGA_IOMMU)
+		goto out;
+
+	main_iommu = rga_drvdata->scheduler[idx]->iommu_info;
+	if (!main_iommu || main_iommu == scheduler->iommu_info)
+		goto out;
+
+	scheduler->iommu_info->domain = main_iommu->domain;
+	scheduler->iommu_info->default_dev = main_iommu->default_dev;
+	rga_iommu_attach(scheduler->iommu_info);
+out:
+	mutex_unlock(&rga_bind_lock);
+}
+
 static int init_scheduler(struct rga_scheduler_t *scheduler,
 			  struct device *dev,
 			  const struct rga_match_data_t *match_data,
@@ -1447,6 +1526,11 @@ static int rga_drv_probe(struct platform_device *pdev)
 	dev_info(dev, "probe successfully, irq = %d, hw_version:%s\n",
