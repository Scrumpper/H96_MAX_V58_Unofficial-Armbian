diff --git a/net/rfkill/rfkill-wlan.c b/net/rfkill/rfkill-wlan.c
index 6e0f16271..d936991e7 100644
--- a/net/rfkill/rfkill-wlan.c
+++ b/net/rfkill/rfkill-wlan.c
@@ -345,8 +345,41 @@ EXPORT_SYMBOL(rockchip_wifi_power);
  * Wifi Sdio Detect Func
  *
  *************************************************************************/
+/* H96 patch: the BSP left this a no-op stub, so nothing ever rescanned the SDIO
+ * bus after the WiFi driver powered the chip. Register the WiFi SDIO mmc_host
+ * (done from dw_mmc for the non-removable host) and trigger a rescan here. */
+static struct mmc_host *rockchip_wifi_sdio_host;
+static DEFINE_SPINLOCK(rockchip_wifi_sdio_host_lock);
+
+/* host == NULL unregisters (called from the dw_mmc slot cleanup path) */
+void rockchip_wifi_set_sdio_host(struct mmc_host *host)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&rockchip_wifi_sdio_host_lock, flags);
+	rockchip_wifi_sdio_host = host;
+	spin_unlock_irqrestore(&rockchip_wifi_sdio_host_lock, flags);
+}
+EXPORT_SYMBOL(rockchip_wifi_set_sdio_host);
+
 int rockchip_wifi_set_carddetect(int val)
 {
+	struct mmc_host *host;
+	unsigned long flags;
+
+	spin_lock_irqsave(&rockchip_wifi_sdio_host_lock, flags);
+	host = rockchip_wifi_sdio_host;
+	spin_unlock_irqrestore(&rockchip_wifi_sdio_host_lock, flags);
+
+	if (host) {
+		LOG("%s: %s SDIO host (val=%d)\n", __func__,
+		    val ? "rescan" : "remove", val);
+		/* mmc_rescan() skips non-removable hosts after their first scan
+		 * (rescan_entered). The WiFi chip is only powered now, after that
+		 * boot scan, so clear the flag to force a real re-scan. */
+		host->rescan_entered = 0;
+		mmc_detect_change(host, 0);
+	}
 	return 0;
 }
 EXPORT_SYMBOL(rockchip_wifi_set_carddetect);
