diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
index d9a8302a5..c80ef42c3 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
@@ -48,6 +48,11 @@
 
 #include <media/cec-notifier.h>
 
+/* manual override; 0 = PA from the sink EDID read over DDC */
+static ushort cec_phys_addr;
+module_param(cec_phys_addr, ushort, 0644);
+MODULE_PARM_DESC(cec_phys_addr, "CEC physical address override, 0x1000 = 1.0.0.0 (0 = from the sink EDID)");
+
 #define DDC_CI_ADDR		0x37
 #define DDC_SEGMENT_ADDR	0x30
 
@@ -400,8 +405,68 @@ struct dw_hdmi_qp {
 	struct work_struct flt_work;
 	struct workqueue_struct *workqueue;
 	struct notifier_block hdcp2_nb;
+
+	bool cec_sink_pa_read;		/* cec_sink_pa cached until the next HPD event */
+	u16 cec_sink_pa;
 };
 
+/* CEC PA is assigned by the sink: read its own EDID, an override EDID carries another PA */
+static u16 dw_hdmi_qp_sink_phys_addr(struct dw_hdmi_qp *hdmi)
+{
+	struct i2c_msg msgs[2] = {
+		{ .addr = DDC_ADDR, .len = 1 },
+		{ .addr = DDC_ADDR, .flags = I2C_M_RD, .len = EDID_LENGTH },
+	};
+	u16 pa = CEC_PHYS_ADDR_INVALID;
+	u8 *buf;
+	u8 off;
+	int i;
+
+	if (hdmi->cec_sink_pa_read)
+		return hdmi->cec_sink_pa;
+	if (!hdmi->ddc)
+		return pa;
+
+	buf = kmalloc(2 * EDID_LENGTH, GFP_KERNEL);
+	if (!buf)
+		return pa;
+
+	msgs[0].buf = &off;
+	for (i = 0; i < 2; i++) {
+		off = i * EDID_LENGTH;
+		msgs[1].buf = buf + off;
+		/* read failure: not cached, retried on the next call */
+		if (i2c_transfer(hdmi->ddc, msgs, 2) != 2 ||
+		    !drm_edid_block_valid(buf + off, i, false, NULL))
+			goto out;
+		if (!i && !buf[0x7e])
+			break;
+	}
+	if (i == 2)
+		pa = cec_get_edid_phys_addr(buf, 2 * EDID_LENGTH, NULL);
+	hdmi->cec_sink_pa = pa;
+	hdmi->cec_sink_pa_read = true;
+out:
+	kfree(buf);
+	return pa;
+}
+
+static void dw_hdmi_qp_cec_set_pa(struct dw_hdmi_qp *hdmi, const struct edid *edid)
+{
+	u16 pa;
+
+	if (cec_phys_addr) {
+		cec_notifier_set_phys_addr(hdmi->cec_notifier, cec_phys_addr);
+		return;
+	}
+
+	pa = dw_hdmi_qp_sink_phys_addr(hdmi);
+	if (pa != CEC_PHYS_ADDR_INVALID)
+		cec_notifier_set_phys_addr(hdmi->cec_notifier, pa);
+	else
+		cec_notifier_set_phys_addr_from_edid(hdmi->cec_notifier, edid);
+}
