From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Scrumpper <190908034+Scrumpper@users.noreply.github.com>
Date: Mon, 19 Oct 2026 22:08:53 -0700
Subject: [PATCH 23/59] arm64: dts: rockchip: h96-max-v58: drop wl_reg_on gpio
 hog

The hog on GPIO0_C4 collides with rfkill-wlan's gpiod request of
WIFI,poweren-gpios on 6.12 (-EBUSY), so Wi-Fi power never cycles and
bcmdhd's PCIe RESET path re-links a chip that was never reset. 6.1 drove
the line through the legacy GPIO API despite the hog. rfkill-wlan
requests the line GPIOD_OUT_HIGH at probe, so the chip stays powered
from probe on.
---
 arch/arm64/boot/dts/rockchip/rk3588-h96-max-v58.dts | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-h96-max-v58.dts b/arch/arm64/boot/dts/rockchip/rk3588-h96-max-v58.dts
index 6c10d5a1e..a90228508 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-h96-max-v58.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-h96-max-v58.dts
@@ -162,15 +162,6 @@ &vcc3v3_pcie30 {
 	status = "okay";
 };
 
-&gpio0 {
-	wl_reg_on_hog {
-		gpio-hog;
-		gpios = <RK_PC4 GPIO_ACTIVE_HIGH>;
-		line-name = "wl_reg_on";
-		output-high;
-	};
-};
-
 &sdio {
 	status = "disabled";
 };
