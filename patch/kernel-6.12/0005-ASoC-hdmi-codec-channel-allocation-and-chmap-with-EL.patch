From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: H96 build <builder@h96-build>
Date: Fri, 16 Oct 2026 00:00:00 +0000
Subject: [PATCH 05/59] ASoC: hdmi-codec: channel allocation and chmap with ELD
 bypass

With the "ELD Bypass Switch" control on, hdmi_codec_get_ch_alloc_table_idx()
returned index 0 (stereo) for every channel count. It now picks the
default CEA allocation for the requested count (8ch: CA 0x13, 6ch:
CA 0x0b, else 0x00), falling back to the first table entry with that
channel count. Startup selects the 8ch chmap table (indexed by CA id)
when more than two channels are possible.

Gated at runtime: active only with the ELD bypass control on.

H96 series: baef8e6fa / 56a560375.
---
 sound/soc/codecs/hdmi-codec.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/hdmi-codec.c b/sound/soc/codecs/hdmi-codec.c
index b64675214..4b0a1c5cf 100644
--- a/sound/soc/codecs/hdmi-codec.c
+++ b/sound/soc/codecs/hdmi-codec.c
@@ -363,8 +363,19 @@ static int hdmi_codec_get_ch_alloc_table_idx(struct hdmi_codec_priv *hcp,
 	unsigned long spk_mask;
 	const struct hdmi_codec_cea_spk_alloc *cap = hdmi_codec_channel_alloc;
 
-	if (hcp->eld_bypass)
-		return 0;
+	if (hcp->eld_bypass) {
+		/* no ELD: default CEA allocation for the requested channel count */
+		u8 ca = channels == 8 ? 0x13 : channels == 6 ? 0x0b : 0x00;
+
+		for (i = 0; i < ARRAY_SIZE(hdmi_codec_channel_alloc); i++)
+			if (hdmi_codec_channel_alloc[i].ca_id == ca &&
+			    hdmi_codec_channel_alloc[i].n_ch == channels)
+				return i;
+		for (i = 0; i < ARRAY_SIZE(hdmi_codec_channel_alloc); i++)
+			if (hdmi_codec_channel_alloc[i].n_ch == channels)
+				return i;
+		return -EINVAL;
+	}
 
 	spk_alloc = drm_eld_get_spk_alloc(hcp->eld);
 	spk_mask = hdmi_codec_spk_mask_from_alloc(spk_alloc);
@@ -509,6 +520,12 @@ static int hdmi_codec_startup(struct snd_pcm_substream *substream,
 
 		/* Select chmap supported */
 		hdmi_codec_eld_chmap(hcp);
+	} else if (tx && hcp->eld_bypass) {
+		/* chmap_idx is a CA id: the 8ch table is indexed by CA id */
+		if (hcp->chmap_info->max_channels > 2)
+			hcp->chmap_info->chmap = hdmi_codec_8ch_chmaps;
+		else
+			hcp->chmap_info->chmap = hdmi_codec_stereo_chmaps;
 	}
 
 	hcp->busy = true;
