# h96-shairport.service - AirPlay audio receiver -> HDMI/PipeWire
# TEMPLATE. Placeholders __DESKTOP_USER__ __UID__ __HOME__ substituted by
# h96-cast at 'enable' (recommended). If build injects this file directly,
# substitute placeholders in [4z] write_one, or let h96-cast rewrite it.
[Unit]
Description=h96 AirPlay audio receiver (shairport-sync -> HDMI/PipeWire)
Documentation=man:shairport-sync(1)
After=network-online.target avahi-daemon.service sound.target
Wants=network-online.target avahi-daemon.service

[Service]
User=__DESKTOP_USER__
Group=__DESKTOP_USER__
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=PULSE_SERVER=unix:/run/user/__UID__/pulse/native
Environment=DISPLAY=:0
Environment=XAUTHORITY=__HOME__/.Xauthority
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /run/user/__UID__/pulse/native ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/shairport-sync -a "H96 Max V58" -o pa
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
