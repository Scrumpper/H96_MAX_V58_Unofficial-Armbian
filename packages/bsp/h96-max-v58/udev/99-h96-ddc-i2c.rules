# The h96-ddc-i2c-gpio overlay exposes the dead HDMI DDC pins as a kernel i2c
# bus named "i2c-ddc". Let the desktop session (video group) read/write it so
# ddcutil, h96-brightness, and KDE PowerDevil can control external-monitor
# brightness over DDC/CI without root.
KERNEL=="i2c-[0-9]*", SUBSYSTEM=="i2c-dev", ATTR{name}=="i2c-ddc", GROUP="video", MODE="0660"
