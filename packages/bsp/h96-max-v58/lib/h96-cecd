#!/usr/bin/env python3
# h96-cecd: HDMI-CEC to uinput daemon for H96 Max V58 (RK3588).
# Listens for CEC "User Control Pressed" events from the TV remote and injects
# them as Linux input key events through /dev/uinput, so the remote drives
# KDE Plasma, mpv and Kodi. Talks to the kernel CEC API via /dev/cec0.
# Backend priority: cec-client (libcec, turnkey key decode), then cec-ctl
# (v4l-utils, kernel-native). Exits 0 with no backend/device so systemd does
# not crash-loop. No third-party Python deps; uinput driven via ctypes/struct.
# Also serves display wake/blank requests from the session watcher (h96-cec-wake)
# on WAKE_SOCK: wake = TV on + active source, blank = TV standby (opt-in flag).

import fcntl
import os
import re
import select
import shutil
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

CEC_DEV = os.environ.get("H96_CEC_DEV", "/dev/cec0")
UINPUT_DEV = "/dev/uinput"
OSD_NAME = os.environ.get("H96_CEC_OSD", "H96")
KEYMAP_FILE = "/etc/h96/cec-keymap.conf"
WAKE_SOCK = os.environ.get("H96_CEC_WAKE_SOCK", "/run/h96-cec/wake.sock")
WAKE_OFF_FLAG = "/etc/h96/cec-wake.off"
BLANK_FLAG = "/etc/h96/cec-standby-on-blank"
SEAT_FILE = "/run/systemd/seats/seat0"
DEBOUNCE_S = 10.0

# live cec-client process (libcec backend); None with the cec-ctl backend
LIBCEC = {"proc": None}
LIBCEC_LOCK = threading.Lock()


def log(*a):
    print("h96-cecd:", *a, file=sys.stderr, flush=True)


