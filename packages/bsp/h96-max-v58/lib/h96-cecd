def load_keymap():
    m = dict(DEFAULT_MAP)
    try:
        with open(KEYMAP_FILE) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if not line or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                m[k.strip().lower().replace(" ", "-").replace("_", "-")] = v.strip()
        log("loaded keymap overrides from", KEYMAP_FILE)
    except FileNotFoundError:
        pass
    except Exception as e:
        log("keymap parse warning:", e)
    return m


def normalize(name):
    name = name.strip()
    if name in LIBCEC_ALIAS:
        name = LIBCEC_ALIAS[name]
    return name.lower().replace(" ", "-").replace("_", "-")


# --- uinput virtual keyboard (legacy uinput_user_dev + write interface);
# aarch64 uses asm-generic ioctl encoding ---
UINPUT_IOCTL_BASE = ord("U")


def _iow(nr, size):
    return (1 << 30) | (size << 16) | (UINPUT_IOCTL_BASE << 8) | nr


def _io(nr):
    return (UINPUT_IOCTL_BASE << 8) | nr


UI_SET_EVBIT = _iow(100, 4)
UI_SET_KEYBIT = _iow(101, 4)
UI_DEV_CREATE = _io(1)
UI_DEV_DESTROY = _io(2)

EV_SYN = 0x00
EV_KEY = 0x01
SYN_REPORT = 0x00


class UInput:
    def __init__(self, codes):
        self.fd = os.open(UINPUT_DEV, os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_SYN)
        for c in sorted(set(codes)):
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, c)
        # struct uinput_user_dev: name[80], input_id{bustype,vendor,product,version}
        # (4x u16), ff_effects_max u32, then abs arrays 4x s32[64]
        name = b"H96-CEC-Remote"
        dev = struct.pack(
            "80sHHHHI" + "i" * (64 * 4),
            name.ljust(80, b"\0"),
            0x03,  # BUS_USB
            0x1D6B,  # vendor (Linux Foundation)
            0x0CEC,  # product
            1,  # version
            0,  # ff_effects_max
            *([0] * (64 * 4)),
        )
        os.write(self.fd, dev)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)
        time.sleep(0.2)
        log("uinput device created: H96-CEC-Remote")

    def _emit(self, etype, code, value):
        # struct input_event on 64-bit: time (2x long), type u16, code u16, value
        # s32; timestamp left at 0, kernel fills it in
        ev = struct.pack("llHHi", 0, 0, etype, code, value)
        os.write(self.fd, ev)

    def tap(self, code):
        self._emit(EV_KEY, code, 1)
        self._emit(EV_SYN, SYN_REPORT, 0)
        self._emit(EV_KEY, code, 0)
        self._emit(EV_SYN, SYN_REPORT, 0)

    def close(self):
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except Exception:
            pass
        try:
            os.close(self.fd)
        except Exception:
            pass


# --- backends ---
def wait_for_device(timeout=30):
    """CEC device can appear a little after boot (HDMI hotplug). Wait briefly."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(CEC_DEV):
            return True
        time.sleep(2)
    return os.path.exists(CEC_DEV)


def run_libcec(ui, keymap):
    # cec-client acts as a Playback device, becomes active source, and prints
    # "key pressed: <name> (<code>) ..." lines to parse
    cec_num = re.sub(r"\D", "", os.path.basename(CEC_DEV)) or "0"
    cmd = ["cec-client", "-t", "p", "-o", OSD_NAME, "-d", "8", CEC_DEV]
    log("starting backend: cec-client (libcec) on", CEC_DEV)
    proc = subprocess.Popen(
        cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, bufsize=1, universal_newlines=True,
    )
    try:
        # become active source so the TV routes remote keys here
        proc.stdin.write("as\n")
        proc.stdin.flush()
    except Exception:
        pass
    LIBCEC["proc"] = proc

    keyre = re.compile(r"key pressed:\s*(.+?)\s*\((0x[0-9a-fA-F]+|\d+)\)")
    for line in proc.stdout:
        m = keyre.search(line)
        if not m:
            continue
        name = normalize(m.group(1))
        dispatch(ui, keymap, name)
    LIBCEC["proc"] = None
    rc = proc.wait()
    log("cec-client exited rc", rc)
    return rc


def run_cecctl(ui, keymap):
    # kernel-native fallback: claim a Playback logical address so the TV
    # addresses remote keys here, then monitor traffic
    log("starting backend: cec-ctl (v4l-utils) on", CEC_DEV)
    try:
        subprocess.run(
            ["cec-ctl", "-d", CEC_DEV, "--playback", "-o", OSD_NAME],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        log("cec-ctl config warning:", e)

    proc = subprocess.Popen(
        ["cec-ctl", "-d", CEC_DEV, "-M"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        bufsize=1, universal_newlines=True,
    )
    # lines look like "\tui-cmd: select (0x00)" inside USER_CONTROL_PRESSED
    uire = re.compile(r"ui-cmd:\s*([a-z0-9\-]+)", re.IGNORECASE)
    pressed = False
    for line in proc.stdout:
        low = line.strip()
        if "USER_CONTROL_PRESSED" in line:
            pressed = True
            continue
        if "USER_CONTROL_RELEASED" in line:
            pressed = False
            continue
        m = uire.search(line)
        if m and pressed:
            dispatch(ui, keymap, normalize(m.group(1)))
            pressed = False  # one tap per press
    rc = proc.wait()
    log("cec-ctl exited rc", rc)
    return rc


def dispatch(ui, keymap, name):
    keyname = keymap.get(name)
    if not keyname:
        log("unmapped CEC key:", name)
        return
    code = KEY.get(keyname)
    if code is None:
        log("unknown KEY symbol in map:", keyname)
        return
    ui.tap(code)
    log("cec", name, "->", keyname)


# --- display wake/blank requests ---
def libcec_send(lines):
    """Commands through the running cec-client; False when that backend is not up."""
    proc = LIBCEC["proc"]
    if proc is None or proc.poll() is not None:
        return False
    with LIBCEC_LOCK:
        try:
            for ln in lines:
                proc.stdin.write(ln + "\n")
                proc.stdin.flush()
                time.sleep(1)
            return True
        except Exception:
            return False


def cecctl(*args):
    try:
        r = subprocess.run(["cec-ctl", "-d", CEC_DEV] + list(args), timeout=10,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           universal_newlines=True)
        return r.returncode == 0, r.stdout
    except Exception as e:
        return False, str(e)


def phys_addr():
    ok, out = cecctl()
    m = re.search(r"Physical Address\s*:\s*([0-9a-fA-F.]+)", out)
    return m.group(1) if ok and m else None


def cec_wake():
    if libcec_send(["on 0", "as"]):
        return True
    # adapter has no address while HPD is low (display just re-enabled): retry briefly
    for _ in range(5):
        pa = phys_addr()
        if pa and pa.lower() != "f.f.f.f":
            ok, _ = cecctl("--to", "0", "--image-view-on")
            cecctl("--active-source", "phys-addr=" + pa)
            if ok:
                return True
        time.sleep(2)
    return False


def cec_standby():
    if libcec_send(["standby 0"]):
        return True
    ok, _ = cecctl("--to", "0", "--standby")
    return ok


def seat_uid():
    try:
        with open(SEAT_FILE) as f:
            for line in f:
                if line.startswith("ACTIVE_UID="):
                    return int(line.split("=", 1)[1])
    except (OSError, ValueError):
        pass
    return None


def handle_request(req, last):
    now = time.monotonic()
    if req == "wake":
        if os.path.exists(WAKE_OFF_FLAG):
            return "off"
        if now - last.get(req, -1e9) < DEBOUNCE_S:
            return "debounced"
        last[req] = now
        return "sent" if cec_wake() else "failed"
    if req == "blank":
        if not os.path.exists(BLANK_FLAG):
            return "off"
        if now - last.get(req, -1e9) < DEBOUNCE_S:
            return "debounced"
        last[req] = now
        return "sent" if cec_standby() else "failed"
    return "bad"


def wake_server():
    """Stream socket; peer must be root or the active seat0 user (SO_PEERCRED)."""
    try:
        os.unlink(WAKE_SOCK)
    except FileNotFoundError:
        pass
    except OSError as e:
        log("wake socket:", e)
        return
    try:
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(WAKE_SOCK)
        os.chmod(WAKE_SOCK, 0o666)
        srv.listen(4)
    except OSError as e:
        log("wake socket unavailable:", e)
        return
    log("wake socket:", WAKE_SOCK)
    last = {}
    while True:
        conn, _ = srv.accept()
        with conn:
            try:
                conn.settimeout(2)
                cred = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                       struct.calcsize("3i"))
                _, uid, _ = struct.unpack("3i", cred)
                req = conn.recv(16).decode("ascii", "replace").strip()
                if uid != 0 and uid != seat_uid():
                    res = "denied"
                else:
                    res = handle_request(req, last)
                log("display", req[:8], "uid", uid, "->", res)
                conn.sendall(res.encode() + b"\n")
            except OSError:
                pass


def main():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    have_libcec = shutil.which("cec-client") is not None
    have_cecctl = shutil.which("cec-ctl") is not None
    if not (have_libcec or have_cecctl):
        log("no CEC userspace backend found (install cec-utils or v4l-utils).")
        log("nothing to do; exiting cleanly.")
        return 0

    if not wait_for_device():
        log(CEC_DEV, "not present.")
        log("This kernel/DT may not expose HDMI-CEC. exiting cleanly.")
        log("Box-test: `cec-ctl -D` and `dmesg | grep -i cec`.")
        return 0

    keymap = load_keymap()
    try:
        ui = UInput(KEY.values())
    except FileNotFoundError:
        log(UINPUT_DEV, "missing (uinput module not loaded). exiting cleanly.")
        return 0
    except PermissionError:
        log("cannot open", UINPUT_DEV, "(need root/udev perms). exiting.")
        return 0

    threading.Thread(target=wake_server, daemon=True).start()
    try:
        while True:
            if have_libcec:
                run_libcec(ui, keymap)
            elif have_cecctl:
                run_cecctl(ui, keymap)
            # backend died (HDMI unplug, adapter reset); retry after a pause,
            # bail if the device vanished for good
            if not os.path.exists(CEC_DEV):
                log(CEC_DEV, "gone; exiting.")
                break
            log("backend stopped; restarting in 5s")
            time.sleep(5)
    finally:
        ui.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
