#!/usr/bin/env python3
# h96-cecd -- HDMI-CEC to uinput daemon for H96 Max V58 (RK3588)
#
# Listens for CEC "User Control Pressed" events from the TV remote and injects
# them as Linux input key events through /dev/uinput, so the TV remote drives
# KDE Plasma, mpv, and Kodi.
#
# Device-agnostic: talks to the kernel CEC API via /dev/cec0.
# Backend priority:
#   1. cec-client  (libcec, package: cec-utils)   -- preferred, turnkey key decode
#   2. cec-ctl     (v4l-utils, package: v4l-utils) -- fallback, kernel-native
#
# Fails gracefully when no CEC device / no backend is present: it prints a
# clear message and exits 0 (so systemd does not crash-loop).
#
# No third-party Python deps. uinput driven directly via ctypes/struct.

import fcntl
import os
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import time

CEC_DEV = os.environ.get("H96_CEC_DEV", "/dev/cec0")
UINPUT_DEV = "/dev/uinput"
OSD_NAME = os.environ.get("H96_CEC_OSD", "H96")
KEYMAP_FILE = "/etc/h96/cec-keymap.conf"


def log(*a):
    print("h96-cecd:", *a, file=sys.stderr, flush=True)


