#!/bin/bash
# h96-encode — hardware video encoding on the RK3588 VPU.
#
# WHY THIS EXISTS: this image has shipped hardware DECODE since v3 (the rkmpp
# mpv stack). Hardware ENCODE was present the whole time and never exposed --
# the kernel has RKVENC/RKVENC2/JPGENC enabled, both rkvenc cores are `okay` in
# the DTS, /dev/mpp_service is present, and the bundled ffmpeg already carries
# h264_rkmpp, hevc_rkmpp and mjpeg_rkmpp. Nothing documented it.
#
# It matters more than it looks: this ffmpeg build has NO libx264, so the
# hardware encoder is the ONLY encode path on the box. Measured on an H96 Max
# V58: 1080p encoded faster than 180 fps for both h264 and hevc.
#
# Deployed to /usr/local/bin/h96-encode.

set -uo pipefail

[ -r /usr/local/lib/h96/banner.sh ] && . /usr/local/lib/h96/banner.sh
command -v h96_banner >/dev/null 2>&1 || h96_banner() { :; }

CODEC=h264
BITRATE=8M
SCALE=""
IN=""
OUT=""
QUIET=0

die() { echo "h96-encode: $*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
h96-encode — hardware video encode on the RK3588 VPU

  h96-encode INPUT OUTPUT [options]

  -c, --codec   h264 | hevc | mjpeg     (default: h264)
  -b, --bitrate RATE                    (default: 8M)
  -s, --scale   WxH                     hardware-scale before encoding
  -q, --quiet                           no banner, no progress
  -l, --list                            show the available hardware encoders
  -h, --help

Examples
  h96-encode clip.mkv out.mp4
  h96-encode clip.mkv out.mp4 -c hevc -b 6M
  h96-encode clip.mkv small.mp4 -s 1280x720

This is the only encode path on the box: the bundled ffmpeg has no libx264.
USAGE
}

list_encoders() {
    echo "  hardware encoders available:"
    ffmpeg -hide_banner -encoders 2>/dev/null | awk '/rkmpp/{printf "    %s  %s\n", $2, substr($0, index($0,$3))}' \
        || echo "    none found"
}

while [ $# -gt 0 ]; do
    case "$1" in
        -c|--codec)   CODEC="${2:-}"; shift 2 ;;
        -b|--bitrate) BITRATE="${2:-}"; shift 2 ;;
        -s|--scale)   SCALE="${2:-}"; shift 2 ;;
        -q|--quiet)   QUIET=1; shift ;;
        -l|--list)    list_encoders; exit 0 ;;
        -h|--help)    usage; exit 0 ;;
        -*)           die "unknown option '$1' (try --help)" ;;
        *)
            if   [ -z "$IN"  ]; then IN="$1"
            elif [ -z "$OUT" ]; then OUT="$1"
            else die "unexpected extra argument '$1'"
            fi
            shift ;;
    esac
done

command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg is not installed"
[ -e /dev/mpp_service ] || die "/dev/mpp_service is missing — the VPU is not available on this kernel"

[ -n "$IN" ] && [ -n "$OUT" ] || { usage; exit 2; }
[ -r "$IN" ] || die "cannot read input '$IN'"

case "$CODEC" in
    h264)  ENC=h264_rkmpp ;;
    hevc|h265) ENC=hevc_rkmpp ;;
    mjpeg) ENC=mjpeg_rkmpp ;;
    *) die "unknown codec '$CODEC' (use h264, hevc or mjpeg)" ;;
esac

# match the encoder name as an exact field, the same way --list reads it
ffmpeg -hide_banner -encoders 2>/dev/null | awk -v e="$ENC" '$2 == e { found = 1 } END { exit !found }' \
    || die "$ENC is not in this ffmpeg build (try: h96-encode --list)"

if [ -e "$OUT" ]; then
    printf "h96-encode: '%s' exists. Overwrite? [y/N] " "$OUT"
    read -r r; case "$r" in y|Y|yes) : ;; *) echo "aborted"; exit 1 ;; esac
fi

[ "$QUIET" -eq 1 ] || h96_banner "H W   E N C O D E"

args=(-hide_banner -y -i "$IN")
[ -n "$SCALE" ] && args+=(-vf "scale=${SCALE/x/:}")
args+=(-c:v "$ENC" -b:v "$BITRATE")
# copy audio when there is any; ffmpeg is a no-op on files without an audio stream
args+=(-c:a copy)

[ "$QUIET" -eq 1 ] && args=(-loglevel error "${args[@]}") || args=(-stats -loglevel warning "${args[@]}")

t0=$SECONDS
if ! ffmpeg "${args[@]}" "$OUT"; then
    # audio copy is the usual failure (incompatible container); retry re-encoding it
    echo "h96-encode: retrying with audio re-encoded..." >&2
    a2=("${args[@]}")
    for i in "${!a2[@]}"; do [ "${a2[$i]}" = copy ] && a2[$i]=aac; done
    ffmpeg "${a2[@]}" "$OUT" || die "encode failed"
fi
el=$(( SECONDS - t0 ))

if [ "$QUIET" -ne 1 ]; then
    sz=$(stat -c%s "$OUT" 2>/dev/null || echo 0)
    printf '\n  wrote %s  (%s MiB in %ss)\n' "$OUT" "$(awk "BEGIN{printf \"%.1f\", $sz/1048576}")" "$el"
fi
