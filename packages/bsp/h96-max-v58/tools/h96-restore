def is_retired(arcname):
    low = arcname.lower()
    return any(m in low for m in RETIRED_MARKERS)

def parse_categories(spec, flag):
    out = []
    for c in spec.split(","):
        c = c.strip()
        if not c or c == "none": continue
        if c not in CATEGORIES:
            die(f"{flag}: unknown category '{c}' (choose from {', '.join(CATEGORIES)})")
        out.append(c)
    return out

