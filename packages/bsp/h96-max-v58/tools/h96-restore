def member_category(arcname):
    """(category, emulator-name-or-None) for an archive member."""
    if arcname == "manifest.json":              return None, None
    if is_retired(arcname):                     return None, None  # e.g. edid-adapt: never restored
    if arcname.startswith("userhome/.config/"):  return "configs", None
    if arcname.startswith("userhome/.local/share/kscreen") or \
       arcname.startswith("userhome/.local/state/wireplumber"): return "configs", None
    if arcname.startswith("userhome/.var/app/"):
        app = arcname.split("/", 3)[3].split("/", 1)[0] if arcname.count("/") >= 3 else ""
        return "emulators", EMU_APP_IDS.get(app, app)
    if arcname.startswith("userhome/" + CEMU_SUBDIR): return "emulators", "cemu"
    if arcname.startswith("userhome/" + GAMING_PREFIX_SUB): return "gaming", None
    if arcname.startswith("steamhome/"):         return "gaming", None
    if arcname.startswith("wifi/"):              return "wifi", None
    if arcname.startswith("system/lightdm/"):    return "autologin", None
    if arcname == "system/etc-h96/vm.conf":      return "vm", None
    if arcname.startswith("system/etc-h96/"):    return "system", None
    if arcname.startswith("vm/"):                return "vm", None
    if arcname.startswith("waydroid-data/"):     return "waydroid", None
    if arcname.startswith("waydroid-stash/"):    return "waydroid-images", None
    return None, None

def plan_json(archive):
    """Stream the archive once and describe it: manifest fields plus per-category
    presence, file counts and bytes. No root needed."""
    tf, proc = open_read(archive)
    manifest = None
    cats = {c: {"present": False, "files": 0, "bytes": 0, "detail": ""} for c in CATEGORIES}
    emu_files = {}
    for member in tf:
        if member.name == "manifest.json":
            manifest = json.loads(tf.extractfile(member).read().decode()); continue
        cat, emu = member_category(member.name)
        if not cat: continue
        c = cats[cat]; c["present"] = True
        if member.isreg(): c["files"] += 1; c["bytes"] += member.size
        if emu: emu_files[emu] = emu_files.get(emu, 0) + (member.size if member.isreg() else 0)
    tf.close()
    if proc: proc.stdout.close(); proc.wait()
    if manifest is None:
        die("not an h96-backup archive (no manifest.json)")
    f = manifest.get("features", {}); w = f.get("waydroid", {})
    if manifest.get("desktop", "none") != "none":
        cats["desktop"].update(present=True, detail=f"{manifest['desktop']} ({manifest.get('desktop_package')})")
    if f.get("emulators"):
        cats["emulators"].update(present=True, detail=", ".join(f["emulators"]))
    if w.get("profile") or cats["waydroid"]["present"]:
        cats["waydroid"].update(present=True, detail=f"profile {w.get('profile') or 'none'}, /data {'yes' if w.get('data') else 'no'}")
    if cats["waydroid-images"]["present"]:
        cats["waydroid-images"]["detail"] = ", ".join(w.get("stashes", []))
    if f.get("widevine"):   cats["widevine"].update(present=True, detail="L3 CDM (re-downloaded)")
    steam = f.get("steam_arm", {})
    if f.get("gaming"):
        cats["gaming"].update(present=True, detail="wine prefixes + stack fetch"
                              + (f" + Steam ARM ({steam.get('user')}"
                                 + (", Proton prefixes bundled" if steam.get("proton_prefixes_included") else "")
                                 + (", client runtime bundled" if steam.get("runtime_included") else "")
                                 + ")" if steam.get("home_included") else ""))
    if f.get("npu_runtime"): cats["npu"].update(present=True, detail="RKNN runtime")
    if cats["wifi"]["present"]:      cats["wifi"]["detail"] = f"{cats['wifi']['files']} conf(s)"
    if cats["autologin"]["present"]:
        cats["autologin"]["detail"] = "autologin-user setting (one h96 drop-in, not the raw lightdm files)"
    if cats["configs"]["present"]:   cats["configs"]["detail"] = "~/.config subset, display+audio state"
    display = f.get("display", {}); services = f.get("services", {}); wol = f.get("wol")
    on_svcs = [s for s, v in services.items() if v]
    if cats["system"]["present"] or display or services or wol:
        cats["system"].update(present=True,
            detail=f"hdmi20_off={display.get('hdmi20_off', False)} frl_off={display.get('frl_off', False)} "
                   f"color={display.get('color') or 'rgb'} range={display.get('range') or 'full'} "
                   f"per_display={len(display.get('per_display', {}))} "
                   f"wol={wol} services_on={','.join(on_svcs) or 'none'}")
    vm = f.get("vm", {})
    if cats["vm"]["present"] or vm.get("names"):
        cats["vm"].update(present=True,
            detail=f"{len(vm.get('names', []))} VM(s): {', '.join(vm.get('names', [])) or '(none)'}"
                   + ("; disks bundled" if vm.get("disks_included") else "; disks not bundled"))
    cats["emulators"]["items"] = emu_files
    retired_note = ("h96-edid-adapt from this archive will NOT be restored (retired on v6.2)"
                    if manifest.get("source_version", "unknown").startswith(("v5", "v6.0", "v6.1"))
                    else None)
    return {"archive": archive, "created": manifest.get("created"), "schema": manifest.get("schema"),
            "source_version": manifest.get("source_version", "unknown"),
            "tool_version": manifest.get("tool_version", "unknown"),
            "desktop": manifest.get("desktop"), "desktop_package": manifest.get("desktop_package"),
            "emulators": f.get("emulators", []), "waydroid": w,
            "widevine": f.get("widevine"), "gaming": f.get("gaming"), "npu_runtime": f.get("npu_runtime"),
            "wifi": f.get("wifi"), "backup_categories": manifest.get("categories"),
            "display": display, "services": services, "wol": wol, "vm": vm,
            "retired_note": retired_note,
            "categories": cats}

def apply_selection(manifest, sel, emu_filter):
    """Trim the manifest so the installer steps only see selected features."""
    f = manifest["features"]
    if "desktop" not in sel:
        manifest["desktop"], manifest["desktop_package"] = "none", None
    if "emulators" not in sel:
        f["emulators"] = []
    elif emu_filter is not None:
        f["emulators"] = [e for e in f.get("emulators", []) if e in emu_filter]
    if "waydroid" not in sel:
        f.setdefault("waydroid", {})["profile"] = None
        f["waydroid"]["data"] = False
    if "waydroid-images" not in sel:
        f.setdefault("waydroid", {})["images_included"] = False
    if "widevine" not in sel: f["widevine"] = False
    if "gaming" not in sel:
        f["gaming"] = False
        f.setdefault("steam_arm", {})["home_included"] = False
        f["steam_arm"]["proton_prefixes_included"] = False
        f["steam_arm"]["runtime_included"] = False
    if "npu" not in sel:      f["npu_runtime"] = False
    if "wifi" not in sel:     f["wifi"] = 0
    if "system" not in sel:
        f["display"], f["services"], f["wol"] = {}, {}, None
    if "vm" not in sel:
        f.setdefault("vm", {})["names"], f["vm"]["disks_included"] = [], False

