        def go_to(d):
            d = os.path.abspath(os.path.expanduser(d or "/"))
            if not os.path.isdir(d):
                hint.config(text=f"not a folder: {d}"); return
            cur.set(d)
            tree.delete(*tree.get_children()); rows.clear()
            try:
                names = sorted(os.listdir(d))
            except OSError as e:
                hint.config(text=f"cannot read {d}: {e.strerror}"); return
            dirs, files = [], []
            for n in names:
                if n.startswith("."): continue
                p = os.path.join(d, n)
                if os.path.isdir(p):
                    dirs.append((n, p))
                elif want == "file" and any(fnmatch.fnmatch(n, g) for g in ARCHIVE_GLOBS):
                    files.append((n, p))
            for n, p in dirs:
                iid = tree.insert("", "end", values=(n + "/", "", when(_mtime(p))))
                rows[iid] = ("dir", p)
            for n, p in files:
                iid = tree.insert("", "end", values=(n, human(_size(p)), when(_mtime(p))))
                rows[iid] = ("file", p)
            hint.config(text=(f"{len(dirs)} folder(s), {len(files)} archive(s)" if want == "file"
                              else f"{len(dirs)} folder(s)"))

        def _size(p):
            try: return os.path.getsize(p)
            except OSError: return 0

        def _mtime(p):
            try: return os.path.getmtime(p)
            except OSError: return 0

