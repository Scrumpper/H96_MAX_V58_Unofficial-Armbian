    def texture(parent, font, n_rows=1, art=None, seed0=1, colour=CYAN, clear=False):
        """A read-only Text carrying scrumptop's speckle texture across the full
        window width, redrawn whenever that width changes. `art` rows are set
        into it centred in `colour`, the way scrumptop sets its banner into the
        same texture. `clear` keeps a blank box one cell wider than the text on
        each side, so letter-spaced captions stay legible."""
        from tkinter import font as tkfont
        cw = max(1, tkfont.Font(root=root, font=font).measure("\u2588"))
        art_rows = [r.rstrip() for r in (art or [])]
        art_w = max((len(r) for r in art_rows), default=0)
        rows = art_rows if art_rows else [""] * n_rows
        tx = tk.Text(parent, height=len(rows), width=1, font=font, bg=BG, bd=0,
                     highlightthickness=0, wrap="none", cursor="arrow", takefocus=0,
                     padx=0, pady=0, spacing1=0, spacing3=0)
        for col in (P_EDGE, P_MID, P_DIM, P_HI):
            tx.tag_configure(col, foreground=col)
        tx.tag_configure("art", foreground=colour)
        drawn = {"cols": 0}

        def draw(cols):
            tx.configure(state="normal")
            tx.delete("1.0", "end")
            for ri, r in enumerate(rows):
                # block art shares one left edge; captions centre row by row
                pad = max(0, (cols - (len(r) if clear else art_w)) // 2)
                lo, hi = pad - 2, pad + len(r) + 2
                for x in range(cols):
                    ax = x - pad
                    ch = r[ax] if 0 <= ax < len(r) else " "
                    if ch != " ":
                        tx.insert("end", ch, "art")
                    elif clear and r and lo <= x < hi:
                        tx.insert("end", " ")
                    else:
                        g, c = _noise_cell(x, cols, seed0 + ri)
                        tx.insert("end", g, c)
                if ri < len(rows) - 1:
                    tx.insert("end", "\n")
            tx.configure(state="disabled")

        def on_resize(e):
            cols = max(art_w + 4, e.width // cw)
            if cols != drawn["cols"]:
                drawn["cols"] = cols
                draw(cols)

        draw(max(art_w + 4, (WIN_W - 24) // cw))
        tx.bind("<Configure>", on_resize)
        tx.bind("<Button-1>", lambda e: "break")
        return tx

