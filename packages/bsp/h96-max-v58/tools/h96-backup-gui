def ensure_tk():
    try:
        import tkinter  # noqa: F401
        return True
    except ImportError:
        pass
    term = find_terminal()
    if term is None or not os.environ.get("DISPLAY"):
        print("python3-tk is missing: sudo apt-get install -y python3-tk", file=sys.stderr)
