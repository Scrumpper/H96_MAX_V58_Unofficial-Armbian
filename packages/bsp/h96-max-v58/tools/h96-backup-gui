# --------------------------------------------------------------- helpers -----
def have(cmd): return shutil.which(cmd) is not None

def human(n):
    x = float(n or 0)
    for u in ("B", "KB", "MB", "GB", "TB"):
        if x < 1024 or u == "TB":
            return f"{x:.0f} {u}" if u == "B" else f"{x:.1f} {u}"
        x /= 1024.0

def when(ts):
    try:
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts))
    except (OSError, ValueError):
        return "?"

def find_terminal():
    for t in ("konsole", "x-terminal-emulator", "gnome-terminal", "xfce4-terminal", "xterm"):
        if have(t): return t
    return None

def terminal_argv(term, title, script):
    """argv that opens `term` running bash -c script, waits for Enter, then closes.
    The script runs in a subshell so an `exit` inside it still reaches the prompt,
    and no terminal is told to hold: Enter ends bash and the window goes with it."""
    wrapped = "(\n" + script + "\n)\necho\nread -rp 'Press Enter to close this window'"
    inner = ["bash", "-c", wrapped]
    if term == "konsole":
        return ["konsole", "-p", f"tabtitle={title}", "-e"] + inner
    if term == "gnome-terminal":
        return ["gnome-terminal", "--title", title, "--"] + inner
    if term == "xfce4-terminal":
        return ["xfce4-terminal", "--title", title, "-x"] + inner
    return [term, "-T", title, "-e"] + inner if term == "xterm" else [term, "-e"] + inner

def run_in_terminal(title, script):
    term = find_terminal()
    if not term:
        raise RuntimeError("no terminal emulator found (konsole, gnome-terminal, xterm)")
    subprocess.Popen(terminal_argv(term, title, script), start_new_session=True)

def removable_mounts():
    """Mounted removable media, most likely USB sticks first."""
    out = []
    for pat in ("/media/*/*", "/run/media/*/*", "/mnt/*", "/media/*"):
        for p in sorted(glob.glob(pat)):
            if os.path.ismount(p) and os.access(p, os.R_OK) and p not in out:
                out.append(p)
    return out

def home_dirs():
    homes = [pwd.getpwnam(u).pw_dir for u in {os.environ.get("USER", ""), os.environ.get("SUDO_USER", "")}
             if u and _has_pw(u)]
    homes += [p.pw_dir for p in pwd.getpwall() if 1000 <= p.pw_uid < 65000 and os.path.isdir(p.pw_dir)]
    return sorted(set(homes))

def _has_pw(u):
    try:
        pwd.getpwnam(u); return True
    except KeyError:
        return False

def archives_in(directory, depth=1):
    """Archives directly in `directory`, and one level below it."""
    found = set()
    pats = list(ARCHIVE_GLOBS) + ([os.path.join("*", g) for g in ARCHIVE_GLOBS] if depth else [])
    for pat in pats:
        for f in glob.glob(os.path.join(directory, pat)):
            if os.path.isfile(f): found.add(f)
    return sorted(found, key=lambda f: os.path.getmtime(f), reverse=True)

def find_archives():
    """Archives on mounted media and in home directories, newest first."""
    found = set()
    for d in removable_mounts() + home_dirs() + ["/root"]:
        found.update(archives_in(d))
    return sorted(found, key=lambda f: os.path.getmtime(f), reverse=True)

def sh(argv): return " ".join(shlex.quote(a) for a in argv)

def resolve_archive(text):
    """Make sense of whatever was typed or picked in the Archive field.

    Returns (archive_or_None, candidates, note). A file is taken as it stands; a
    folder is searched for archives, so a stick can be typed in as a path."""
    t = os.path.expanduser((text or "").strip())
    if not t:
        return None, [], ""
    if os.path.isfile(t):
        return t, [], f"{human(os.path.getsize(t))}, written {when(os.path.getmtime(t))}"
    if os.path.isdir(t):
        found = archives_in(t)
        if not found:
            return None, [], f"no archive in {t}"
        if len(found) == 1:
            return found[0], found, f"one archive in that folder: {os.path.basename(found[0])}"
        return found[0], found, f"{len(found)} archives in that folder, newest picked"
    return None, [], f"no such file or folder: {t}"

# ------------------------------------------------------- command builders ----
def backup_argv(dest, selected, emulators=None, vm_disks=False, proton_prefixes=False, steam_runtime=False):
    """h96-backup command for the selected categories. selected: list of keys."""
    argv = ["sudo", BACKUP_TOOL]
    if dest: argv.append(dest)
    sel = [c for c in CAT_KEYS if c in selected]
    if sel != CAT_KEYS and sel != [c for c in CAT_KEYS if c != "waydroid-images"]:
        argv += ["--only", ",".join(sel)]
    elif "waydroid-images" in sel:
        argv.append("--with-images")
    if emulators is not None and "emulators" in sel:
        argv += ["--emulators", ",".join(emulators)]
    if vm_disks and "vm" in sel: argv.append("--with-vm-disks")
    if proton_prefixes and "gaming" in sel: argv.append("--with-proton-prefixes")
    if steam_runtime and "gaming" in sel: argv.append("--with-steam-runtime")
    return argv

def restore_argv(archive, selected, emulators=None, force=False, open_mode=False, dry=False):
    argv = [RESTORE_TOOL, archive] if dry else ["sudo", RESTORE_TOOL, archive]
    sel = [c for c in CAT_KEYS if c in selected]
    if sel != CAT_KEYS:
        argv += ["--only", ",".join(sel)] if sel else ["--only", "none"]
    if emulators is not None and "emulators" in sel:
        argv += ["--emulators", ",".join(emulators)]
    if force: argv.append("--force")
    if open_mode: argv.append("--open")
    if dry: argv.append("--dry-run")
    return argv

def force_session_script(argv):
    """Restore with --force outside the desktop session: a transient systemd
    unit stops the display manager, runs the restore, starts it again. The
    terminal that launches it dies with the session, so output goes to a log."""
    inner = sh([a for a in argv if a != "sudo"])
    unit_cmd = (f"systemctl stop lightdm 2>/dev/null; systemctl stop sddm 2>/dev/null; sleep 2; "
                f"{inner}; rc=$?; echo \"h96-restore exit $rc\"; "
                f"systemctl start lightdm 2>/dev/null || systemctl start sddm 2>/dev/null")
    return ("echo 'The desktop session will stop in a few seconds and come back when the restore is done.'\n"
            f"echo 'Output: {FORCE_LOG}'\n"
            f"sudo systemd-run --unit=h96-restore-force --collect "
            f"-p StandardOutput=append:{FORCE_LOG} -p StandardError=append:{FORCE_LOG} "
            f"bash -c {shlex.quote(unit_cmd)}")

def graphical_session_active():
    try:
        r = subprocess.run(["systemctl", "is-active", "lightdm", "sddm", "gdm"], capture_output=True, text=True)
        return "active" in r.stdout.split()
    except Exception:
        return bool(os.environ.get("DISPLAY"))

