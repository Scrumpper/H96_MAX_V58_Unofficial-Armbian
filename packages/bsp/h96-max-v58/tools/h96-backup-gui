        tk.Label(bar, text="changes nothing", bg=PANEL, fg=DIM,
                 font=MONO_S).pack(side="right", padx=12)
        foot_ = ttk.Frame(win, padding=(12, 6)); foot_.pack(side="bottom", fill="x")
        ttk.Label(foot_, text="'q' or Esc to close", style="Muted.TLabel").pack(side="left")
        ttk.Button(foot_, text="[ Close ]", command=win.destroy).pack(side="right")
        body = ttk.Frame(win, padding=(12, 8, 12, 0)); body.pack(fill="both", expand=True)
        text = tk.Text(body, font=MONO_S, bg=FIELD, fg=FG, insertbackground=FG,
                       relief="flat", highlightthickness=0, wrap="none")
        sb_y = ttk.Scrollbar(body, orient="vertical", command=text.yview)
        sb_x = ttk.Scrollbar(body, orient="horizontal", command=text.xview)
        text.configure(yscrollcommand=sb_y.set, xscrollcommand=sb_x.set, state="disabled")
        sb_y.pack(side="right", fill="y"); sb_x.pack(side="bottom", fill="x")
        text.pack(side="left", fill="both", expand=True)
        for k in ("<Key-q>", "<Key-Q>", "<Escape>"):
            win.bind(k, lambda e: win.destroy())
        root.update_idletasks()
        w = min(max(760, root.winfo_width() - 80), SCR_W - 40)
        h = min(max(420, root.winfo_height() - 160), SCR_H - 100)
        x = root.winfo_rootx() + (root.winfo_width() - w) // 2
        y = root.winfo_rooty() + (root.winfo_height() - h) // 3
        win.geometry(f"{w}x{h}+{max(x, 0)}+{max(y, 0)}")
        win.deiconify()
        win.focus_set()
        pv["win"], pv["text"] = win, text
        return text

    def set_preview(text):
        tx = preview_window()
        tx.configure(state="normal")
        tx.delete("1.0", "end")
        tx.insert("end", text)
        tx.configure(state="disabled")

    def r_selected(): return [k for k in CAT_KEYS if r_vars[k].get()]

    def r_emus():
        all_emus = r_plan.get("emulators", [])
        chosen = [e for e in all_emus if r_emu_vars.get(e) and r_emu_vars[e].get()]
        return None if chosen == all_emus else chosen

    def r_update(*_):
        a = current_archive[0]
        if a:
            r_cmd.set("Command: " + sh(restore_argv(a, r_selected(), r_emus(), force_var.get(), open_var.get())))
        else:
            r_cmd.set("")
        if "configs" in r_selected() and not force_var.get():
            advice.config(text="Tick Replace settings that are newer on disk to restore your archived "
                               "desktop settings.", style="Yellow.TLabel")
        elif force_var.get() and "configs" in r_selected():
            advice.config(text="Your archived desktop settings will replace the current ones. The desktop "
                               "session closes while they are written and starts again afterwards, so save "
                               f"open work first. Output goes to {FORCE_LOG}.", style="Dim.TLabel")
        else:
            advice.config(text="", style="Dim.TLabel")

    # Resolving what was typed touches the disk, so it is debounced rather than
    # run on every keystroke.
    current_archive = [None]
    pending = {"job": None}

    def arch_changed(*_):
        if pending["job"]:
            root.after_cancel(pending["job"])
        pending["job"] = root.after(350, resolve_typed)

    def resolve_typed():
        pending["job"] = None
        text = arch_var.get().strip()
        archive, candidates, msg = resolve_archive(text)
        if candidates and len(candidates) > 1:
            arch_box["values"] = candidates
        arch_note.config(text=msg, style="Green.TLabel" if archive else
                         ("Dim.TLabel" if not text else "Red.TLabel"))
        if archive and archive != current_archive[0]:
            current_archive[0] = archive
            load_plan()
        elif not archive:
            current_archive[0] = None
            clear_plan()
            r_update()

    def clear_plan():
        r_plan.clear()
        for key, (cb, info) in r_rows.items():
            info.config(text="load an archive first", style="Muted.TLabel")
            cb.state(["disabled"]); r_vars[key].set(False)
        summary.set("")

    def load_plan():
        a = current_archive[0]
        if not a: return
        try:
            big = f" ({human(os.path.getsize(a))}, this takes a moment)"
        except OSError:
            big = ""
        say(f"Reading {os.path.basename(a)}{big} ...")
        in_background(lambda: read_json([RESTORE_TOOL, a, "--plan-json"], "archive read"), "plan")

    def plan_done(ok_, payload):
        if not ok_:
            say("Could not read that archive.")
            clear_plan()
            note("Restore", str(payload), kind="error")
            return
        p = payload or {}
        r_plan.clear(); r_plan.update(p)
        cats = p.get("categories", {})
        held = 0
        for key, (cb, info) in r_rows.items():
            c = cats.get(key, {})
            present = c.get("present", False)
            txt = c.get("detail") or ""
            if c.get("files"): txt += f"  {c['files']} file(s), {human(c.get('bytes', 0))}"
            info.config(text=txt if present else "not in this archive",
                        style="TLabel" if present else "Muted.TLabel")
            cb.state(["!disabled"] if present else ["disabled"])
            r_vars[key].set(bool(present))
            held += 1 if present else 0
        names = p.get("emulators", [])
        for name in names:
            if name not in r_emu_vars:
                v = tk.BooleanVar(value=True)
                r_emu_vars[name] = v
                r_emu_widgets[name] = ttk.Checkbutton(r_emu_frame, text=name, variable=v, command=r_update)
            r_emu_widgets[name].pack(side="left", padx=6)
            r_emu_vars[name].set(True)
        for name, cbx in r_emu_widgets.items():
            if name not in names: cbx.pack_forget()
        if names: r_emu_none.pack_forget()
        else: r_emu_none.pack(side="left", padx=6)
        a = current_archive[0]
        try:
            size = human(os.path.getsize(a))
        except OSError:
            size = "?"
        summary.set(f"written {(p.get('created') or '?')[:16].replace('T', ' ')}   ·   {size}"
                    f"   ·   desktop {p.get('desktop') or 'none'}"
                    f"   ·   holds {held} of {len(CAT_KEYS)} categories")
        r_update()
        say(f"Archive read: {os.path.basename(a)}")
    handlers["plan"] = plan_done

    for v in list(r_vars.values()) + [force_var, open_var]: v.trace_add("write", r_update)
    arch_var.trace_add("write", arch_changed)

    def refill_archives():
        say("Looking for archives...")
        in_background(find_archives, "archives")

    def archives_done(ok_, payload):
        found = payload if ok_ else []
        arch_box["values"] = found
        if ok_:
            say(f"{len(found)} archive(s) found on mounted media and in home folders."
                if found else "No archive found. Type a path, or plug the stick in and rescan.")
            if found and not arch_var.get():
                arch_var.set(found[0])
        else:
            say("Could not search for archives.")
    handlers["archives"] = archives_done

    def preview_done(ok_, payload):
        set_preview(payload if ok_ else f"dry run failed: {payload}")
        say("Dry run done; nothing was changed." if ok_ else "Dry run failed.")

    handlers["preview"] = preview_done

    def do_preview():
        a = current_archive[0]
        if not a:
            note("Restore", "Pick an archive first, or type the path to one.", kind="warn"); return
        say("Running the dry run...")
        set_preview("working...\n")
        argv = restore_argv(a, r_selected(), r_emus(), dry=True)

        def work():
            r = subprocess.run(argv, capture_output=True, text=True, timeout=600)
            return r.stdout + ("\n" + r.stderr if r.stderr.strip() else "")
        in_background(work, "preview")

    def do_restore():
        a = current_archive[0]
        if not a:
            note("Restore", "Pick an archive first, or type the path to one.", kind="warn"); return
        sel = r_selected()
        if not sel:
            note("Restore", "Nothing is selected, so there is nothing to restore.", kind="warn"); return
        argv = restore_argv(a, sel, r_emus(), force_var.get(), open_var.get())
        try:
            if force_var.get() and "configs" in sel and graphical_session_active():
                if not confirm("Restore",
                               "The desktop session will stop while the settings are written and start "
                               f"again afterwards.\n\nOutput goes to {FORCE_LOG}.",
                               go_text="[ Restore ]"):
                    return
                run_in_terminal("H96 restore", force_session_script(argv))
            else:
                run_in_terminal("H96 restore", sh(argv))
            say("Restore running in a terminal window.")
        except RuntimeError as e:
            note("Restore", str(e), kind="error")
    ttk.Button(bb, text="[ Preview (dry run) ]", command=do_preview).pack(side="left")
    ttk.Button(bb, text="[ Restore now ]", style="Go.TButton", command=do_restore).pack(side="right")

    # ------------------------------------------------------------ startup ---
    b_update()
    r_update()
    root.after(80, pump)
    root.after(0, load_probe)
    root.after(0, refill_archives)
    if "--restore" in sys.argv[1:]:
        nb.select(rt)

    # Wrapped notes start at WIN_W - 60 and then follow the width they are given,
    # so a maximized window spends its width on them instead of extra lines.
    def _follow_width(w):
        for c in w.winfo_children():
            if c.winfo_class() == "TLabel" and str(c.cget("wraplength")) == str(WIN_W - 60):
                c.bind("<Configure>", lambda e: e.widget.configure(
                    wraplength=max(300, e.width - 8)), add="+")
            _follow_width(c)
    _follow_width(root)

    # everything is laid out: place it, and only now put it on screen
    root.update_idletasks()
    w = min(max(WIN_W, root.winfo_reqwidth()), SCR_W - 20)
    h = min(max(WIN_H, root.winfo_reqheight()), SCR_H - 60)
    root.geometry(f"{w}x{h}+{max((SCR_W - w) // 2, 0)}+{max((SCR_H - h) // 4, 0)}")
    root.deiconify()
    # Below 1200 px the tabs, once the background scan fills them, want more height
    # than an unmaximized window gets under the title bar and taskbar; maximized, the
    # window manager gives the whole work area and every row fits. The size above is
    # still what un-maximizing returns to.
    # Sent once the window is mapped: a request made before that is dropped by KWin.
    def _zoom():
        try:
            root.wm_attributes("-zoomed", True)
        except tk.TclError:
            pass
    if SCR_H < 1200:
        root.after(150, _zoom)
    def _quit_key(e):
        w = root.focus_get()
        if w is not None and w.winfo_class() in ("Entry", "TEntry", "Text", "TCombobox"):
            return
        root.destroy()
    root.bind("<Key-q>", _quit_key)
    root.bind("<Key-Q>", _quit_key)
    root.mainloop()

def main():
    args = sys.argv[1:]
    if any(a in ("-v", "--version") for a in args):
        print(f"h96-backup-gui v{TOOL_VERSION}"); return
    if any(a in ("-h", "--help") for a in args):
        print(f"h96-backup-gui v{TOOL_VERSION} - graphical front end for h96-backup and h96-restore.\n\n"
              "  h96-backup-gui                    open the window\n"
              "  h96-backup-gui --restore          open on the Restore tab with the newest archive loaded\n"
              "  h96-backup-gui --install-desktop  write the application menu entry\n"
              "  h96-backup-gui --selftest         print the command lines it would build\n\n"
              "Pick categories with checkboxes; the matching h96-backup or h96-restore\n"
              "command runs in a terminal window so its prompts stay visible. The Archive\n"
              "and Save-to fields take a typed path as well as a pick from the list: give\n"
              "a folder and it is searched for archives. Needs python3-tk; the first\n"
              "launch installs it through a terminal.")
        return
    if "--install-desktop" in args:
        install_desktop(); return
    if "--selftest" in args:
        selftest(); return
    if not ensure_tk():
        sys.exit(1)
    user_desktop = os.path.expanduser("~/.local/share/applications/h96-backup-gui.desktop")
    if not os.path.exists(DESKTOP_FILE) and not os.path.exists(user_desktop) and os.geteuid() != 0:
        try: install_desktop()
        except OSError: pass
    gui()

if __name__ == "__main__":
    main()
