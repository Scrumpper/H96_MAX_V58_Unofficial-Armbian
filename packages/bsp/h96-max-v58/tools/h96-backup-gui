    st.configure("TProgressbar", background=CYAN, troughcolor=FIELD, bordercolor=BG,
                 lightcolor=CYAN, darkcolor=CYAN)

    # ---- worker thread plumbing --------------------------------------------
    # Reading the box or an archive shells out, which can take seconds. Doing it
    # on the UI thread freezes the window and leaves an unpainted rectangle
    # behind whatever was on top of it. Both run on a worker instead and hand
    # the result back through a queue the UI polls.
    results = queue.Queue()

    running = set()

    def in_background(fn, tag):
        running.add(tag)
        show_busy()

        def work():
            try:
                results.put((tag, True, fn()))
            except Exception as e:                       # noqa: BLE001 - reported in the window
                results.put((tag, False, str(e)))
        threading.Thread(target=work, daemon=True).start()

    def show_busy():
        if running:
            busy.pack(side="right", padx=(8, 0))
            busy.start(12)
        else:
            busy.stop()
            busy.pack_forget()

    handlers = {}

    def pump():
        while True:
            try:
                tag, ok_, payload = results.get_nowait()
            except queue.Empty:
                break
            running.discard(tag)
            show_busy()
            h = handlers.get(tag)
            if h: h(ok_, payload)
        root.after(80, pump)

    def read_json(argv, what):
        r = subprocess.run(argv, capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            raise RuntimeError(f"{what} failed: {(r.stderr.strip() or r.stdout.strip() or 'no output')}")
        try:
            return json.loads(r.stdout)
        except ValueError:
            raise RuntimeError(f"{what}: unreadable output")

    # ---- themed modal panels ------------------------------------------------
    # Tk's own message and file dialogs are drawn by the toolkit's Motif-era
    # code, which ignores ttk styling and comes up white on this dark window.
    # These replacements are ordinary Toplevels, so they carry the theme.
    def _modal(title, width, height):
        win = tk.Toplevel(root, bg=BG)
        win.withdraw()
        win.title(title)
        win.transient(root)
        win.resizable(False, False)
        outer = ttk.Frame(win, padding=0); outer.pack(fill="both", expand=True)
        bar = tk.Frame(outer, bg=PANEL, height=30); bar.pack(fill="x")
        tk.Label(bar, text=title, bg=PANEL, fg=CYAN, font=MONO_B).pack(side="left", padx=12, pady=5)
        body = ttk.Frame(outer, padding=(16, 12)); body.pack(fill="both", expand=True)

        def show():
            win.update_idletasks()
            w = max(width, win.winfo_reqwidth())
            h = max(height, win.winfo_reqheight())
            x = root.winfo_rootx() + (root.winfo_width() - w) // 2
            y = root.winfo_rooty() + (root.winfo_height() - h) // 3
            win.geometry(f"{w}x{h}+{max(x, 0)}+{max(y, 0)}")
            win.deiconify()
            win.grab_set()
            win.focus_set()
        return win, body, show

    def note(title, message, kind="info"):
        """A themed replacement for a message box. Blocks until dismissed."""
        win, body, show = _modal(title, 460, 150)
        colour = {"info": FG, "warn": YELLOW, "error": RED}.get(kind, FG)
        tk.Label(body, text=message, bg=BG, fg=colour, font=MONO, wraplength=420,
                 justify="left").pack(anchor="w", pady=(0, 14))
        row = ttk.Frame(body); row.pack(fill="x")
        btn = ttk.Button(row, text="[ OK ]", command=win.destroy)
        btn.pack(side="right")
        win.bind("<Return>", lambda e: win.destroy())
        win.bind("<Escape>", lambda e: win.destroy())
        win.protocol("WM_DELETE_WINDOW", win.destroy)
        show(); btn.focus_set()
        root.wait_window(win)

    def confirm(title, message, go_text="[ Continue ]"):
        """A themed yes/no. Returns True when the go button is pressed."""
        answer = {"v": False}
        win, body, show = _modal(title, 520, 180)
        tk.Label(body, text=message, bg=BG, fg=FG, font=MONO, wraplength=470,
                 justify="left").pack(anchor="w", pady=(0, 14))
        row = ttk.Frame(body); row.pack(fill="x")

        def go():
            answer["v"] = True; win.destroy()
        ttk.Button(row, text="[ Cancel ]", command=win.destroy).pack(side="left")
        btn = ttk.Button(row, text=go_text, style="Go.TButton", command=go)
        btn.pack(side="right")
        win.bind("<Return>", lambda e: go())
        win.bind("<Escape>", lambda e: win.destroy())
        win.protocol("WM_DELETE_WINDOW", win.destroy)
        show(); btn.focus_set()
        root.wait_window(win)
        return answer["v"]

    def browse(title, want="file", start=None):
        """A themed file and folder browser. Returns a path or None.

        want='file' lists folders and archives and returns an archive;
        want='dir' lists folders only and returns the folder shown."""
        chosen = {"v": None}
