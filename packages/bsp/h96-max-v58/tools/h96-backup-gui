            info.config(text=(f"{detail}  {size}".strip() if present else "not present on this box"),
                        style="TLabel" if present else "Muted.TLabel")
            cb.state(["!disabled"] if present else ["disabled"])
            if not present: b_vars[key].set(False)
            elif key != "waydroid-images": b_vars[key].set(True)
        vm_bytes = p.get("vm_disk_bytes", 0)
        vmdisks_cb.state(["!disabled"] if vm_bytes else ["disabled"])
        vmdisks_label.config(text=(f"{human(vm_bytes)}" if vm_bytes else "(none)"))
        if not vm_bytes: vmdisks_var.set(False)
        compat_bytes = p.get("steam_compatdata_bytes", 0)
