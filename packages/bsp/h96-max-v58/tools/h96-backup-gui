# scrumptop's banner texture, ported as-is: a sporadic purple speckle, dense at
# the edges and thinning toward the centre, deterministic per column so it never
# flickers between redraws. Same hash, thresholds and shades as scrumptop.
P_EDGE, P_MID, P_DIM = "#482468", "#321a4a", "#221332"
P_HI = "#8c46c8"   # sparse bright blockers set into the texture
BLOCK = "#9cc865"  # block-text banner: muted chartreuse (scrumptop uses the same)

def _noise(x, seed):
    h = (x * 2654435761 + seed * 40503) & 0xFFFFFFFF
    h ^= h >> 13
    h = (h * 2246822519) & 0xFFFFFFFF
    return ((h >> 8) & 0xFF) / 255.0

def _noise_cell(x, width, seed):
    """(glyph, colour) for one texture cell, exactly as scrumptop draws it."""
    half = max(1.0, (width - 1) / 2.0)
    e = min(x, width - 1 - x) / half
    d = 1.0 - e
    if _noise(x, seed + 977) < 0.03 + d * 0.04:
        return "\u2588", P_HI
    r = _noise(x, seed)
    if r < d * 0.25:
        return "\u2593", P_EDGE
    if r < d * 0.25 + 0.08:
        return "\u2592", P_MID
    if r < d * 0.25 + 0.18:
        return "\u2591", P_DIM
    if r < d * 0.25 + 0.28:
        return "\u254c", P_DIM
    return " ", P_DIM

