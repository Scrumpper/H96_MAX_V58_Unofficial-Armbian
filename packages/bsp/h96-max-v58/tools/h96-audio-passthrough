#!/usr/bin/env bash
# h96-audio-passthrough -- multichannel LPCM to an AV receiver over HDMI
# for the H96 Max V58 (RK3588, dw-hdmi-qp HDMI-TX audio).
#
# WHAT THIS DOES
#   Routes mpv audio out over the HDMI-TX port to an AVR / soundbar.
#     lpcm       Multichannel uncompressed PCM 5.1 / 7.1. mpv decodes on-box
#                and sends discrete channels over HDMI. (--audio-channels)
#   Compressed passthrough (AC3/DTS/E-AC3 bitstream over IEC61937) is NOT
#   supported yet: dw-hdmi-qp does not carry the IEC958 non-audio flag, so
#   the AV receiver hears it as noise. `bitstream` refuses; IEC958 codecs
#   advertised on the PipeWire HDMI node stay PCM-only until a kernel fix
#   lands.
#
# HOW IT WORKS
#   mpv config is kept in a managed marker block in /etc/mpv/mpv.conf that just
#   `include`s /etc/mpv/passthrough.conf. This tool regenerates that fragment
#   per mode + device and adds/removes the include block. `off` reverts mpv to
#   its base (stereo / PipeWire) config.
#
# SUBCOMMANDS
#   status              (default) detected HDMI device, mode, mpv + PW state
#   devices             list ALSA HDMI/IEC958 PCMs and PipeWire HDMI sinks
#   bitstream [DEV]     refuses: compressed passthrough not supported yet
#   lpcm [DEV] [CH]     enable multichannel LPCM (CH default = best detected layout)
#   off                 disable passthrough, revert mpv to base config
#   set-device DEV      persist the HDMI ALSA device to use
#   codecs on|off       no effect: IEC958 codecs stay PCM-only on this kernel
#   test                silent probe: mpv spdif, hw_params per layout, PW node
#   detect [OPTS]       read display EDID over DDC: kernel modes + audio it supports
#   display ACT         revert | native | status (mode through KDE)
#
# DETECT (= h96-display detect; unified video + audio detection)
#   Kernel sees only forced EDID (drm.edid_firmware), so display / receiver EDID
#   is read over DDC (adapter 'i2c-ddc') by /usr/local/lib/h96/edid_audio.py +
#   edid_merge.py. detect then:
#     1. builds display block 0 + CTA block rewritten for RGB 8-bit, modes <= 600 MHz,
#        progressive only, with sink Audio + Speaker Allocation blocks; test-loads it
#        into DRM under a throwaway name first (drm.edid_firmware + edid_override reset
#        + connector re-detect) and only on a verified reload renames it onto
#        /lib/firmware/edid/h96-sink-audio.bin (atomic, same directory) -- a kernel-
#        rejected merge never reaches that file. Makes X re-probe. No modeset, no
#        'force': KDE applies its own mode choice.
#     2. sets dw_hdmi_qp cec_phys_addr to sink HDMI VSDB physical address.
#     3. writes ACP profile set /etc/alsa-card-profile/mixer/profile-sets/
#        h96-hdmi.conf: Digital Stereo / Surround 5.1 / Surround 7.1 (HDMI),
#        only layouts sink supports (KDE tray + System Settings Profile list).
#     4. writes 51-h96-iec958.conf: iec958.codecs = PCM only (compressed passthrough
#        not supported on this kernel, whatever the sink lists).
#     5. restarts WirePlumber for logged-in users only when audio changed,
#        keeping default sink and HDMI volume.
#   KDE remembers modes per display (kernel EDID is byte-stable per display and tier).
#   EDID unreadable -> forced 1080p EDID, stereo, no passthrough. Runs at boot
#   (h96-hdmi-audio-detect.service) and on HDMI hotplug (99-h96-hdmi-audio.rules).
#
# DEV is an ALSA PCM name such as  hdmi:CARD=rockchiphdmi0,DEV=0  (see `devices`).
# If omitted, the persisted device (set-device) or an auto-detected HDMI PCM
# is used.
#
# Deployed to /usr/local/bin/h96-audio-passthrough.

set -uo pipefail

[ -r /usr/local/lib/h96/banner.sh ] && . /usr/local/lib/h96/banner.sh
command -v h96_banner >/dev/null 2>&1 || h96_banner() { :; }

MPV_CONF="${H96_MPV_CONF:-/etc/mpv/mpv.conf}"
FRAG="/etc/mpv/passthrough.conf"
STATE="/etc/h96/audio-passthrough.state"
WP_CONF="/etc/wireplumber/wireplumber.conf.d/51-h96-iec958.conf"

BEGIN='# >>> h96-audio-passthrough >>>'
END='# <<< h96-audio-passthrough <<<'

# detect
EDID_LIB="${H96_EDID_LIB:-/usr/local/lib/h96/edid_audio.py}"
HDMI_CARD="rockchiphdmi0"
HDMI_HW="hw:CARD=$HDMI_CARD,DEV=0"
FORCED_EDID="${H96_FORCED_EDID:-/lib/firmware/edid/h96-1080p-audio.bin}"  # cmdline drm.edid_firmware, stereo
SINK_EDID_REL="${H96_SINK_EDID_REL:-edid/h96-sink-audio.bin}"
SINK_EDID="${H96_SINK_EDID:-/lib/firmware/$SINK_EDID_REL}"
PROFILE_SET="/etc/alsa-card-profile/mixer/profile-sets/h96-hdmi.conf"
SINK_JSON="/etc/h96/hdmi-sink.json"
CODECS_OFF_FLAG="/etc/h96/audio-passthrough.codecs-off"
DRM_CONN="${H96_DRM_CONN:-/sys/class/drm/card0-HDMI-A-1}"
DRM_PARAM="${H96_DRM_PARAM:-/sys/module/drm/parameters/edid_firmware}"
DRM_OVERRIDE="${H96_DRM_OVERRIDE:-/sys/kernel/debug/dri/0/HDMI-A-1/edid_override}"
CEC_PHYS_PARAM="${H96_CEC_PHYS_PARAM:-/sys/module/dw_hdmi_qp/parameters/cec_phys_addr}"
X_AUTH="/var/run/lightdm/root/:0"            # X server auth (greeter and session)
DETECT_LOCK="/run/h96-audio-detect.lock"     # shared with h96-cec phys-addr
SCDC_BIN="/usr/local/sbin/h96-scdc"
NOLOCK="/etc/h96/display-nolock"             # "display_md5 kHz WxH@HZ": h96-scdc saw no lock
AUTODETECT_OFF="/etc/h96/display-autodetect.off"
HDMI20_OFF="/etc/h96/display-hdmi20.off"      # hdmi20 (600 MHz tier + h96-scdc) default on
SAFE_PREF="1920x1080@60"
WP_PENDING="/run/h96-audio-detect.wp-pending"
HOTPLUG_STATE="/run/h96-audio-detect.last"    # debounce: "TS HASH" of last hotplug run
HOTPLUG_DEBOUNCE=5                            # seconds; same EDID hash inside this window = skip
HDMI_NODE_RE='^alsa_output\.platform-hdmi0-sound\.'

# Sink EDID (detect) lists which compressed codecs the sink would accept, for
# status only: none are enabled. dw-hdmi-qp does not carry the IEC958 non-audio
# flag, so AC3/DTS/EAC3 bitstream reaches the sink as PCM noise; TrueHD/DTS-HD
# were never enabled either (HBR/MAT over this stack is unverified).

err()  { printf '%s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "This action changes system config; re-run as root (sudo $0 $*)."
    exit 1
  fi
}

# ---------------------------------------------------------------- state I/O
# best layout last detect found (stereo when never detected / EDID unreadable)
detected_channels() {
  local c=""
  [ -r "$SINK_JSON" ] && c="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["mpv_channels"].split(",")[0])' "$SINK_JSON" 2>/dev/null)"
  printf '%s\n' "${c:-stereo}"
}

STATE_MODE="off"; STATE_DEVICE=""; STATE_CHANNELS=""
load_state() {
  STATE_CHANNELS="$(detected_channels)"
  [ -r "$STATE" ] || return 0
  # shellcheck disable=SC1090
  . "$STATE" 2>/dev/null || true
  STATE_MODE="${MODE:-off}"
  STATE_DEVICE="${DEVICE:-}"
  STATE_CHANNELS="${CHANNELS:-$STATE_CHANNELS}"
}
save_state() {
  mkdir -p "$(dirname "$STATE")"
  {
    echo "# h96-audio-passthrough state -- managed file, edited by the tool."
    echo "MODE=$1"
    echo "DEVICE=\"$2\""
    echo "CHANNELS=\"$3\""
  } > "$STATE.h96new" && mv -f "$STATE.h96new" "$STATE"
}

# ---------------------------------------------------------------- discovery
# Emit candidate HDMI PCM names, best first, one per line.
# Prefers hdmi:CARD=... (does IEC958 status bits + channel map), then
# iec958:CARD=..., then a raw hw: fallback derived from the card index.
list_hdmi_pcms() {
  if have aplay; then
    aplay -L 2>/dev/null | grep -E '^(hdmi|iec958):CARD=' || true
  fi
  # raw hw: fallback from /proc/asound/cards -- match card whose id/name mentions hdmi
  if [ -r /proc/asound/cards ]; then
    awk '
      /^[ ]*[0-9]+ \[/ {
        idx=$1; name=$0
        # id is the token inside [ ]
        gsub(/^[ ]*[0-9]+ \[/,"",name); sub(/\].*/,"",name); gsub(/ /,"",name)
        line=$0
      }
      tolower($0) ~ /hdmi/ && idx!="" {
        if (!seen[idx]++) print "hw:" idx ",0   (card " idx " " name ")"
      }
    ' /proc/asound/cards 2>/dev/null | sed 's/  *(card.*)//'
  fi
}

# The single best default PCM name (no annotations).
detect_device() {
  local d
  d="$(list_hdmi_pcms | head -n1)"
  # strip any trailing annotation
  printf '%s\n' "$d" | awk '{print $1}'
}

# Resolve the device to use: explicit arg > persisted > auto.
resolve_device() {
  local arg="${1:-}"
  if [ -n "$arg" ]; then printf '%s\n' "$arg"; return 0; fi
  load_state
  if [ -n "$STATE_DEVICE" ]; then printf '%s\n' "$STATE_DEVICE"; return 0; fi
  detect_device
}

# ---------------------------------------------------------------- mpv block
strip_block() {
  # remove the managed marker block from mpv.conf (if present)
  [ -f "$MPV_CONF" ] || return 0
  if grep -qF "$BEGIN" "$MPV_CONF" 2>/dev/null; then
    sed -i "/$(printf '%s' "$BEGIN" | sed 's/[][\.*^$/]/\\&/g')/,/$(printf '%s' "$END" | sed 's/[][\.*^$/]/\\&/g')/d" "$MPV_CONF"
  fi
}

add_block() {
  mkdir -p "$(dirname "$MPV_CONF")"
  [ -f "$MPV_CONF" ] || : > "$MPV_CONF"
  strip_block
  # drop trailing blank lines then append the block
  printf '\n%s\n' "$BEGIN" >> "$MPV_CONF"
  printf 'include=%s\n' "$FRAG" >> "$MPV_CONF"
  printf '%s\n' "$END" >> "$MPV_CONF"
}

write_frag_lpcm() {
  local dev="$1" ch="$2" chain
  case "$ch" in 7.1) chain="7.1,5.1,stereo" ;; 5.1) chain="5.1,stereo" ;; *) chain="stereo" ;; esac
  mkdir -p "$(dirname "$FRAG")"
  cat > "$FRAG" <<EOF
# /etc/mpv/passthrough.conf -- managed by h96-audio-passthrough (mode: lpcm)
# Edits here are overwritten on the next enable/disable. Included by mpv.conf
# only while passthrough is ON.
#
# Multichannel uncompressed LPCM over HDMI. mpv decodes on-box and sends
# discrete channels to the receiver. Falls back down the channel list if the
# sink/ELD cannot take the top layout. Top layout = 'detect' result.
# mpv opens HDMI PCM directly: stop other HDMI playback (PipeWire HDMI sink
# busy -> ALSA open fails).
ao=alsa,pipewire
audio-device=alsa/$dev
audio-exclusive=yes
audio-channels=$chain
# no audio-spdif: send PCM, let the receiver render the speaker layout.
EOF
}

# ---------------------------------------------------------------- pipewire
# Run a command as desktop user UID (pactl / systemctl --user need session env).
as_user() {
  local uid="$1"; shift
  local user; user="$(id -nu "$uid" 2>/dev/null)" || return 1
  if [ "$(id -u)" -eq "$uid" ]; then
    XDG_RUNTIME_DIR="/run/user/$uid" "$@"
  else
    runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" "$@"
  fi
}

hdmi_sink_of() {   # first HDMI-TX sink name for UID
  as_user "$1" pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -E "$HDMI_NODE_RE" | head -n1
}

# Restart WirePlumber in every running desktop session. HDMI sink name changes
# with ACP profile (hdmi-stereo / hdmi-surround71), so default sink and HDMI
# volume are read before and put back after. Bluetooth default is untouched.
wp_reload() {
  local rd uid old_def old_sink old_vol new i done_any=0
  for rd in /run/user/[0-9]*; do
    uid="${rd##*/}"
    [ "$uid" -ge 1000 ] 2>/dev/null || continue
    [ -S "$rd/pipewire-0" ] || continue
    as_user "$uid" systemctl --user is-active --quiet wireplumber || continue
    old_def="$(as_user "$uid" pactl get-default-sink 2>/dev/null)"
    old_sink="$(hdmi_sink_of "$uid")"
    old_vol=""
    [ -n "$old_sink" ] && old_vol="$(as_user "$uid" pactl get-sink-volume "$old_sink" 2>/dev/null \
      | grep -oE '[0-9]+%' | head -n1)"
    as_user "$uid" systemctl --user restart wireplumber || { err "wireplumber restart failed (uid $uid)"; continue; }
    new=""
    for i in $(seq 1 20); do
      sleep 0.5
      new="$(hdmi_sink_of "$uid")"
      [ -n "$new" ] && break
    done
    if [ -z "$new" ]; then
      err "!! uid $uid: no HDMI sink after WirePlumber restart (check: pactl list cards)"
      continue
    fi
    if printf '%s\n' "$old_def" | grep -qE "$HDMI_NODE_RE" && [ "$old_def" != "$new" ]; then
      as_user "$uid" pactl set-default-sink "$new" && echo "  default sink kept on HDMI: $new"
    fi
    [ -n "$old_vol" ] && as_user "$uid" pactl set-sink-volume "$new" "$old_vol"
    echo "  WirePlumber restarted for uid $uid (HDMI sink: $new)"
    done_any=1
  done
  [ "$done_any" -eq 1 ] || echo "  no running desktop session: new config applies at next login"
  return 0
}

codecs_on() {
  need_root "$@"
  rm -f "$CODECS_OFF_FLAG"
  cmd_detect --force-wp
}

codecs_off() {
  need_root "$@"
  mkdir -p "$(dirname "$CODECS_OFF_FLAG")"
  touch "$CODECS_OFF_FLAG"
  cmd_detect --force-wp
}

# ---------------------------------------------------------------- detect
# CEC physical address of sink -> dw_hdmi_qp override (belt and braces: merged EDID
# carries sink VSDB too; audio-only mode carries forced 1.0.0.0). 0 = changed.
set_cec_pa() {
  local want="${1:-}" cur
  [ -n "$want" ] && [ "$want" != None ] && [ -w "$CEC_PHYS_PARAM" ] || return 1
  cur="$(printf '0x%04x' "$(cat "$CEC_PHYS_PARAM" 2>/dev/null || echo 0)")"
  [ "$cur" = "$want" ] && return 1
  echo "$((want))" > "$CEC_PHYS_PARAM" || return 1
  echo "  CEC physical address: $cur -> $want"
  return 0
}

# $SINK_EDID must always exist and hold content the kernel already accepted (revert
# target after a failed reload). Seed it from the forced (stereo) EDID the first time.
ensure_known_good_edid() {
  [ -s "$SINK_EDID" ] && return 0
  mkdir -p "$(dirname "$SINK_EDID")"
  install -m 0644 "$FORCED_EDID" "$SINK_EDID.h96new" && mv -f "$SINK_EDID.h96new" "$SINK_EDID"
}

# Load merged EDID into DRM: kernel modes, ELD (hdmi-codec channel limit + infoframe
# speaker allocation) and CEC address follow sink. Never writes debugfs edid_override
# content (a stored override NULL-derefs on HDMI replug in this 6.1 tree) and never
# writes 'force'. No modeset: connector re-probe only; desktop applies its own choice.
# New CANDIDATE content is staged under a throwaway name and test-loaded first; only a
# kernel-accepted candidate is renamed onto $SINK_EDID (the file the boot cmdline names),
# so a rejected merge never reaches disk. On rejection $SINK_EDID is left exactly as it
# was (already kernel-accepted, or freshly seeded by ensure_known_good_edid above).
# Returns 0 = reloaded (video same), 3 = reloaded (video changed), 2 = current, 1 = failed.
apply_kernel_edid() {
  local pa="${1:-}" candidate="${2:-}" want="HDMI-A-1:$SINK_EDID_REL" \
        cur_md5 want_md5 modes_before same_video=0 edid_src edid_rel staged=0
  if [ ! -w "$DRM_PARAM" ] || [ ! -e "$DRM_OVERRIDE" ] || [ ! -e "$DRM_CONN/status" ]; then
    echo "  kernel EDID: DRM parameter/debugfs missing, unchanged"; return 1
  fi
  if [ "$(cat "$DRM_CONN/status")" != "connected" ]; then
    echo "  kernel EDID: HDMI-A-1 not connected, unchanged"; return 1
  fi
  local pa_changed=0
  set_cec_pa "$pa" && pa_changed=1
  ensure_known_good_edid

  if [ -n "$candidate" ] && ! cmp -s "$candidate" "$SINK_EDID" 2>/dev/null; then
    edid_src="$(mktemp "${SINK_EDID}.XXXXXX")" || { err "!! kernel EDID: mktemp failed, unchanged"; return 1; }
    install -m 0644 "$candidate" "$edid_src"
    edid_rel="$(dirname "$SINK_EDID_REL")/$(basename "$edid_src")"
    staged=1
  else
    edid_src="$SINK_EDID"
    edid_rel="$SINK_EDID_REL"
  fi

  want_md5="$(md5sum < "$edid_src" | cut -c1-32)"
  cur_md5="$(md5sum < "$DRM_CONN/edid" | cut -c1-32)"
  if [ "$staged" -eq 0 ] && [ "$(cat "$DRM_PARAM")" = "$want" ] && [ "$cur_md5" = "$want_md5" ]; then
    [ "$pa_changed" -eq 1 ] && echo detect > "$DRM_CONN/status"
    echo "  kernel EDID: current"; return 2
  fi
  cmp -s -n 128 "$edid_src" "$DRM_CONN/edid" && same_video=1
  modes_before="$(cat "$DRM_CONN/modes")"
  printf '%s' "HDMI-A-1:$edid_rel" > "$DRM_PARAM"
  printf reset > "$DRM_OVERRIDE"   # exactly 5 bytes: "reset\n" is parsed as EDID -> EINVAL
  echo detect > "$DRM_CONN/status"
  cur_md5="$(md5sum < "$DRM_CONN/edid" | cut -c1-32)"
  if [ "$cur_md5" != "$want_md5" ] || [ -z "$(cat "$DRM_CONN/modes")" ] || \
     { [ "$same_video" -eq 1 ] && [ "$(cat "$DRM_CONN/modes")" != "$modes_before" ]; }; then
    err "!! kernel EDID: reload mismatch (edid md5 $cur_md5, modes changed or empty): back to forced EDID"
    [ "$staged" -eq 1 ] && rm -f "$edid_src"    # candidate discarded, $SINK_EDID untouched
    printf '%s' "HDMI-A-1:${FORCED_EDID#/lib/firmware/}" > "$DRM_PARAM"
    printf reset > "$DRM_OVERRIDE"
    echo detect > "$DRM_CONN/status"
    return 1
  fi
  if [ "$staged" -eq 1 ]; then
    mv -f "$edid_src" "$SINK_EDID"    # verified content only: atomic, same directory
    printf '%s' "$want" > "$DRM_PARAM"
    printf reset > "$DRM_OVERRIDE"
    echo detect > "$DRM_CONN/status"
  fi
  if [ "$same_video" -eq 1 ]; then
    echo "  kernel EDID: reloaded from $SINK_EDID (video unchanged)"; return 0
  fi
  echo "  kernel EDID: reloaded from $SINK_EDID, modes: $(sort -u "$DRM_CONN/modes" | tr '\n' ' ')"
  return 3
}

# Sysfs re-probe sends no uevent: X keeps its old mode list until asked. xrandr -q makes
# X re-probe; KDE (kscreen) then lists new modes. No mode is set here.
x_reprobe() {
  [ -S /tmp/.X11-unix/X0 ] && [ -r "$X_AUTH" ] && have xrandr || return 0
  if DISPLAY=:0 XAUTHORITY="$X_AUTH" timeout 10 xrandr -q >/dev/null 2>&1; then
    echo "  X re-probed: desktop mode list updated"
  fi
}

# Open HDMI PCM with zero samples: hdmi-codec copies new ELD into its ALSA 'ELD'
# control on open. Silent. Skipped while PipeWire holds the device.
prime_eld() {
  local idx
  idx="$(awk -v c="$HDMI_CARD" '$2=="["c {print $1}' /proc/asound/cards 2>/dev/null)"
  [ -n "$idx" ] || return 0
  fuser "/dev/snd/pcmC${idx}D0p" >/dev/null 2>&1 && return 0
  aplay -q -D "$HDMI_HW" -t raw -f S16_LE -r 48000 -c 2 /dev/null >/dev/null 2>&1 || true
}

# install SRC DST: copy when content differs; prints and returns 0 when changed
install_if_changed() {
  local src="$1" dst="$2"
  if [ -f "$dst" ] && cmp -s "$src" "$dst"; then return 1; fi
  mkdir -p "$(dirname "$dst")"
  install -m 0644 "$src" "$dst.h96new" && mv -f "$dst.h96new" "$dst"
  echo "  updated $dst"
  return 0
}

jget() { python3 -c 'import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2]); print("" if v is None else v)' "$2" "$1" 2>/dev/null; }

# ---------------------------------------------------------------- display (KDE)
# Kernel EDID is byte-stable per display and tier: KDE keeps one saved config per display
# (~/.local/share/kscreen/outputs/<kernel EDID md5>) and lists every mode; KDE's own keep
# dialog covers mode choices. h96-scdc reverts a scrambled mode without sink lock.
# display revert|native|status (h96-display)
cmd_display() {
  local act="${1:-status}" md5 name pref
  md5="$(jget kernel_edid_md5 "$SINK_JSON")"; name="$(jget sink "$SINK_JSON")"; pref="$(jget preferred "$SINK_JSON")"
  case "$act" in
    status)
      echo "display:     ${name:-unknown} (kernel EDID ${md5:-never detected})"
      echo "video:       $(jget video "$SINK_JSON"), preferred ${pref:-?}"
      echo "autodetect:  $([ -e "$AUTODETECT_OFF" ] && echo off || echo on)   hdmi20: $([ -e "$HDMI20_OFF" ] && echo off || echo on)"
      [ -x "$SCDC_BIN" ] && "$SCDC_BIN" status 2>/dev/null | sed 's/^/scdc:        /'
      [ -s "$NOLOCK" ] && sed 's/^/no lock:     /' "$NOLOCK"
      return 0 ;;
  esac
  need_root "display $act"
  case "$act" in
    keep)   return 0 ;;   # forced-mode trial only (h96-display keep)
    revert) "$SCDC_BIN" set-mode "$SAFE_PREF" && echo "$name: $SAFE_PREF (KDE saves it)" ;;
    native) [ -f "$NOLOCK" ] && [ -n "$md5" ] && sed -i "/^$(jget display_md5 "$SINK_JSON") /d" "$NOLOCK"
            "$SCDC_BIN" set-mode "$pref" && echo "$name: $pref (KDE saves it)" ;;
    *) err "display: keep | revert | native | status"; return 1 ;;
  esac
}

cmd_detect() {
  local edid="" dry=0 restart=1 hotplug=0 force_wp=0 quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --edid)       edid="${2:-}"; shift ;;
      --dry-run|-n) dry=1 ;;
      --no-restart) restart=0 ;;
      --hotplug)    hotplug=1 ;;
      --force-wp)   force_wp=1 ;;
      --quiet|-q)   quiet=1 ;;
      -h|--help)    usage_detect; return 0 ;;
      *) err "detect: unknown option '$1'"; usage_detect; return 1 ;;
    esac
    shift
  done
  if [ "$dry" -eq 0 ]; then
    need_root detect
    # one DDC reader at a time (boot service, udev hotplug, manual run, h96-cec)
    exec 9>"$DETECT_LOCK"
    flock -w 60 9 || { err "detect: another detect still running"; return 1; }
  fi
  [ -r "$EDID_LIB" ] || { err "missing $EDID_LIB"; return 1; }
  [ -r "$FORCED_EDID" ] || { err "missing $FORCED_EDID"; return 1; }
  if [ -n "$edid" ] && [ ! -r "$edid" ]; then err "cannot read EDID file: $edid"; return 1; fi
  # retired state: edid-adapt opt-in, hdmi20 opt-in, display trial and its keep tokens
  if [ "$dry" -eq 0 ]; then
    rm -f /etc/h96/display-autodetect.enabled /run/h96-edid-adapt.last \
      /etc/h96/display-hdmi20.enabled /etc/h96/display-known /etc/h96/display-trial
    rm -rf /var/lib/h96/display-confirm
  fi

  # hotplug: HPD may rise before sink EEPROM answers; unplug leaves state as is.
  if [ "$hotplug" -eq 1 ] && [ -z "$edid" ]; then
    local st i
    for i in 1 2 3 4 5; do
      st="$(cat "$DRM_CONN/status" 2>/dev/null)"
      [ "$st" = "connected" ] && break
      sleep 2
    done
    if [ "$st" != "connected" ]; then
      echo "HDMI-A-1 disconnected: detection state unchanged."; return 0
    fi
    sleep 2
  fi

  local tmp; tmp="$(mktemp -d /tmp/h96-detect.XXXXXX)" || return 1
  local plan_args=(plan --forced "$FORCED_EDID" --outdir "$tmp")
  [ -n "$edid" ] && plan_args+=(--edid "$edid")
  [ -e "$CODECS_OFF_FLAG" ] && plan_args+=(--codecs-off)
  [ -e "$AUTODETECT_OFF" ] && plan_args+=(--audio-only)
  # H96_DISPLAY_HDMI20=on|off: h96-display trial value, flag file untouched
  case "${H96_DISPLAY_HDMI20:-}" in
    on) plan_args+=(--hdmi20) ;;
    off) ;;
    *) [ -e "$HDMI20_OFF" ] || plan_args+=(--hdmi20) ;;
  esac
  [ "$quiet" -eq 1 ] || h96_banner "H D M I   D E T E C T"
  if ! python3 "$EDID_LIB" "${plan_args[@]}" > "$tmp/stdout" 2>&1; then
    cat "$tmp/stdout" >&2; rm -rf "$tmp"; return 1
  fi

  [ "$quiet" -eq 1 ] || cat "$tmp/report.txt"
  [ -e "$CODECS_OFF_FLAG" ] && echo "(codecs off flag present; no effect: IEC958 codecs already PCM-only on this kernel)"

  # debounce: repeat hotplug triggers inside HOTPLUG_DEBOUNCE do nothing.
  local cur_hash=""
  cur_hash="$(jget kernel_edid_md5 "$tmp/offer.json")"
  if [ "$hotplug" -eq 1 ] && [ "$dry" -eq 0 ] && [ -n "$cur_hash" ] && [ -r "$HOTPLUG_STATE" ]; then
    local last_ts="" last_hash="" now; now="$(date +%s)"
    read -r last_ts last_hash < "$HOTPLUG_STATE" 2>/dev/null
    if [ "$cur_hash" = "$last_hash" ] && [ -n "$last_ts" ] && [ $((now - last_ts)) -lt "$HOTPLUG_DEBOUNCE" ]; then
      [ "$quiet" -eq 1 ] || echo "debounce: same sink EDID re-detected <${HOTPLUG_DEBOUNCE}s after last run, skipping"
      rm -rf "$tmp"; return 0
    fi
  fi

  if [ "$dry" -eq 1 ]; then
    echo
    echo "-- dry run: nothing changed. Would write:"
    echo "   kernel EDID md5: $cur_hash"
    local f
    for f in "$PROFILE_SET:h96-hdmi.conf" "$WP_CONF:51-h96-iec958.conf" "$SINK_EDID:h96-sink-audio.bin"; do
      if [ -f "${f%%:*}" ] && cmp -s "$tmp/${f##*:}" "${f%%:*}"; then echo "   ${f%%:*} (unchanged)"
      else echo "   ${f%%:*} (CHANGE)"; fi
    done
    echo
    echo "-- profile set:"; grep -E '^\[Mapping|^description' "$tmp/h96-hdmi.conf" | sed 's/^/   /'
    echo "-- iec958.codecs:"; grep -o 'iec958.codecs = \[.*\]' "$tmp/51-h96-iec958.conf" | sed 's/^/   /'
    rm -rf "$tmp"; return 0
  fi

  echo
  local wp_changed=0 k_changed=0 multi=0 krc
  install_if_changed "$tmp/h96-hdmi.conf" "$PROFILE_SET" && wp_changed=1
  install_if_changed "$tmp/51-h96-iec958.conf" "$WP_CONF" && wp_changed=1
  # kernel EDID: staged + test-loaded by apply_kernel_edid; $SINK_EDID is only ever
  # replaced with content the kernel already accepted (see its own comment).
  apply_kernel_edid "$(jget phys_addr_hex "$tmp/offer.json")" "$tmp/h96-sink-audio.bin"; krc=$?
  case "$krc" in
    0) k_changed=1 ;;
    3) k_changed=1; x_reprobe ;;
  esac
  install_if_changed "$tmp/offer.json" "$SINK_JSON" || true
  # hotplug: connected display's colour format / range back on connector (no-op at defaults)
  if [ "$hotplug" -eq 1 ] && [ -x /usr/local/sbin/h96-display ]; then
    /usr/local/sbin/h96-display session-apply || true
  fi
  prime_eld
  grep -q '^\[Mapping hdmi-surround' "$PROFILE_SET" && multi=1

  # mpv lpcm fragment follows detected layouts
  load_state
  if [ "$STATE_MODE" = "lpcm" ]; then
    write_frag_lpcm "$(resolve_device)" "$(detected_channels)"
    save_state lpcm "$STATE_DEVICE" "$(detected_channels)"
    echo "  mpv lpcm fragment -> $(detected_channels)"
  elif [ "$STATE_MODE" = "bitstream" ]; then
    echo "  bitstream mode no longer supported (compressed passthrough not supported on this kernel);"
    echo "  mpv fragment left as is. Run 'h96-audio-passthrough lpcm' or 'off' to update it."
  fi

  # ACP probes channel counts once, at card creation: recreate card when profile
  # set / codecs changed, or kernel ELD changed while surround layouts are listed.
  # restart skipped by an earlier --no-restart stays pending until one happens
  if [ "$force_wp" -eq 1 ] || [ "$wp_changed" -eq 1 ] || [ -e "$WP_PENDING" ] \
     || { [ "$k_changed" -eq 1 ] && [ "$multi" -eq 1 ]; }; then
    if [ "$restart" -eq 1 ]; then wp_reload; rm -f "$WP_PENDING"
    else touch "$WP_PENDING"; echo "  --no-restart: restart WirePlumber to apply (pending: next detect restarts)"; fi
  else
    echo "  no audio change: WirePlumber left running"
  fi
  if [ "$hotplug" -eq 1 ] && [ -n "$cur_hash" ]; then
    printf '%s %s\n' "$(date +%s)" "$cur_hash" > "$HOTPLUG_STATE.h96new" 2>/dev/null \
      && mv -f "$HOTPLUG_STATE.h96new" "$HOTPLUG_STATE" 2>/dev/null || true
  fi
  rm -rf "$tmp"
  return 0
}

usage_detect() {
  cat <<EOF
h96-display detect [--edid FILE] [--dry-run] [--no-restart] [--hotplug] [--quiet]
(same as: h96-audio-passthrough detect ...)

Reads connected display / AV receiver EDID over DDC (i2c-ddc) and builds one kernel
EDID from it (/lib/firmware/edid/h96-sink-audio.bin, loaded via drm.edid_firmware):
  video        display modes (preferred first) as KDE System Settings > Display lists
               them; RGB 8-bit only (YCbCr, deep colour, HDR, 4:2:0 blocks removed);
               modes above 600 MHz (340 MHz with hdmi20 off) and interlaced removed
  layouts      Digital Stereo / Surround 5.1 / Surround 7.1 (HDMI) card profiles,
               selectable in KDE tray (speaker menu > Profile) and
               System Settings > Sound (Profile box). Only layouts sink lists.
  passthrough  compressed passthrough (AC3/DTS) not supported yet: HDMI path
               sends it as PCM noise. Stereo PCM works; 5.1/7.1 untested.
  CEC          sink physical address -> dw_hdmi_qp cec_phys_addr
No mode is set: X re-probes, KDE applies its own choice (display preferred mode).
KDE remembers the mode per display (System Settings > Display lists every mode).
EDID unreadable -> forced 1920x1080@60 EDID, stereo, no passthrough.
No change -> nothing reloaded or restarted.

  --edid FILE   use FILE as sink EDID (test a receiver without one:
                --edid .../h96-1080p-audio-8ch.bin), then run 'detect' again
  --dry-run     print result and planned file changes, change nothing
  --no-restart  write config, do not restart WirePlumber
  --hotplug     used by udev: wait for HDMI connect + DDC, skip on unplug
  --quiet       no report
Switches: h96-display autodetect off (forced 1080p video, sink audio only),
          h96-display hdmi20 off (340 MHz ceiling, no scrambling; default on).
Runs automatically: h96-hdmi-audio-detect.service (boot, hotplug).
EOF
}

# ---------------------------------------------------------------- commands
cmd_devices() {
  h96_banner "A U D I O   P A S S T H R O U G H"
  echo "-- ALSA HDMI / IEC958 PCMs (use one of these as DEV) --"
  local pcms; pcms="$(list_hdmi_pcms)"
  if [ -n "$pcms" ]; then printf '%s\n' "$pcms" | sed 's/^/  /'
  else echo "  (none found -- no HDMI audio card exposed by ALSA)"; fi
  echo
  echo "-- aplay -l (card:device map) --"
  if have aplay; then aplay -l 2>/dev/null | grep -iE 'card|hdmi' | sed 's/^/  /' || echo "  (aplay reported nothing)"
  else echo "  aplay not installed (apt-get install alsa-utils)"; fi
  echo
  echo "-- PipeWire HDMI sinks --"
  if have wpctl; then
    wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep -i hdmi | sed 's/^/  /' \
      || echo "  (no HDMI sink listed by wpctl -- PipeWire may not be running for this user)"
  else echo "  wpctl not available"; fi
}

cmd_status() {
  load_state
  h96_banner "A U D I O   P A S S T H R O U G H"
  local dev; dev="$(resolve_device)"
  echo "mode:            $STATE_MODE"
  echo "device (chosen): ${STATE_DEVICE:-<auto>}"
  echo "device (resolved): ${dev:-<none detected>}"
  [ "$STATE_MODE" = "lpcm" ] && echo "channels:        $STATE_CHANNELS"
  echo
  echo "mpv config:      $MPV_CONF"
  if [ -f "$MPV_CONF" ] && grep -qF "$BEGIN" "$MPV_CONF"; then
    echo "  passthrough block: PRESENT"
    [ -f "$FRAG" ] && sed 's/^/    /' "$FRAG" | grep -E 'mode:|ao=|audio-device=|audio-spdif=|audio-channels='
  else
    echo "  passthrough block: absent (mpv on base/PCM config)"
  fi
  echo
  echo "PipeWire IEC958 advertise: $([ -f "$WP_CONF" ] && grep -o 'iec958.codecs = \[.*\]' "$WP_CONF" || echo off)"
  if [ -r "$SINK_JSON" ]; then
    echo "detected sink:   $(python3 -c '
import json, sys
o = json.load(open(sys.argv[1]))
listed = o["codecs"][1:]
pt = (" ".join(listed) + " (passthrough not supported on this kernel)") if listed else "none"
print("%s (%s): layouts %s, sink lists: %s" % (o.get("sink") or "?", o["source"], " ".join(o["layouts"]), pt))
' "$SINK_JSON" 2>/dev/null)"
  else
    echo "detected sink:   never detected (run: sudo h96-audio-passthrough detect)"
  fi
  echo
  if [ -z "$dev" ]; then
    echo "!! No HDMI audio PCM detected. Passthrough cannot work until the box"
    echo "   exposes an HDMI sound card. Check: aplay -l ; dmesg | grep -i hdmi"
  fi
}

enable_bitstream() {
  err "compressed passthrough (AC3/DTS) not supported yet: HDMI path sends it as PCM noise. Use 'lpcm' for multichannel PCM instead."
  exit 1
}

enable_lpcm() {
  need_root "$@"
  local dev ch
  dev="$(resolve_device "${1:-}")"
  ch="${2:-}"
  [ -z "$ch" ] && ch="$(detected_channels)"
  if [ -z "$dev" ]; then
    err "No HDMI ALSA device detected and none given (see 'devices')."
    exit 1
  fi
  case "$ch" in
    5.1|7.1|stereo) : ;;
    *) err "channels must be one of: stereo 5.1 7.1  (got '$ch')"; exit 1 ;;
  esac
  if [ "$ch" != stereo ] && ! grep -q "\"$ch\"" "$SINK_JSON" 2>/dev/null; then
    err "warning: sink did not report $ch (see 'detect'); mpv falls back down the list."
  fi
  write_frag_lpcm "$dev" "$ch"
  add_block
  save_state lpcm "$dev" "$ch"
  echo "multichannel LPCM passthrough ON  ->  $dev  (top layout $ch)"
  echo "  Restart mpv to pick up the new config."
}

cmd_off() {
  need_root "$@"
  strip_block
  load_state
  save_state off "$STATE_DEVICE" "$STATE_CHANNELS"
  echo "passthrough OFF. mpv reverted to base config. ($FRAG left in place, unused.)"
  echo "  (IEC958 PipeWire advertise unchanged; 'codecs off' to remove that too.)"
}

cmd_set_device() {
  need_root "$@"
  local dev="${1:-}"
  [ -z "$dev" ] && { err "usage: set-device <ALSA-PCM>   (see 'devices')"; exit 1; }
  load_state
  save_state "$STATE_MODE" "$dev" "$STATE_CHANNELS"
  echo "persisted device: $dev"
  # if a mode is active, rewrite the fragment against the new device
  case "$STATE_MODE" in
    bitstream) echo "  bitstream mode no longer supported (compressed passthrough not supported on this kernel); fragment not re-applied." ;;
    lpcm)      write_frag_lpcm "$dev" "$STATE_CHANNELS"; echo "  re-applied lpcm fragment." ;;
  esac
}

cmd_test() {
  h96_banner "A U D I O   P A S S T H R O U G H"
  local rc=0 dev; dev="$(resolve_device)"
  echo "1) mpv present:            $(have mpv && echo yes || { echo NO; rc=1; })"
  if have mpv; then
    if mpv --audio-spdif=help 2>&1 | grep -qiE 'ac3|dts' \
       || mpv --list-options 2>/dev/null | grep -q -- '--audio-spdif'; then
      echo "2) mpv --audio-spdif:      supported"
    else
      echo "2) mpv --audio-spdif:      UNKNOWN (option not advertised) "; rc=1
    fi
  fi
  echo "3) HDMI PCM detected:      ${dev:-NONE}"
  [ -z "$dev" ] && rc=1
  # hw_params only: zero-sample open from /dev/null, nothing audible is sent.
  local ch lay layouts; layouts="stereo"
  [ -r "$SINK_JSON" ] && layouts="$(python3 -c 'import json,sys; print(" ".join(json.load(open(sys.argv[1]))["layouts"]))' "$SINK_JSON" 2>/dev/null)"
  echo "4) hw_params (silent, $HDMI_HW):"
  for lay in ${layouts:-stereo}; do
    case "$lay" in 7.1) ch=8 ;; 5.1) ch=6 ;; *) ch=2 ;; esac
    if aplay -q -D "$HDMI_HW" -t raw -f S16_LE -r 48000 -c "$ch" /dev/null 2>"/tmp/h96-apt.$$"; then
      echo "   $lay (${ch}ch): accepted"
    elif grep -qi busy "/tmp/h96-apt.$$"; then
      echo "   $lay (${ch}ch): device busy (PipeWire HDMI sink playing), not tested"
    else
      echo "   $lay (${ch}ch): REFUSED ($(head -n1 "/tmp/h96-apt.$$"))"; rc=1
    fi
  done
  rm -f "/tmp/h96-apt.$$"
  local rd sinks=""
  for rd in /run/user/[0-9]*; do
    [ -S "$rd/pipewire-0" ] || continue
    sinks="$sinks $(hdmi_sink_of "${rd##*/}")"
  done
  sinks="$(echo $sinks)"
  echo "5) PipeWire HDMI node:     ${sinks:-not listed (no desktop session with PipeWire)}"
  echo
  if [ "$rc" -eq 0 ]; then echo "PASS (baseline). Real confirmation is on the receiver -- box-test."
  else echo "Some checks failed; see above. Feature may be partially/unsupported here."; fi
  return "$rc"
}

# ------------------------------------------------------------- selftest
# Offline unit test of apply_kernel_edid's stage/verify/promote/revert logic: a
# sandboxed fake DRM_CONN/DRM_PARAM/DRM_OVERRIDE + forced/sink EDID pair, run via the
# H96_DRM_*/H96_FORCED_EDID/H96_SINK_EDID* overrides. No hardware, no real kernel.
cmd_selftest() {
  local self sb pass=1 rc libdir sony_edid forced_edid
  self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  sb="$(mktemp -d /tmp/h96-apt-selftest.XXXXXX)" || { err "selftest: mktemp -d failed"; return 1; }

  st_check() { if eval "$2"; then echo "PASS $1"; else echo "FAIL $1"; pass=0; fi; }
  st_stray() { ls "$sb"/fw/edid/sink.bin.?????? >/dev/null 2>&1; }
  st_reset() {
    rm -rf "$sb/conn" "$sb/fw"; mkdir -p "$sb/conn" "$sb/fw/edid"
    printf 'connected\n' > "$sb/conn/status"
    printf 'FORCED-EDID-STEREO-SEED' > "$sb/fw/edid/forced.bin"
    : > "$sb/edid_firmware"; : > "$sb/edid_override"
  }
  st_run() {
    H96_SOURCE_ONLY=1 H96_DRM_CONN="$sb/conn" H96_DRM_PARAM="$sb/edid_firmware" \
      H96_DRM_OVERRIDE="$sb/edid_override" H96_CEC_PHYS_PARAM="$sb/no-cec" \
      H96_FORCED_EDID="$sb/fw/edid/forced.bin" H96_SINK_EDID="$sb/fw/edid/sink.bin" \
      H96_SINK_EDID_REL="edid/sink.bin" \
      bash -c '. "$0"; apply_kernel_edid "" "$1"' "$self" "$1" >/dev/null 2>"$sb/stderr"
  }

  # A: candidate == installed SINK_EDID, live already matches -> current (rc 2)
  st_reset
  printf 'SINK-A' > "$sb/fw/edid/sink.bin"
  printf 'SINK-A' > "$sb/conn/edid"
  printf '1920x1080@60\n' > "$sb/conn/modes"
  printf 'HDMI-A-1:edid/sink.bin' > "$sb/edid_firmware"
  printf 'SINK-A' > "$sb/candidate.bin"
  st_run "$sb/candidate.bin"; rc=$?
  st_check "unchanged candidate: current (rc 2)" '[ "$rc" -eq 2 ]'
  st_check "unchanged candidate: no stray temp file" '! st_stray'

  # B: new candidate, fake kernel accepts it -> promoted (rc 0)
  st_reset
  printf 'SINK-OLD-B' > "$sb/fw/edid/sink.bin"
  printf 'SINK-NEW-B' > "$sb/conn/edid"
  printf '1920x1080@60\n' > "$sb/conn/modes"
  printf 'SINK-NEW-B' > "$sb/candidate.bin"
  st_run "$sb/candidate.bin"; rc=$?
  st_check "accepted candidate: reloaded (rc 0)" '[ "$rc" -eq 0 ]'
  st_check "accepted candidate: promoted onto SINK_EDID" '[ "$(cat "$sb/fw/edid/sink.bin")" = "SINK-NEW-B" ]'
  st_check "accepted candidate: no stray temp file" '! st_stray'

  # C: new candidate, fake kernel rejects it (edid stays old) -> SINK_EDID untouched (rc 1)
  st_reset
  printf 'SINK-GOOD-C' > "$sb/fw/edid/sink.bin"
  printf 'SINK-GOOD-C' > "$sb/conn/edid"
  printf '1920x1080@60\n' > "$sb/conn/modes"
  printf 'SINK-REJECTED-C' > "$sb/candidate.bin"
  st_run "$sb/candidate.bin"; rc=$?
  st_check "rejected candidate: failed (rc 1)" '[ "$rc" -eq 1 ]'
  st_check "rejected candidate: SINK_EDID never touched" '[ "$(cat "$sb/fw/edid/sink.bin")" = "SINK-GOOD-C" ]'
  st_check "rejected candidate: no stray temp file" '! st_stray'

  # D: SINK_EDID never installed + rejection -> seeded from forced EDID, not the candidate
  st_reset
  printf 'SINK-STALE-D' > "$sb/conn/edid"
  printf '1920x1080@60\n' > "$sb/conn/modes"
  printf 'SINK-REJECTED-D' > "$sb/candidate.bin"
  st_run "$sb/candidate.bin"; rc=$?
  st_check "never installed + rejected: failed (rc 1)" '[ "$rc" -eq 1 ]'
  st_check "never installed + rejected: seeded from forced EDID" \
    '[ "$(cat "$sb/fw/edid/sink.bin")" = "FORCED-EDID-STEREO-SEED" ]'

  # E: 51-h96-iec958.conf stays PCM-only for an AC3-capable sink (compressed
  # passthrough not supported on this kernel, whatever the EDID lists).
  local libdir sony_edid forced_edid
  libdir="$(dirname "$(readlink -f "$EDID_LIB" 2>/dev/null || echo "$EDID_LIB")")"
  sony_edid="$sb/sony.bin"; forced_edid="$sb/forced.bin"
  if PYTHONPATH="$libdir" python3 -c '
import sys, edid_merge as em
open(sys.argv[1], "wb").write(em.sample_sony())
open(sys.argv[2], "wb").write(em.sample_forced())
' "$sony_edid" "$forced_edid" 2>"$sb/stderr" \
     && python3 "$EDID_LIB" plan --forced "$forced_edid" --edid "$sony_edid" --outdir "$sb" \
          >/dev/null 2>>"$sb/stderr"; then
    if [ "$(grep -c 'iec958.codecs = \[' "$sb/51-h96-iec958.conf")" -eq 1 ] \
       && grep -qF 'iec958.codecs = [ "PCM" ]' "$sb/51-h96-iec958.conf"; then
      echo "PASS 51-h96-iec958.conf: PCM-only for AC3-capable sink"
    else
      echo "FAIL 51-h96-iec958.conf: PCM-only for AC3-capable sink"; pass=0
    fi
  else
    echo "FAIL 51-h96-iec958.conf: could not run edid_audio.py plan (see $sb/stderr)"; pass=0
  fi

  rm -rf "$sb"
  [ "$pass" -eq 1 ]
}

usage() {
  cat <<EOF
h96-audio-passthrough -- multichannel LPCM to an AV receiver over HDMI

  status              (default) show detected device, mode, mpv + PW state
  devices             list ALSA HDMI/IEC958 PCMs and PipeWire HDMI sinks
  bitstream [DEV]     refuses: compressed passthrough not supported yet
                      (dw-hdmi-qp sends it as PCM noise on this kernel)
  lpcm [DEV] [CH]     enable multichannel LPCM (CH = stereo|5.1|7.1, default detected)
  off                 disable passthrough, revert mpv to base config
  set-device DEV      persist the HDMI ALSA device (see 'devices')
  codecs on|off       no effect: IEC958 codecs stay PCM-only on this kernel
  test                silent probe: mpv spdif, hw_params per layout, PW node
  detect [OPTS]       = h96-display detect: read display / receiver EDID, load its
                      modes + audio into kernel EDID, apply layouts + codecs
                      (--edid FILE, --dry-run, --no-restart; 'detect --help')
  selftest            offline unit test of the kernel-EDID stage/verify/promote
                      logic (sandboxed, no hardware, nothing changed on the box)

DEV example:  hdmi:CARD=rockchiphdmi0,DEV=0
Layouts appear in KDE: tray speaker menu > Profile, System Settings > Sound.
EOF
}

main() {
  local cmd="${1:-status}"; shift || true
  case "$cmd" in
    status|"")     cmd_status ;;
    devices|list)  cmd_devices ;;
    bitstream|bs)  enable_bitstream "$@" ;;
    lpcm|pcm)      enable_lpcm "$@" ;;
    off|disable)   cmd_off "$@" ;;
    set-device)    cmd_set_device "$@" ;;
    codecs)        case "${1:-}" in
                     on)  codecs_on ;;
                     off) codecs_off ;;
                     *)   err "usage: codecs on|off"; exit 1 ;;
                   esac ;;
    test)          cmd_test ;;
    selftest)      cmd_selftest ;;
    detect)        cmd_detect "$@" ;;
    display)       cmd_display "$@" ;;
    -h|--help|help) usage ;;
    *)             err "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

[ "${H96_SOURCE_ONLY:-0}" = 1 ] || main "$@"
