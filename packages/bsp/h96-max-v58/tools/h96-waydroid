SPOOF_STATE  = "/var/lib/waydroid/h96-spoof"          # JSON: spoofed device + the pre-spoof props
GPU_DISPLAY  = "1280x720"                             # Panthor render size (fills window, GPU-friendly)
NFT_OVERRIDE = "/etc/systemd/system/waydroid-container.service.d/10-h96-nonft.conf"
CG_OVERRIDE  = "/etc/systemd/system/waydroid-container.service.d/20-h96-cgroup.conf"
REPO_KEY     = "/usr/share/keyrings/waydroid.gpg"
REPO_LIST    = "/etc/apt/sources.list.d/waydroid.list"

# cgroup v1 tmpfs shims the Android 11 (Panthor) image expects but a cgroup-v2 host
# does not provide. Without them zygote crash-loops ('/acct' read-only, no /dev/stune).
CGV1_SHIMS = [
    "lxc.mount.entry = tmpfs acct tmpfs nosuid,nodev,mode=0755,create=dir 0 0",
    "lxc.mount.entry = tmpfs dev/stune tmpfs nosuid,nodev,mode=0755,create=dir 0 0",
    "lxc.mount.entry = tmpfs dev/cpuset tmpfs nosuid,nodev,mode=0755,create=dir 0 0",
    "lxc.mount.entry = tmpfs dev/memcg tmpfs nosuid,nodev,mode=0755,create=dir 0 0",
]

# REJECTED, DO NOT RE-ADD: shadowing the container's /dev/kmsg with /dev/null.
# Android's KernelLogger writes into the container's /dev/kmsg, which on a shared-kernel
# container is the HOST ring buffer: measured at about 770 journal lines per minute and 84%
# of the whole journal, overwriting the host's own boot dmesg. Binding /dev/null over
# dev/kmsg in config_nodes DOES mount cleanly ("Mounted /dev/null on .../dev/kmsg"), but the
# container then never comes up: lxc State stays STOPPED and Android never reaches
# "Android with user 0 is ready". Verified by isolation on this box - removing that single
# line brought the container straight back to RUNNING. Android init requires a writable,
# real kmsg. Quiet the journal with journald limits instead, not by removing kmsg.

