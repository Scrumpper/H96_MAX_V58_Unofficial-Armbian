# --------------------------------------------------------------- remove -------
def remove():
    info("stopping and purging Waydroid...")
    run(["waydroid", "session", "stop"], check=False)
    run(["systemctl", "disable", "--now", "waydroid-container"], check=False)
    if waydroid_installed():
        run(["apt-get", "purge", "-y", "waydroid"], check=False)
    for p in (LAUNCHER, DESKTOP, NFT_OVERRIDE, CG_OVERRIDE, REPO_LIST, REPO_KEY):
        _rm(p)
    shutil.rmtree("/var/lib/waydroid", ignore_errors=True)
    shutil.rmtree("/etc/systemd/system/waydroid-container.service.d", ignore_errors=True)
    run(["systemctl", "daemon-reload"], check=False)
    ok("Waydroid removed. (weston + the /etc/waydroid-extra images are left in place.)")

# ------------------------------------------------------------ prop I/O --------
def _read_props():
    d = {}
    if os.path.exists(BASE_PROP):
        for ln in open(BASE_PROP):
            ln = ln.strip()
            if ln and not ln.startswith("#") and "=" in ln:
                k, v = ln.split("=", 1); d[k.strip()] = v.strip()
    return d

def _save_props(d):
    os.makedirs(os.path.dirname(BASE_PROP), exist_ok=True)
    with open(BASE_PROP, "w") as f:
        for k, v in d.items(): f.write(f"{k}={v}\n")

def _prop_set(kv):
    d = _read_props(); d.update(kv); _save_props(d)
def _prop_del(keys):
    d = _read_props()
    for k in keys: d.pop(k, None)
    _save_props(d)

def _write(path, content, mode):
    with open(path, "w") as f: f.write(content)
    os.chmod(path, mode)
def _rm(path):
    try: os.unlink(path)
    except FileNotFoundError: pass

# ------------------------------------------------------- guided setup ---------
def _hr(): print(c("  " + "─" * 60, DIM))

def ask_yn(q, default=True):
    d = "Y/n" if default else "y/N"
    try:
        a = input(c(f"  {q} [{d}]: ", MAGENTA)).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(); return False
    return default if not a else a in ("y", "yes")

def _dispatch(*a):
    """Re-invoke this tool as a subprocess so each step self-elevates + self-banners."""
    return run(["sudo", sys.executable, os.path.abspath(__file__), *a]).returncode

def setup(user):
    """Themed walk-through: readiness -> install -> pick an image -> launch."""
    print(c("  Guided setup", CYAN) + c("   Android in a window on your H96 desktop", DIM))
    _hr()

    if not psi_ok():
        warn("kernel PSI is missing (/proc/pressure absent).")
        warn("Android cannot boot on this kernel. Flash the v4.3 kernel (CONFIG_PSI=y) first,")
        warn("then run h96-waydroid again. Stopping here.")
        return
    b_ok, _ = binder_state()
    if not b_ok:
        warn("binder not available yet (waydroid-container mounts it on start) - continuing.")

    # ---- Step 1: install ----
    if not waydroid_installed() or not have("weston"):
        print(c("  Step 1 . Install", CYAN),
              c("Waydroid + Weston + the RK3588 cgroup/nft boot fixes", DIM))
        if not ask_yn("Install now? (apt, needs sudo)"):
            info("nothing installed - re-run h96-waydroid when ready."); return
        _dispatch("install")
        if not waydroid_installed():
            die("install did not complete - see the messages above.")
    else:
        ok("  Step 1 . Waydroid + Weston already installed.")
    _hr()

    # ---- Step 2: choose an image ----
    print(c("  Step 2 . Choose an Android image", CYAN))
    have_img = gpu_image_present()
    cur = "Android " + out(["waydroid", "shell", "getprop", "ro.build.version.release"]) \
          if session_running() else ("already initialised" if image_ready() else "")
    print()
    print("   " + c("1) ", MAGENTA) + c("Hardware GPU", "92") +
          "  Panthor image, Android 11, real Mali-G610 (smoothest).")
    print("      " + c((f"image files FOUND in {GPU_STASH}"
                        if have_img else
                        "image files NOT found - you will be shown where to drop them (~5 GB)"),
                       "92" if have_img else "93"))
    print()
    print("   " + c("2) ", MAGENTA) + "Latest LineageOS + Google apps  Android 13, "
          "Play-ready, software render (laggier, ~1 GB download).")
    print()
    print("   " + c("3) ", MAGENTA) + "Latest LineageOS vanilla  Android 13, no Google, "
          "software render.")
    if _has_imgs(LOS_STASH):
        print("      " + c("a LineageOS image is already stashed - no download needed", "92"))
    print()
    print("   " + c("4) ", MAGENTA) + "My own image  point me at a folder holding "
          "system.img + vendor.img.")
    print("      " + c("must be an arm64 Waydroid-style PAIR - a ROM zip or GSI will not boot", DIM))
    if image_ready():
        print()
        print("   " + c("s) ", MAGENTA) + "Keep the current image" +
              (f" ({cur})" if cur else "") + " and skip to launch.")
    print()
    try:
        sel = input(c("  Which image? [1/2/3/4" + ("/s" if image_ready() else "") + "]: ",
                      MAGENTA)).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(); return
    cmd = {"1": ("init", "gpu"), "2": ("init", "gapps"), "3": ("init", "vanilla")}.get(sel)
    if sel == "4":
        try:
            d = input(c("  Folder holding system.img + vendor.img: ", MAGENTA)).strip()
        except (EOFError, KeyboardInterrupt):
            print(); return
        if not d:
            warn("no folder given - stopping."); return
        cmd = ("init", "custom", d)
    if sel in ("s", "skip") and image_ready():
        cmd = None
    elif not cmd:
        warn("no valid choice - stopping."); return
    if cmd:
        _hr()
        rc = _dispatch(*cmd)
        # `init gpu` with no image files exits non-zero after printing guidance - stop cleanly
        if rc != 0 or not image_ready():
            warn("image not ready yet - follow the guidance above, then re-run h96-waydroid.")
            return
    _hr()

    # ---- Step 3: window size ----
    print(c("  Step 3 . Window size", CYAN))
    wh = choose_size(current_size() or GPU_DISPLAY, user)
    _dispatch("size", wh)
    _hr()

    # ---- Step 4: launch ----
    print(c("  Step 4 . Launch", CYAN))
    if ask_yn("Start Android now?"):
        os.execvp(sys.executable, [sys.executable, os.path.abspath(__file__), "start"])
    ok("  Ready. Launch any time:  h96-waydroid start   "
       "(or the 'Android (Waydroid)' menu icon)")

# ---------------------------------------------------------------- main --------
def main():
    args = sys.argv[1:]
    ROOT_CMDS = ("install", "init", "hw", "size", "state", "spoof", "stop", "remove",
                 "_writelauncher")
    if args and args[0] in ROOT_CMDS:
        elevate()
    user = desktop_user()
    if not (args and args[0] in ("-h", "--help", "help", "_writelauncher")):
        banner()

    if not args:
        setup(user); return
    cmd = args[0]
    if cmd == "status":
        status(user)
    elif cmd == "install":
        install()
    elif cmd == "init":
        prof = args[1].lower() if len(args) > 1 else ("gpu" if gpu_image_present() else "vanilla")
        do_init(prof, args[2] if len(args) > 2 else None)
    elif cmd == "start":
        start()
    elif cmd == "stop":
        stop()
    elif cmd == "hw":
        hw(args[1].lower() if len(args) > 1 else "on")
    elif cmd == "size":
        do_size(args[1].lower() if len(args) > 1 else None)
    elif cmd in ("state", "snapshot"):
        do_state(args[1:])
    elif cmd == "spoof":
        do_spoof(args[1] if len(args) > 1 else None)
    elif cmd == "remove":
        remove()
    elif cmd == "_writelauncher":     # internal: called via sudo on first start
        write_launcher()
    elif cmd in ("-h", "--help", "help"):
        print(USAGE)
    else:
        die(f"unknown command '{cmd}' "
            "(status | install | init | size | state | spoof | start | stop | hw | remove)")

if __name__ == "__main__":
    main()
