SNAP_DIR     = "/var/lib/waydroid-snapshots"          # saved Android /data states (can be GB)
WCFG         = "/var/lib/waydroid/waydroid.cfg"       # waydroid runtime config
IMAGES_DIR   = "/var/lib/waydroid/images"             # system.img / vendor.img (symlinks for gpu)
EXTRA_IMAGES = "/etc/waydroid-extra/images"           # preinstalled-images dir waydroid auto-detects
GPU_STASH    = "/etc/waydroid-extra/gpu-images"       # Panthor hardware images (user-supplied)
LOS_STASH    = "/etc/waydroid-extra/los-images"       # official LineageOS download, kept for reuse
CUSTOM_STASH = "/etc/waydroid-extra/custom-images"    # an image the user brought themselves
