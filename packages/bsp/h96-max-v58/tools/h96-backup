# A manifest for a game whose steamapps/common/<installdir> content is not
# archived (excluded by `skip` above, or simply absent) is dropped: restore
# would otherwise write an appmanifest for a game that is not actually there.
APPMANIFEST_RE = re.compile(r"appmanifest_\d+\.acf$")

def acf_installdir(path):
    """installdir value out of a Steam .acf manifest file on disk, or None."""
    try:
        text = open(path, errors="replace").read()
    except OSError:
        return None
    m = re.search(r'"installdir"\s*"([^"]*)"', text)
    return m.group(1) if m else None

def common_dir_captured(steam_home, rel_root, installdir, skip):
    """True if steamapps/common/<installdir> would land in this archive: not
    excluded by `skip` and actually present with content on disk."""
    rel_common = os.path.normpath(os.path.join(rel_root, "common", installdir))
    if any(rel_common == ex or rel_common.startswith(ex + os.sep) for ex in skip):
        return False
    full = os.path.join(steam_home, rel_common)
    return os.path.isdir(full) and bool(os.listdir(full))

