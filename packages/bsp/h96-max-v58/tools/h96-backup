#!/usr/bin/env python3
# =============================================================================
# h96-backup - capture an H96 Max V58 (RK3588 Armbian) setup into one archive.
#
# Reflashing this box wipes the whole eMMC: the console base is restored, but
# every on-demand feature installed on top (desktop, emulators, Waydroid,
# Widevine, gaming stack, NPU runtime) and every user config/save is lost.
# h96-backup records WHICH features were present (a manifest) and bundles the
# passive data that cannot be re-downloaded (configs, WiFi creds, Waydroid
# /data, emulator saves, wine prefix). h96-restore replays it after a reflash.
#
#   h96-backup                 write an archive under the desktop user's home
#   h96-backup <dest>          write to <dest> (a dir, or an explicit path)
#   h96-backup --with-images   also bundle the Waydroid image stashes (multi-GB;
#                              default OFF - restore re-downloads them instead)
#   h96-backup --with-vm-disks also bundle h96-vm disk images (can be multi-GB;
#                              default OFF - only VM definitions are captured)
#   h96-backup --with-proton-prefixes  also bundle Steam ARM Proton prefixes
#                              (can be multi-GB; default OFF)
#   h96-backup --with-steam-runtime  also bundle the Steam client program itself
#                              (can be multi-GB; default OFF - it re-downloads)
#   h96-backup --only a,b      capture only these categories
#   h96-backup --skip a,b      capture everything except these categories
#   h96-backup --emulators x,y limit the emulator list (names as in h96-emulators)
#   h96-backup --probe-json    print what is on this box as JSON and exit (no root)
#
# Categories: desktop configs emulators waydroid waydroid-images widevine gaming
# npu wifi autologin system vm. h96-backup-gui is the graphical front end.
#
# The archive is tar + zstd when zstd is present (.tar.zst), else gzip
# (.tar.gz). Auto-elevates via sudo (reads root-only WiFi confs + system state).
# No feature is required: anything absent is skipped cleanly. Reads a backup
# taken on v5.0.1 or later; restore is the tool that adapts it to this image.
# =============================================================================
import os, sys, io, json, pwd, re, time, shutil, subprocess, tarfile, datetime, glob

SCHEMA = 2
TOOL_VERSION = "2.1"   # h96-backup/h96-restore/h96-backup-gui release version

HELP = f"""h96-backup v{TOOL_VERSION} - capture an H96 Max V58 setup into one archive.

  h96-backup                 write an archive under the desktop user's home
  h96-backup <dir>           write into <dir>
  h96-backup <path>          write to an explicit path (extension appended)
  h96-backup --with-images   also bundle the Waydroid image stashes (multi-GB;
                             default OFF - restore re-downloads them otherwise)
  h96-backup --with-vm-disks also bundle h96-vm disk images (can be multi-GB;
                             default OFF - only VM definitions are captured)
  h96-backup --with-proton-prefixes  also bundle Steam ARM Proton prefixes
                             (can be multi-GB; default OFF)
  h96-backup --with-steam-runtime  also bundle the Steam client program itself
                             (can be multi-GB; default OFF - it re-downloads)
  h96-backup --only a,b      capture only these categories
  h96-backup --skip a,b      capture everything except these categories
  h96-backup --emulators x,y limit the emulator list (names as in h96-emulators)
  h96-backup --probe-json    print what is on this box as JSON and exit (no root)

Categories: desktop configs emulators waydroid waydroid-images widevine gaming
npu wifi autologin system vm (waydroid-images is the same as --with-images).

Records a manifest of which features are present (desktop, emulators, Waydroid,
Widevine, gaming, NPU runtime, opt-in services, VMs) and bundles the passive
data that cannot be re-downloaded (configs, WiFi confs, Waydroid /data,
emulator saves, wine prefix, Steam ARM home, VM definitions). tar + zstd when
available (.tar.zst), else gzip (.tar.gz). Auto-elevates via sudo. Replay with
h96-restore, which supports a backup made on v5.0.1 or any later release.
h96-backup-gui is the graphical front end.
"""

CATEGORIES = ("desktop", "configs", "emulators", "waydroid", "waydroid-images",
              "widevine", "gaming", "npu", "wifi", "autologin", "system", "vm")

def parse_categories(spec, flag):
    out = []
    for c in spec.split(","):
        c = c.strip()
        if not c: continue
        if c not in CATEGORIES:
            die(f"{flag}: unknown category '{c}' (choose from {', '.join(CATEGORIES)})")
        out.append(c)
    return out

