CEMU_API      = "https://api.github.com/repos/cemu-project/Cemu/releases/latest"
PANVK_ICD     = "/usr/share/vulkan/icd.d/panfrost_icd.json"

# name -> (system, kind, flatpak_id_or_None, recommended GPU backend)
CATALOG = {
