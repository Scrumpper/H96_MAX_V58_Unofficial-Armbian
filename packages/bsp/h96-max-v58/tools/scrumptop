def _init_state():
    """Initialize app state: history deques + bench status."""
    return {
        "history": {
            "cpu_overall": deque(maxlen=60),
            "mem": deque(maxlen=60),
            "gpu": deque(maxlen=60),
            "temp_soc": deque(maxlen=60),
        },
        "bench_running": False,
        "bench_thread": None,
        "bench_proc": None,    # Popen handle so 'b' can cancel a running bench
        "bench_stopped": False,
        "bench_result": None,  # (gops_str, tops_str) | "SETUP" | "STOPPED" | None
        "paused": False,
        "show_help": True,
        "interval": 1.0,  # polling rate in seconds; +/- steps through presets
    }


_POLL_STEPS = (0.25, 0.5, 1.0, 2.0, 3.0, 5.0, 10.0)


def _step_interval(cur, faster):
    """Snap to the nearest polling preset, then step one faster or slower."""
    idx = min(range(len(_POLL_STEPS)), key=lambda i: abs(_POLL_STEPS[i] - cur))
    idx += -1 if faster else 1
    return _POLL_STEPS[max(0, min(len(_POLL_STEPS) - 1, idx))]


def _update_history(state, snap):
    """Append current snapshot values to history deques (unless paused)."""
    if state["paused"]:
        return
    state["history"]["cpu_overall"].append(snap["cpu"]["overall"])
    state["history"]["mem"].append(snap["mem"]["used_pct"])
    state["history"]["gpu"].append(snap["gpu"]["pct"])
    state["history"]["temp_soc"].append(snap["temps"]["soc"])


def _run_npu_bench(state):
    """Run 'h96-npu bench all' (one job per core) in a background thread and
    populate state['bench_result']. Runs in its own session so 'b' can cancel
    the whole job tree -- the wrapper backgrounds three npuload children."""
    try:
        proc = subprocess.Popen(
            ["h96-npu", "bench", "all"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,   # own process group -> killpg reaches children
        )
        state["bench_proc"] = proc
        try:
            out, err = proc.communicate(timeout=120)
        except subprocess.TimeoutExpired:
            _kill_bench_group(proc)
            proc.communicate()
            if not state.get("bench_stopped"):
                state["bench_result"] = ("ERR", "ERR")
            return

        if state.get("bench_stopped"):
            return  # user cancelled; _stop_npu_bench already set the result

        output = (out or "") + (err or "")
        gops_str = "N/A"
        tops_str = "N/A"
        found = False
        # 'bench all' prints an AGGREGATE line last, so the final GOPS/TOPS match
        # is the whole-NPU total; per-core lines above it are overwritten.
        for line in output.split("\n"):
            m = re.search(r"([\d.]+)\s*GOPS", line, re.IGNORECASE)
            if m:
                gops_str = m.group(1)
                found = True
            m = re.search(r"([\d.]+)\s*TOPS", line, re.IGNORECASE)
            if m:
                tops_str = m.group(1)
                found = True

        if not found and re.search(r"not installed|h96-npu-setup", output, re.IGNORECASE):
            # runtime is fetch-on-demand and absent; tell the user how to enable it
            state["bench_result"] = "SETUP"
        else:
            state["bench_result"] = (gops_str, tops_str)
    except (OSError, subprocess.SubprocessError):
        state["bench_result"] = ("ERR", "ERR")
    finally:
        state["bench_proc"] = None
        state["bench_running"] = False


def _kill_bench_group(proc):
    """Terminate a bench subprocess and its backgrounded npuload children."""
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            proc.terminate()
        except (ProcessLookupError, OSError):
            pass


def _stop_npu_bench(state):
    """Cancel a running bench (second press of 'b')."""
    state["bench_stopped"] = True
    proc = state.get("bench_proc")
    if proc is not None and proc.poll() is None:
        _kill_bench_group(proc)
    state["bench_result"] = "STOPPED"
    state["bench_running"] = False


# ---- panel content builders ----

_TEMP_MINMAX = {}


def _temp_gauge(temp_c, cells=10, label=None):
    """Small temperature gauge: bar scaled 0-100°C, coloured by the temp ramp,
    followed by the reading. Used on every component's own panel so each item
    carries its temp as a gauge, not bare text. When a zone `label` is given,
    the session min/max for that zone is tracked and shown dim after the value
    (e.g. '56.0°C 48/61')."""
    # narrower glyph than the '▊' load bars so temp gauges read as a finer scale
    bar = hbar(min(100.0, max(0.0, temp_c)), cells, temp_rgb(temp_c), fill="▍")
    val = fg(f"{temp_c:4.1f}°C", temp_rgb(temp_c))
    if label and temp_c > 0.0:
        mn, mx = _TEMP_MINMAX.get(label, (temp_c, temp_c))
        if temp_c < mn:
            mn = temp_c
        if temp_c > mx:
            mx = temp_c
        _TEMP_MINMAX[label] = (mn, mx)
        return f"{bar} {val} {fg(f'{mn:.0f}/{mx:.0f}', DIM)}"
    return f"{bar} {val}"


def _render_cpu_panel(snap, width, state):
    overall_pct = snap["cpu"]["overall"]
    body_lines = []

    temps = snap.get("temps", {})

    def _core_zone(core_id):
        # bigcore0-thermal covers CPU1/2, bigcore1-thermal covers CPU3/4,
        # littlecore-thermal covers the A55s
        if core_id in (1, 2):
            return "bigcore0"
        if core_id in (3, 4):
            return "bigcore1"
        return "littlecore"

    def _core_temp(core_id):
        return temps.get(_core_zone(core_id), 0.0)

    bar_width = max(4, width - 40)
    bar_str = hbar(overall_pct, bar_width, load_rgb(overall_pct))
    body_lines.append(
        f"  Overall: {bar_str} {overall_pct:5.1f}% {_temp_gauge(temps.get('soc', 0.0), 5, 'soc')}"
    )

    big_cores = [c for c in snap["cpu"]["cores"] if c["cls"] == "A76"]
    little_cores = [c for c in snap["cpu"]["cores"] if c["cls"] == "A55"]
    core_bar_width = max(4, width - 54)

    if big_cores:
        body_lines.append("")
        body_lines.append(f"  {fg('A76 Big Cores', PURPLE)}")
        for core in big_cores:
            bar_str = hbar(core["pct"], core_bar_width, load_rgb(core["pct"]))
            body_lines.append(
                f"    CPU{core['id']}: {bar_str} {core['pct']:5.1f}% @ {core['mhz']:4d}MHz"
                f" {_temp_gauge(_core_temp(core['id']), 5, _core_zone(core['id']))}"
            )

    if little_cores:
        body_lines.append("")
        body_lines.append(f"  {fg('A55 Little Cores', PURPLE)}")
        for core in little_cores:
            bar_str = hbar(core["pct"], core_bar_width, load_rgb(core["pct"]))
            body_lines.append(
                f"    CPU{core['id']}: {bar_str} {core['pct']:5.1f}% @ {core['mhz']:4d}MHz"
                f" {_temp_gauge(_core_temp(core['id']), 5, _core_zone(core['id']))}"
            )

    if state["history"]["cpu_overall"]:
        body_lines.append("")
        spark_str = sparkline(list(state["history"]["cpu_overall"]), max(4, width - 4))
        body_lines.append(f"  {spark_str}")

    return panel("CPU", body_lines, width, accent=PURPLE)


def _render_mem_panel(snap, width):
    total_kb = snap["mem"]["total_kb"]
    avail_kb = snap["mem"]["avail_kb"]
    used_pct = snap["mem"]["used_pct"]

    total_gb = total_kb / (1024 * 1024)
    avail_gb = avail_kb / (1024 * 1024)
    used_gb = total_gb - avail_gb

    bar_width = max(4, width - 12)
    bar_str = hbar(used_pct, bar_width, load_rgb(used_pct))

    body_lines = [
        f"  {bar_str} {used_pct:5.1f}%",
        f"  Used: {used_gb:6.2f} GB / {total_gb:6.2f} GB",
    ]
    return panel("Memory", body_lines, width, accent=PURPLE)


def _render_gpu_panel(snap, width):
    gpu_pct = snap["gpu"]["pct"]
    gpu_mhz = snap["gpu"]["mhz"]
    gpu_temp = snap["gpu"]["temp_c"]

    bar_width = max(4, width - 58)
    bar_str = hbar(gpu_pct, bar_width, load_rgb(gpu_pct))

    body_lines = [
        f"  {bar_str} {gpu_pct:5.1f}% @ {gpu_mhz:4d} MHz | {_temp_gauge(gpu_temp, 10, 'gpu')}"
    ]
    return panel("GPU", body_lines, width, accent=PURPLE)


def _render_npu_panel(snap, width, state):
    npu_cores = snap["npu"]["cores"]
    npu_mhz = snap["npu"]["mhz"]
    npu_temp = snap["npu"]["temp_c"]
    npu_runtime = snap["npu"]["runtime"]

    title = "NPU" + (" (runtime)" if npu_runtime else " (no runtime)")
    bar_width = max(4, width - 18)

    body_lines = []
    for i, pct in enumerate(npu_cores):
        bar_str = hbar(pct, bar_width, load_rgb(pct))
        body_lines.append(f"  Core{i}: {bar_str} {pct:5.1f}%")

    # bench result rides on the temp line, right of the NPU temp readout
    if state["bench_running"]:
        bench_suffix = f" | {fg('benching 3c (b=stop)', AMBER)}"
    elif state["bench_result"] == "SETUP":
        bench_suffix = f" | {fg('run h96-npu-setup', AMBER)}"
    elif state["bench_result"] == "STOPPED":
        bench_suffix = f" | {fg('bench stopped', AMBER)}"
    elif state["bench_result"]:
        gops, tops = state["bench_result"]
        bench_suffix = f" | {gops} GOPS/{tops} TOPS"
    else:
        bench_suffix = ""

    body_lines.append(
        f"  Freq: {npu_mhz:4d} MHz | {_temp_gauge(npu_temp, 10, 'npu')}{bench_suffix}"
    )

    return panel(title, body_lines, width, accent=PURPLE)


def _render_net_panel(snap, width):
    """Network panel: ETH state/speed/rates, WiFi state/signal/rates, BT, IR.

    Rates colour green when the link is up; link-down / blocked / absent is
    shown DIM (never RED — absence is not an alarm).
    """
    net = snap["net"]
    ir = snap["ir"]
    body_lines = []

    # ---- ETH ----
    eth = net["eth0"]
    eth_up = eth["state"] == "up"
    eth_dot = fg("●", GREEN if eth_up else DIM)
    eth_rx = _fmt_rate(eth["rx_bps"]) if eth_up else fg("       --", DIM)
    eth_tx = _fmt_rate(eth["tx_bps"]) if eth_up else fg("       --", DIM)
    if eth_up:
        speed_str = f"{eth['speed_mbps']:4d}Mbps"
    else:
        speed_str = fg(f"{eth['state']:>8s}", DIM)
    body_lines.append(f"  {eth_dot} Eth  {speed_str}  RX {eth_rx}  TX {eth_tx}")

    # ---- WIFI ----
    wlan = net["wlan0"]
    wlan_up = wlan["state"] == "up"
    wlan_dot = fg("●", GREEN if wlan_up else DIM)
    wlan_rx = _fmt_rate(wlan["rx_bps"]) if wlan_up else fg("       --", DIM)
    wlan_tx = _fmt_rate(wlan["tx_bps"]) if wlan_up else fg("       --", DIM)
    if wlan_up and wlan["signal_dbm"] is not None:
        dbm = wlan["signal_dbm"]
        sig_color = GREEN if dbm > -70 else AMBER
        sig_str = fg(f"{dbm:4d}dBm", sig_color)
    else:
        sig_str = fg(f"{wlan['state']:>8s}", DIM)
    body_lines.append(f"  {wlan_dot} WiFi {sig_str}  RX {wlan_rx}  TX {wlan_tx}")

    # ---- BLUETOOTH ----
    bt = net["bt"]
    if not bt["present"]:
        bt_dot = fg("●", DIM)
        bt_line = f"  {bt_dot} BT   {fg('absent', DIM)}"
    elif bt["blocked"]:
        bt_dot = fg("●", DIM)
        bt_line = f"  {bt_dot} BT   {fg('blocked', DIM)}"
    else:
        bt_dot = fg("●", GREEN)
        bt_line = f"  {bt_dot} BT   {fg('on', GREEN)}  {bt['connections']} device(s)"
    body_lines.append(bt_line)

    # ---- IR ----
    if not ir["present"]:
        ir_dot = fg("●", DIM)
        ir_line = f"  {ir_dot} IR   {fg('absent', DIM)}"
    else:
        ir_dot = fg("●", GREEN)
        if ir["last_age_s"] is None:
            ir_line = f"  {ir_dot} IR   {fg('no activity yet', DIM)}"
        else:
            age = ir["last_age_s"]
            ir_line = f"  {ir_dot} IR   last: {age:6.1f}s ago  code {ir['last_code']}"
    body_lines.append(ir_line)

    return panel("Network", body_lines, width, accent=PURPLE)


def _render_system_panel(snap, width):
    """System panel: disk bar, I/O rates, swap bar, load, uptime, batteries."""
    body_lines = []

    # ---- DISK ----
    disk_pct = snap["disk"]["used_pct"]
    disk_total_gb = snap["disk"]["total_gb"]
    disk_used_gb = disk_total_gb * (disk_pct / 100.0)
    bar_width = max(4, width - 36)
    disk_bar = hbar(disk_pct, bar_width, load_rgb(disk_pct))
    body_lines.append(
        f"  Disk: {disk_bar} {disk_pct:5.1f}%  {disk_used_gb:6.1f}/{disk_total_gb:6.1f}GB"
    )

    # ---- I/O RATES ----
    read_str = _fmt_rate(snap["io"]["read_bps"])
    write_str = _fmt_rate(snap["io"]["write_bps"])
    body_lines.append(f"  I/O:  Read {read_str}   Write {write_str}")

    # ---- SWAP ----
    swap_pct = snap["swap"]["used_pct"]
    swap_total_mb = snap["swap"]["total_mb"]
    if swap_total_mb > 0:
        swap_bar_width = max(4, width - 24)
        swap_bar = hbar(swap_pct, swap_bar_width, load_rgb(swap_pct))
        body_lines.append(f"  Swap: {swap_bar} {swap_pct:5.1f}%")
    else:
        body_lines.append(f"  Swap: {fg('none', DIM)}")

    # ---- LOAD / UPTIME ----
    load = snap["load"]
    uptime_s = snap["uptime_s"]
    d = int(uptime_s // 86400)
    h = int((uptime_s % 86400) // 3600)
    m = int((uptime_s % 3600) // 60)
    uptime_str = f"{d}d {h:02d}h {m:02d}m"
    body_lines.append(
        f"  Load: {load['avg1']:5.2f} {load['avg5']:5.2f} {load['avg15']:5.2f}"
        f"   Up: {uptime_str}"
    )

    # center-thermal (package interior) -- the only zone not shown on a
    # component bar elsewhere
    center_t = snap.get("temps", {}).get("center", 0.0)
    if center_t:
        body_lines.append(f"  Pkg temp: {_temp_gauge(center_t, 5, 'center')}")

    # ---- PERIPHERAL BATTERIES ----
    _LEVEL_RGB = {"full": GREEN, "high": GREEN, "normal": GREEN,
                  "low": AMBER, "critical": RED}
    for b in snap["batteries"]:
        model = b["model_name"]
        if "capacity_pct" in b:
            pct = b["capacity_pct"]
            body_lines.append(f"  {model}: {fg(f'{pct:3d}%', load_rgb(100 - pct))}")
        else:
            lvl = b.get("level", "unknown")
            body_lines.append(f"  {model}: {fg(lvl.lower(), _LEVEL_RGB.get(lvl.lower(), DIM))}")

    return panel("System", body_lines, width, accent=PURPLE)


def _render_footer(state, cols):
    poll = f"poll {state.get('interval', 1.0):g}s"
    if state["show_help"]:
        text = f"q: quit | p: pause | b: bench/stop | +/-: {poll} | h: toggle help"
        if state["paused"]:
            text += "  [PAUSED]"
    else:
        text = f"[PAUSED]  {poll}" if state["paused"] else poll

    text = _pad_visible(text, cols)
    return fg(text, DIM)


_chrome_cache = {}


def _gradient_rule(width):
    """Separator rule between the banner and the panels, in the frame colour.
    Cached per width."""
    key = ("rule", width)
    v = _chrome_cache.get(key)
    if v is None:
        v = fg("━" * width, PURPLE)
        _chrome_cache[key] = v
    return v


def _frame_top(width, tag):
    """Outer frame top border with the wordmark badged in the centre:
    ╭──┤ tag ├──╮ sized to exactly `width` visible columns."""
    inner = width - 2
    label = f"┤ {tag} ├"
    lab_w = _visible_len(label) if "_visible_len" in globals() else len(tag) + 4
    left = max(1, (inner - lab_w) // 2)
    right = max(1, inner - lab_w - left)
    key = ("top", width, tag)
    v = _chrome_cache.get(key)
    if v is None:
        v = (fg("╭" + "─" * left, PURPLE) + fg("┤ ", PURPLE)
             + fg(tag, GREEN) + fg(" ├", PURPLE)
             + fg("─" * right + "╮", PURPLE))
        _chrome_cache[key] = v
    return v


def _frame_bottom(width, tag):
    inner = width - 2
    label_w = len(tag) + 4
    left = max(1, (inner - label_w) // 2)
    right = max(1, inner - label_w - left)
    return (fg("╰" + "─" * left, PURPLE) + fg("┤ ", PURPLE)
            + fg(tag, DIM) + fg(" ├", PURPLE)
            + fg("─" * right + "╯", PURPLE))


def render_frame(snap, cols, rows, state):
    """Render one full frame: exactly `rows` lines, each visually `cols` wide.

    The whole terminal is wrapped in a purple outer frame: wordmark badged in
    the top border, key hints in the bottom border, side rails down both
    edges, and a palette-gradient rule between the banner and the panels.
    Panels are generated against the frame's interior (cols - 4) and every
    interior line is padded ANSI-aware before the rails are attached, so the
    exactly-rows-by-cols contract is unchanged.

    NET and SYSTEM panels are placed side-by-side when the interior >= 96,
    else stacked like the rest.
    """
    cols = max(24, cols)
    rows = max(5, rows)
    inner_w = cols - 2              # inside the side rails
    interior = max(4, inner_w - 2)  # panel interior (panel adds its own borders)

    blocks = []
    blocks.append(banner(inner_w))
    blocks.append([_gradient_rule(inner_w)])
    blocks.append(_render_cpu_panel(snap, interior, state))
    blocks.append(_render_gpu_panel(snap, interior))
    blocks.append(_render_mem_panel(snap, interior))
    blocks.append(_render_npu_panel(snap, interior, state))
    # no dedicated TEMPS panel: every zone now rides its component's own bar
    # (soc on Overall, bigcore0/1 + littlecore per-core, gpu/npu on theirs);
    # the one zone with no home, center-thermal, lives in the SYSTEM panel.

    if inner_w >= 96:
        half_interior = max(4, (inner_w - 2) // 2 - 2)
        net_lines = _render_net_panel(snap, half_interior)
        sys_lines = _render_system_panel(snap, half_interior)
        blocks.append(hpair(net_lines, sys_lines, inner_w))
    else:
        blocks.append(_render_net_panel(snap, interior))
        blocks.append(_render_system_panel(snap, interior))

    lines = []
    for block in blocks:
        lines.extend(block)

    # Frame top/bottom eat two rows; everything else fits between the rails.
    body_rows = rows - 2
    if len(lines) > body_rows:
        lines = lines[:body_rows]
    else:
        # fill bottom deadspace with the banner's sporadic purple texture
        # instead of blank rows, so the frame reads as one piece
        for r in range(body_rows - len(lines)):
            lines.append(_texture_row(inner_w, 101 + r))

    rail = fg("│", PURPLE)
    out = [_frame_top(cols, "S C R U M P P E R ' S")]
    for line in lines:
        out.append(rail + _pad_visible(line, inner_w) + rail)

    poll = f"poll {state.get('interval', 1.0):g}s"
    if state.get("show_help", True):
        hint = f"q quit · p pause · b bench/stop · +/- {poll} · h help"
    else:
        hint = f"{poll}" + ("  [PAUSED]" if state.get("paused") else "")
    if state.get("paused") and state.get("show_help", True):
        hint += "  [PAUSED]"
    # bottom border must fit the hint; fall back to a plain border when narrow
    if len(hint) + 6 <= cols:
        out.append(_frame_bottom(cols, hint))
    else:
        out.append(fg("╰" + "─" * (cols - 2) + "╯", PURPLE))

    if len(out) < rows:
        out.extend([" " * cols] * (rows - len(out)))
    out = out[:rows]
    return out


# ---- terminal handling ----

class RawMode:
    """Context manager for raw terminal mode; restores prior settings on exit."""

    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.old_settings = None

    def __enter__(self):
        try:
            self.old_settings = termios.tcgetattr(self.fd)
            tty.setraw(self.fd)
        except (termios.error, OSError):
            self.old_settings = None
        return self

    def __exit__(self, *args):
        if self.old_settings is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_settings)
            except (termios.error, OSError):
                pass
        return False


def _ansi_enter_alt_screen():
    sys.stdout.write("\x1b[?1049h")
    sys.stdout.flush()


def _ansi_exit_alt_screen():
    sys.stdout.write("\x1b[?1049l")
    sys.stdout.flush()


def _ansi_hide_cursor():
    sys.stdout.write("\x1b[?25l")
    sys.stdout.flush()


def _ansi_show_cursor():
    sys.stdout.write("\x1b[?25h")
    sys.stdout.flush()


def _ansi_clear_screen():
    sys.stdout.write("\x1b[2J\x1b[H")
    sys.stdout.flush()


def _ansi_home_cursor():
    """Move cursor to top-left without clearing (avoids full-screen flicker)."""
    sys.stdout.write("\x1b[H")
    sys.stdout.flush()


def _get_terminal_size():
    """(rows, cols); falls back to (24, 80) if not a real terminal."""
    try:
        size = os.get_terminal_size(sys.stdout.fileno())
        return (size.lines, size.columns)
    except (AttributeError, ValueError, OSError):
        return (24, 80)


def _read_key_nonblock():
    """Read one key without blocking; None if nothing available."""
    try:
        ready, _, _ = select.select([sys.stdin], [], [], 0)
        if ready:
            ch = sys.stdin.read(1)
            return ch if ch else None
        return None
    except (select.error, OSError, ValueError):
        return None


_resize_pending = False


def _sigwinch_handler(signum, frame):
    global _resize_pending
    _resize_pending = True


def _set_process_identity():
    """Show up as 'scrumptop', not 'python3', in ps/top and the terminal tab.

    /proc/self/comm is the stdlib-only equivalent of prctl(PR_SET_NAME); the
    OSC 0 escape names the terminal tab/window. Both best-effort.
    """
    try:
        with open("/proc/self/comm", "w") as f:
            f.write("scrumptop")
    except OSError:
        pass
    try:
        if sys.stdout.isatty():
            sys.stdout.write("\x1b]0;scrumptop\x07")
            sys.stdout.flush()
    except OSError:
        pass


def run():
    """Main entry point. Parses CLI args and either prints one snapshot frame
    or runs the interactive alternate-screen loop. Returns process exit code.
    """
    global _resize_pending
    _set_process_identity()
    parser = argparse.ArgumentParser(description="scrumptop: H96 Max V58 system monitor")
    parser.add_argument("--interval", type=float, default=1.0, help="Refresh interval in seconds")
    parser.add_argument("--snapshot", action="store_true", help="Print one frame and exit")
    parser.add_argument("--cols", type=int, default=None, help="Override terminal width")
    parser.add_argument("--rows", type=int, default=None, help="Override terminal height")
    args = parser.parse_args()

    if args.snapshot:
        prev_stat = None
        # Sample twice (net/disk counters included) so rate fields are
        # non-zero in a single-shot snapshot instead of always reading 0.
        _, prev_stat = read_all(prev_stat)
        time.sleep(0.15)
        snap, prev_stat = read_all(prev_stat)

        state = _init_state()
        _update_history(state, snap)

        rows, cols = _get_terminal_size()
        if args.cols:
            cols = args.cols
        if args.rows:
            rows = args.rows

        frame = render_frame(snap, cols, rows, state)
        sys.stdout.write("\n".join(frame) + "\n")
        sys.stdout.flush()
        return 0

    # Interactive mode.
    state = _init_state()
    state["interval"] = min(10.0, max(0.25, args.interval))
    prev_stat = None
    prev_frame = None
    last_refresh = 0.0
    running = True
    alt_screen_active = False

    def signal_handler(signum, frame):
        nonlocal running
        running = False

    try:
        _ansi_enter_alt_screen()
        alt_screen_active = True
        _ansi_hide_cursor()
        # Disable auto-wrap: every frame line is exactly terminal-width, and
        # without this, painting the bottom-right cell scrolls some terminals.
        sys.stdout.write("\x1b[?7l")
        _ansi_clear_screen()

        old_sigint = signal.signal(signal.SIGINT, signal_handler)
        old_sigterm = signal.signal(signal.SIGTERM, signal_handler)
        try:
            old_sigwinch = signal.signal(signal.SIGWINCH, _sigwinch_handler)
        except (ValueError, AttributeError):
            old_sigwinch = None

        with RawMode():
            rows, cols = _get_terminal_size()
            if args.cols:
                cols = args.cols
            if args.rows:
                rows = args.rows
            while running:
                # Event-driven wait: block in select() until a key is ready or
                # the next refresh is due, instead of a 10 ms busy-poll. Idle
                # wakeups drop from ~100/s to the refresh rate, and keypresses
                # are handled the instant they arrive. The 0.1 s cap keeps a
                # pending SIGWINCH resize flag responsive (the handler only sets
                # a flag, so select is not interrupted straight back to us).
                timeout = last_refresh + state["interval"] - time.time()
                timeout = max(0.0, min(0.1, timeout))
                try:
                    ready, _, _ = select.select([sys.stdin], [], [], timeout)
                except (InterruptedError, OSError):
                    ready = ()

                if ready:
                    key = _read_key_nonblock()
                    if key:
                        if key == "q" or key == "\x03":
                            running = False
                            break
                        elif key == "p":
                            state["paused"] = not state["paused"]
                        elif key == "h":
                            state["show_help"] = not state["show_help"]
                        elif key in ("+", "="):
                            state["interval"] = _step_interval(state["interval"], True)
                            last_refresh = 0.0   # repaint now so the footer shows it
                        elif key in ("-", "_"):
                            state["interval"] = _step_interval(state["interval"], False)
                            last_refresh = 0.0
                        elif key == "b":
                            if state["bench_running"]:
                                _stop_npu_bench(state)   # second press cancels
                            else:
                                state["bench_running"] = True
                                state["bench_stopped"] = False
                                state["bench_result"] = None
                                t = threading.Thread(
                                    target=_run_npu_bench, args=(state,), daemon=True
                                )
                                t.start()
                                state["bench_thread"] = t
                            last_refresh = 0.0   # reflect the bench state at once

                if _resize_pending:
                    _resize_pending = False
                    rows, cols = _get_terminal_size()   # re-read only on resize
                    if args.cols:
                        cols = args.cols
                    if args.rows:
                        rows = args.rows
                    _ansi_clear_screen()   # geometry changed: one real clear
                    prev_frame = None      # force a full repaint
                    last_refresh = 0.0     # and repaint immediately at the new size

                now = time.time()
                if now - last_refresh >= state["interval"]:
                    snap, prev_stat = read_all(prev_stat)
                    _update_history(state, snap)

                    frame = render_frame(snap, cols, rows, state)
                    # Line-diff rendering: only lines that CHANGED since the
                    # previous frame are rewritten (cursor-addressed), inside
                    # one DEC-2026 synchronized write. On an idle box most
                    # lines are identical, so per-tick output drops from the
                    # full ~20 KB frame to a few hundred bytes, which is less
                    # work for the terminal, the compositor, and the GPU.
                    # Geometry change = full repaint (prev no longer aligns).
                    if prev_frame is None or len(prev_frame) != len(frame):
                        sys.stdout.write(
                            "\x1b[?2026h\x1b[H" + "\r\n".join(frame) + "\x1b[?2026l"
                        )
                    else:
                        parts = []
                        for i, line in enumerate(frame):
                            if line != prev_frame[i]:
                                parts.append("\x1b[%d;1H%s" % (i + 1, line))
                        if parts:
                            sys.stdout.write(
                                "\x1b[?2026h" + "".join(parts) + "\x1b[?2026l"
                            )
                    sys.stdout.flush()
                    prev_frame = frame

                    last_refresh = now

        if old_sigwinch is not None:
            try:
                signal.signal(signal.SIGWINCH, old_sigwinch)
            except (ValueError, AttributeError):
                pass
        signal.signal(signal.SIGINT, old_sigint)
        signal.signal(signal.SIGTERM, old_sigterm)

        return 0

    except KeyboardInterrupt:
        return 0

    finally:
        # Always restore the terminal, even on an unhandled exception.
        sys.stdout.write("\x1b[?7h")   # re-enable auto-wrap
        _ansi_show_cursor()
        if alt_screen_active:
            _ansi_exit_alt_screen()
        try:
            if sys.stdout.isatty():
                sys.stdout.write("\x1b]0;\x07")   # hand the tab title back
        except OSError:
            pass
        sys.stdout.flush()


if __name__ == "__main__":
    sys.exit(run())
