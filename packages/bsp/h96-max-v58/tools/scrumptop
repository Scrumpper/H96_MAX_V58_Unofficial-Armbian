# MODULE: render (pure, no I/O)
# exposes: PURPLE, GREEN, AMBER, RED, FG, DIM, BG, fg, load_rgb, temp_rgb,
#          hbar, sparkline, panel, banner
# =====================================================================

PURPLE = (180, 92, 255)   # frames, titles, banner, labels
GREEN = (62, 245, 138)    # low load / cool
AMBER = (255, 207, 58)    # mid
RED = (255, 77, 94)       # high load / hot
# One shade darker variants, used ONLY for the bar/gauge level ramp so the
# meters sit back visually while status dots and accents keep the bright set.
GREEN_D = (48, 190, 108)
AMBER_D = (200, 162, 44)
RED_D = (200, 60, 74)
FG = (222, 222, 232)      # normal text
DIM = (110, 110, 128)     # chrome / empty bar cells
BG = (18, 16, 26)         # optional bg

_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


_FG_CACHE = {}


def fg(text, rgb):
    """Wrap text in ANSI truecolor foreground + reset. The escape prefix is
    cached per colour: fg() runs thousands of times per frame and the f-string
    formatting was measurable."""
    pre = _FG_CACHE.get(rgb)
    if pre is None:
        pre = "\x1b[38;2;%d;%d;%dm" % rgb
        _FG_CACHE[rgb] = pre
    return pre + text + "\x1b[0m"


def load_rgb(pct):
    """darker green<50, darker amber<80, darker red>=80 (bar-ramp shades)."""
    if pct < 50:
        return GREEN_D
    elif pct < 80:
        return AMBER_D
    else:
        return RED_D


def temp_rgb(c):
    """darker green<55, darker amber<75, darker red>=75 (bar-ramp shades)."""
    if c < 55:
        return GREEN_D
    elif c < 75:
        return AMBER_D
    else:
        return RED_D


def _visible_len(s):
    """Visible character count, ignoring ANSI truecolor escape sequences."""
    return len(_ANSI_RE.sub("", s))


def _pad_visible(s, target_width):
    """Pad/truncate a (possibly ANSI-coloured) string to an exact visible width."""
    cur = _visible_len(s)
    if cur < target_width:
        return s + " " * (target_width - cur)
    if cur > target_width:
        # Truncate on visible chars, stripping ANSI first (safe fallback —
        # callers avoid over-length strings, this just guards width contracts).
        stripped = _ANSI_RE.sub("", s)
        return stripped[:target_width]
    return s


def hbar(pct, width, rgb=None, seg=True, fill=None):
    """Bar of filled cells (coloured) + '░' empty (DIM). seg=True renders the
    filled cells as hairline-gapped '▊' segments; seg=False as solid '█'. Pass
    `fill` to override the glyph (e.g. a narrower '▍' for temp bars)."""
    if rgb is None:
        rgb = GREEN
    width = max(0, width)
    pct = max(0, min(100, pct))
    filled = int(round((pct / 100) * width))
    filled = max(0, min(width, filled))
    empty = width - filled

    # "▊" is a 7/8-width block (Block Elements range, universally covered by
    # monospace fonts): each filled cell leaves a hairline gap on its right, so
    # the bar reads as discrete segments instead of one solid slab.
    fill_ch = fill if fill else ("▊" if seg else "█")
    out = ""
    if filled:
        out += fg(fill_ch * filled, rgb)
    if empty:
        out += fg("░" * empty, DIM)
    return out


def sparkline(vals, width):
    """Unicode sparkline (▁▂▃▄▅▆▇█) from a list of 0..100 values, in FG colour."""
    SPARKS = "▁▂▃▄▅▆▇█"
    width = max(0, width)
    vals = list(vals)
    if len(vals) < width:
        vals = [0] * (width - len(vals)) + vals
    elif len(vals) > width:
        vals = vals[-width:]

    chars = []
    for v in vals:
        v = max(0, min(100, v))
        idx = int((v / 100) * (len(SPARKS) - 1))
        chars.append(SPARKS[idx])
    return fg("".join(chars), FG)


def panel(title, body_lines, width, accent=PURPLE):
    """Rounded box (╭╮╰╯─│), title in accent, body padded to an exact visible width.

    `width` is the visible interior width (not counting the two border columns),
    matching how callers size their content. Every returned line has visible
    width == width + 2.
    """
    width = max(0, width)
    result = []

    title_display = title if _visible_len(title) <= width else title[:max(0, width)]
    border_fill = max(0, width - _visible_len(title_display))

    top_line = (
        fg("╭", accent)
        + fg(title_display, accent)
        + fg("─" * border_fill, accent)
        + fg("╮", accent)
    )
    result.append(top_line)

    left_border = fg("│", accent)
    right_border = fg("│", accent)
    for line in body_lines:
        padded = _pad_visible(line, width)
        result.append(left_border + padded + right_border)

    bottom_line = fg("╰", accent) + fg("─" * width, accent) + fg("╯", accent)
    result.append(bottom_line)

    return result


def _fmt_rate(bps):
    """Format bytes/sec as a fixed-width 10-char right-aligned string.

    B/s -> KB/s -> MB/s, 1 decimal place, so columns never wobble between
    ticks.
    """
    if bps is None:
        bps = 0.0
    if bps >= 1024 * 1024:
        value = bps / (1024 * 1024)
        unit = "MB/s"
    elif bps >= 1024:
        value = bps / 1024
        unit = "KB/s"
    else:
        value = bps
        unit = "B/s"
    text = f"{value:.1f}{unit}"
    return text.rjust(10)


def hpair(left_lines, right_lines, width, gap=2):
    """Place two rendered panels side by side.

    Each half gets (width - gap) // 2 visible width. Returns list of lines
    padded to exact width, with the shorter panel bottom-padded to match height.
    """
    half_w = max(0, (width - gap) // 2)
    left_padded = [_pad_visible(line, half_w) for line in left_lines]
    right_padded = [_pad_visible(line, half_w) for line in right_lines]

    max_h = max(len(left_padded), len(right_padded))
    left_padded.extend([" " * half_w] * (max_h - len(left_padded)))
    right_padded.extend([" " * half_w] * (max_h - len(right_padded)))

    used_w = half_w * 2 + gap
    remainder = max(0, width - used_w)

    result = []
    for l, r in zip(left_padded, right_padded):
        result.append(l + " " * gap + r + " " * remainder)

    return result


# Layered header shades: deep purples for the banner texture.
P_EDGE = (108, 54, 156)
P_MID = (74, 38, 110)
P_DIM = (48, 26, 72)

_BANNER_ART = [
    "███████╗ ██████╗██████╗ ██╗   ██╗███╗   ███╗██████╗ ████████╗ ██████╗ ██████╗ ",
    "██╔════╝██╔════╝██╔══██╗██║   ██║████╗ ████║██╔══██╗╚══██╔══╝██╔═══██╗██╔══██╗",
    "███████╗██║     ██████╔╝██║   ██║██╔████╔██║██████╔╝   ██║   ██║   ██║██████╔╝",
    "╚════██║██║     ██╔══██╗██║   ██║██║╚██╔╝██║██╔═══╝    ██║   ██║   ██║██╔═══╝ ",
    "███████║╚██████╗██║  ██║╚██████╔╝██║ ╚═╝ ██║██║        ██║   ╚██████╔╝██║     ",
    "╚══════╝ ╚═════╝╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝╚═╝        ╚═╝    ╚═════╝ ╚═╝     ",
]


def _noise(x, seed):
    """Deterministic per-column pseudo-noise in [0,1): stable across frames so
    the sporadic texture does not flicker between redraws."""
    h = (x * 2654435761 + seed * 40503) & 0xFFFFFFFF
    h ^= h >> 13
    h = (h * 2246822519) & 0xFFFFFFFF
    return ((h >> 8) & 0xFF) / 255.0


def _noise_cell(x, width, seed):
    """One sporadic texture cell: dense dark speckle at the edges thinning
    into scattered dim dashes and gaps toward the centre."""
    half = max(1.0, (width - 1) / 2.0)
    e = min(x, width - 1 - x) / half
    d = 1.0 - e
    r = _noise(x, seed)
    if r < d * 0.55:
        return fg("▓", P_EDGE)
    if r < d * 0.55 + 0.22:
        return fg("▒", P_MID)
    if r < d * 0.55 + 0.40:
        return fg("░", P_DIM)
    if r < 0.72:
        return fg("╌", P_DIM)
    return " "


_banner_cache = {}
_texture_cache = {}


def _texture_row(width, seed):
    """One full-width row of the banner's sporadic purple texture. Cached per
    (width, seed) so filling bottom deadspace costs nothing after the first
    frame and never flickers between redraws."""
    key = (width, seed)
    cached = _texture_cache.get(key)
    if cached is not None:
        return cached
    row = "".join(_noise_cell(x, width, seed) for x in range(width))
    _texture_cache[key] = row
    return row


def banner(width):
    """Block-letter SCRUMPTOP in GREEN, set into a dark sporadic purple
    texture, with a hardware subtitle rule. Static per width, so it is
    rendered once and cached (it was one of the larger per-frame costs)."""
    cached = _banner_cache.get(width)
    if cached is not None:
        return cached
    if width < 40:
        rows = [fg("S C R U M P T O P".center(width), GREEN)]
        _banner_cache[width] = rows
        return rows
    art_w = max(len(r.rstrip()) for r in _BANNER_ART)
    pad = max(0, (width - art_w) // 2)
    rows = []
    for ri, art in enumerate(_BANNER_ART):
        art = art.rstrip()
        cells = []
        for x in range(width):
            ax = x - pad
            ch = art[ax] if 0 <= ax < len(art) else " "
            if ch != " ":
                cells.append(fg(ch, GREEN))
            else:
                cells.append(_noise_cell(x, width, ri + 1))
        rows.append("".join(cells))
    sub = "H96 MAX V58  ·  RK3588  ·  UNOFFICIAL ARMBIAN"
    side = max(1, (width - len(sub) - 4) // 2)
    rows.append(fg("╌" * side + "╢ ", P_DIM) + fg(sub, P_MID)
                + fg(" ╟" + "╌" * (width - len(sub) - 4 - side), P_DIM))
    _banner_cache[width] = rows
    return rows


