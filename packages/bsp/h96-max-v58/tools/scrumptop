#!/usr/bin/env python3
"""scrumptop - single-file stdlib-only terminal system monitor for the
H96 Max V58 (Rockchip RK3588) running Armbian. btop/htop-style raw-ANSI
truecolor UI. No external packages.
"""

import argparse
import os
import re
import select
import signal
import struct
import subprocess
import sys
import termios
import threading
import time
import tty
from collections import deque

# =====================================================================
# MODULE: sensors  (exposes: read_all, BIG_CORES, LITTLE_CORES)
# =====================================================================

# RK3588 CPU topology is NON-CONTIGUOUS: big A76 = cpu 1,2,3,4; little A55 = cpu 0,5,6,7.
BIG_CORES = {1, 2, 3, 4}
LITTLE_CORES = {0, 5, 6, 7}

_EXPECTED_ZONES = {
    "soc-thermal",
    "bigcore0-thermal",
    "bigcore1-thermal",
    "littlecore-thermal",
    "center-thermal",
    "gpu-thermal",
    "npu-thermal",
}

# IR receiver input device: re-resolve at most this often once it fails.
_IR_RETRY_INTERVAL_S = 30.0


def _read_file(path, default=""):
    """Read a file safely; return default if missing or unreadable."""
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except (OSError, ValueError):
        return default


def _read_thermal_zones():
    """Read thermal zones, matched by 'type' string (never assume index order).

    Returns dict {zone_type: temp_c}; missing zones simply absent.
    """
    zones = {}
    for i in range(10):  # scan thermal_zone0..thermal_zone9
        zone_type = _read_file(f"/sys/class/thermal/thermal_zone{i}/type", "")
        if zone_type in _EXPECTED_ZONES:
            temp_milli = _read_file(f"/sys/class/thermal/thermal_zone{i}/temp", "")
            try:
                zones[zone_type] = float(temp_milli) / 1000.0
            except (ValueError, TypeError):
                pass
    return zones


def _parse_cpu_stat(stat_line):
    """Parse a /proc/stat 'cpuN ...' line -> (user, nice, system, idle, iowait) ticks."""
    parts = stat_line.split()
    if len(parts) < 6:
        return (0, 0, 0, 0, 0)
    try:
        return (
            int(parts[1]),  # user
            int(parts[2]),  # nice
            int(parts[3]),  # system
            int(parts[4]),  # idle
            int(parts[5]),  # iowait
        )
    except (ValueError, IndexError):
        return (0, 0, 0, 0, 0)


def _read_cpu_stat():
    """Read /proc/stat -> {'total': ticks, 0: ticks, ..., 7: ticks}. {} if unreadable."""
    content = _read_file("/proc/stat", "")
    if not content:
        return {}

    result = {}
    for line in content.split("\n"):
        if not line.startswith("cpu"):
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        key = parts[0]
        ticks = _parse_cpu_stat(line)
        if key == "cpu":
            result["total"] = ticks
        else:
            try:
                core_id = int(key[3:])
                result[core_id] = ticks
            except (ValueError, IndexError):
                pass
    return result


def _cpu_pct_delta(prev_ticks, cur_ticks):
    """CPU% from two tick snapshots. active=user+nice+system, idle=idle+iowait.

    Clamped to [0,100]; a counter reset (negative delta) yields 0.0 rather than
    a nonsensical or crashing result.
    """
    if prev_ticks is None or cur_ticks is None:
        return 0.0

    p_user, p_nice, p_sys, p_idle, p_iowait = prev_ticks
    c_user, c_nice, c_sys, c_idle, c_iowait = cur_ticks

    delta_active = (c_user - p_user) + (c_nice - p_nice) + (c_sys - p_sys)
    delta_idle = (c_idle - p_idle) + (c_iowait - p_iowait)
    delta_total = delta_active + delta_idle

    if delta_total <= 0 or delta_active < 0:
        return 0.0

    return max(0.0, min(100.0, (delta_active / delta_total) * 100.0))


def _read_cpu_mhz(core_id):
    """Current CPU frequency in MHz for a core; 0 if unreadable."""
    freq_khz_str = _read_file(
        f"/sys/devices/system/cpu/cpu{core_id}/cpufreq/scaling_cur_freq", ""
    )
    try:
        return int(freq_khz_str) // 1000
    except (ValueError, TypeError):
        return 0


def _read_gpu_load():
    """Parse /sys/class/devfreq/fb000000.gpu/load: 'N@FreqHz' -> (pct, mhz)."""
    load_str = _read_file("/sys/class/devfreq/fb000000.gpu/load", "")
    match = re.match(r"(\d+)@(\d+)Hz", load_str)
    if not match:
        return (0.0, 0)
    try:
        pct = float(match.group(1))
        mhz = int(match.group(2)) // 1_000_000
        return (pct, mhz)
    except (ValueError, IndexError):
        return (0.0, 0)


def _read_npu_load():
    """Parse /proc/rknpu/load 'Core0: 74%, Core1: 0%, Core2: 0%,' -> [p0,p1,p2]."""
    content = _read_file("/proc/rknpu/load", "")
    cores = [0.0, 0.0, 0.0]
    if not content:
        return cores
    for m in re.finditer(r"Core(\d):\s*(\d+)%", content):
        try:
            idx = int(m.group(1))
            if 0 <= idx < 3:
                cores[idx] = float(m.group(2))
        except (ValueError, IndexError):
            pass
    return cores


def _read_npu_mhz():
    """NPU frequency in MHz from devfreq cur_freq; 0 if unreadable."""
    freq_hz_str = _read_file("/sys/class/devfreq/fdab0000.npu/cur_freq", "")
    try:
        return int(freq_hz_str) // 1_000_000
    except (ValueError, TypeError):
        return 0


_npu_rt_cache = [None, 0.0]   # [value, monotonic timestamp]


def _read_npu_runtime_uncached():
    """True if librknnrt.so is present: either in `ldconfig -p` output or on disk.

    Never pipes through `grep -q` under pipefail (that trap can silently report
    absent-when-present); instead captures ldconfig's stdout as a string and
    searches it directly. Any failure (missing binary, timeout, etc.) is
    swallowed and falls back to the direct file-existence check.
    """
    npu_lib = "/usr/lib/aarch64-linux-gnu/librknnrt.so"
    if os.path.exists(npu_lib):
        return True
    try:
        result = subprocess.run(
            ["ldconfig", "-p"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=3,
            text=True,
        )
        return "librknnrt.so" in result.stdout
    except (OSError, subprocess.SubprocessError):
        return False


def _read_npu_runtime():
    """Cached: the runtime's presence changes at most once per session, and the
    uncached check forks ldconfig. Re-checked every 30 s."""
    now = time.monotonic()
    if _npu_rt_cache[0] is None or now - _npu_rt_cache[1] > 30.0:
        _npu_rt_cache[0] = _read_npu_runtime_uncached()
        _npu_rt_cache[1] = now
    return _npu_rt_cache[0]


def _read_meminfo():
    """Read /proc/meminfo -> (total_kb, avail_kb); (0,0) if unreadable."""
    content = _read_file("/proc/meminfo", "")
    total_kb = 0
    avail_kb = 0
    if not content:
        return (0, 0)
    for line in content.split("\n"):
        parts = line.split(":")
        if len(parts) != 2:
            continue
        key = parts[0].strip()
        try:
            val_kb = int(parts[1].strip().split()[0])
        except (ValueError, IndexError):
            continue
        if key == "MemTotal":
            total_kb = val_kb
        elif key == "MemAvailable":
            avail_kb = val_kb
    return (total_kb, avail_kb)


# ---- network / bluetooth ----

def _read_net_dev_bytes():
    """Read /proc/net/dev -> {iface: (rx_bytes, tx_bytes)}. {} if unreadable."""
    content = _read_file("/proc/net/dev", "")
    result = {}
    if not content:
        return result
    for line in content.split("\n"):
        if ":" not in line:
            continue
        name, _, rest = line.partition(":")
        iface = name.strip()
        fields = rest.split()
        if len(fields) < 9:
            continue
        try:
            result[iface] = (int(fields[0]), int(fields[8]))
        except (ValueError, IndexError):
            pass
    return result


def _read_wifi_signal_dbm():
    """Parse /proc/net/wireless for the 'wlan0:' line -> signal level in dBm, or None.

    Fields after the iface colon are: status, link-quality., level(dBm)., noise.
    (trailing dots on numeric fields). The wlan0 line is simply absent when the
    interface is down, which is not an error.
    """
    content = _read_file("/proc/net/wireless", "")
    if not content:
        return None
    for line in content.split("\n"):
        stripped = line.strip()
        if not stripped.startswith("wlan0:"):
            continue
        _, _, rest = stripped.partition(":")
        fields = rest.split()
        if len(fields) < 3:
            return None
        try:
            # fields: [0]=status [1]=link-quality. [2]=level(dBm). [3]=noise.
            return int(float(fields[2].rstrip(".")))
        except (ValueError, IndexError):
            return None
    return None


def _read_bt_state():
    """Read Bluetooth adapter presence, rfkill block state, and connection count.

    Returns (present, blocked, connections).
    """
    present = os.path.exists("/sys/class/bluetooth/hci0")
    connections = 0
    blocked = False

    if present:
        try:
            entries = os.listdir("/sys/class/bluetooth/hci0")
            connections = sum(1 for e in entries if e.startswith("hci0:"))
        except OSError:
            pass

        try:
            for name in os.listdir("/sys/class/rfkill"):
                rf_name = _read_file(f"/sys/class/rfkill/{name}/name", "")
                if "hci0" in rf_name:
                    soft = _read_file(f"/sys/class/rfkill/{name}/soft", "0")
                    hard = _read_file(f"/sys/class/rfkill/{name}/hard", "0")
                    blocked = (soft.strip() == "1") or (hard.strip() == "1")
                    break
        except OSError:
            pass

    return (present, blocked, connections)


def _read_net(prev_net_bytes, dt):
    """Read eth0/wlan0/bt state -> dict, plus rates computed from prev byte counters.

    Returns dict:
      eth0: {state, speed_mbps, rx_bps, tx_bps}
      wlan0: {state, signal_dbm, rx_bps, tx_bps}
      bt: {present, blocked, connections}
    """
    eth_state = _read_file("/sys/class/net/eth0/operstate", "down")
    eth_speed_str = _read_file("/sys/class/net/eth0/speed", "")
    try:
        eth_speed = int(eth_speed_str)
    except (ValueError, TypeError):
        eth_speed = 0

    wlan_state = _read_file("/sys/class/net/wlan0/operstate", "down")
    wifi_dbm = _read_wifi_signal_dbm()

    bt_present, bt_blocked, bt_conn = _read_bt_state()

    cur_bytes = _read_net_dev_bytes()

    def _rates(iface):
        rx_bps = 0.0
        tx_bps = 0.0
        if prev_net_bytes and dt > 0:
            prev = prev_net_bytes.get(iface)
            cur = cur_bytes.get(iface)
            if prev and cur:
                rx_bps = max(0.0, (cur[0] - prev[0]) / dt)
                tx_bps = max(0.0, (cur[1] - prev[1]) / dt)
        return rx_bps, tx_bps

    eth_rx, eth_tx = _rates("eth0")
    wlan_rx, wlan_tx = _rates("wlan0")

    net = {
        "eth0": {
            "state": eth_state,
            "speed_mbps": eth_speed,
            "rx_bps": eth_rx,
            "tx_bps": eth_tx,
        },
        "wlan0": {
            "state": wlan_state,
            "signal_dbm": wifi_dbm,
            "rx_bps": wlan_rx,
            "tx_bps": wlan_tx,
        },
        "bt": {
            "present": bt_present,
            "blocked": bt_blocked,
            "connections": bt_conn,
        },
    }
    return net, cur_bytes


# ---- IR receiver ----

# Module-level singleton fd so we never open/close the device per tick.
_ir_fd = None
_ir_last_retry_ts = None  # time.monotonic() of last failed resolve attempt
_ir_last_press_ts = None  # time.monotonic() of last observed keypress
_ir_last_code = None


def _resolve_ir_event_path():
    """Scan /proc/bus/input/devices for Name="fd8b0030.pwm" and return its
    /dev/input/eventN path, or None if not found. Never hardcodes eventN.
    """
    content = _read_file("/proc/bus/input/devices", "")
    if not content:
        return None

    blocks = content.split("\n\n")
    for block in blocks:
        if 'Name="fd8b0030.pwm"' not in block:
            continue
        for line in block.split("\n"):
            if line.startswith("H:"):
                m = re.search(r"event(\d+)", line)
                if m:
                    return f"/dev/input/event{m.group(1)}"
    return None


def _read_ir():
    """Read pending IR events off the singleton fd (non-blocking, drains all).

    Returns {present, last_age_s, last_code}. Never raises; a missing/unopenable
    device just yields present=False, retried at most every 30s.
    """
    global _ir_fd, _ir_last_retry_ts, _ir_last_press_ts, _ir_last_code

    now = time.monotonic()

    if _ir_fd is None:
        if _ir_last_retry_ts is not None and (now - _ir_last_retry_ts) < _IR_RETRY_INTERVAL_S:
            return {"present": False, "last_age_s": None, "last_code": _ir_last_code}

        _ir_last_retry_ts = now
        event_path = _resolve_ir_event_path()
        if not event_path:
            return {"present": False, "last_age_s": None, "last_code": _ir_last_code}

        try:
            _ir_fd = os.open(event_path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            _ir_fd = None
            return {"present": False, "last_age_s": None, "last_code": _ir_last_code}

    # Drain all pending events; aarch64 struct input_event is 24 bytes:
    # 16B timeval (2x unsigned long) + u16 type + u16 code + s32 value.
    try:
        while True:
            buf = os.read(_ir_fd, 24)
            if not buf or len(buf) < 24:
                break
            _sec, _usec, ev_type, code, value = struct.unpack("<QQHHi", buf)
            if ev_type == 1 and value == 1:  # EV_KEY press
                _ir_last_press_ts = time.monotonic()
                _ir_last_code = code
    except BlockingIOError:
        pass
    except OSError:
        # fd went bad; close and let the next call retry resolution.
        try:
            os.close(_ir_fd)
        except OSError:
            pass
        _ir_fd = None
        _ir_last_retry_ts = now
        return {"present": False, "last_age_s": None, "last_code": _ir_last_code}

    last_age_s = None
    if _ir_last_press_ts is not None:
        last_age_s = time.monotonic() - _ir_last_press_ts

    return {"present": True, "last_age_s": last_age_s, "last_code": _ir_last_code}


# ---- disk / swap / load / uptime / peripheral battery ----

def _read_diskstats_sectors():
    """Read /proc/diskstats for mmcblk0 (whole device) else mmcblk0p2.

    Returns (device_key, read_sectors, write_sectors) or (None, 0, 0).
    Field layout after the 3 id fields: [3]=reads [5]=sectors read
    [7]=writes [9]=sectors written.
    """
    content = _read_file("/proc/diskstats", "")
    if not content:
        return (None, 0, 0)

    found = {}
    for line in content.split("\n"):
        parts = line.split()
        if len(parts) < 10:
            continue
        device = parts[2]
        if device not in ("mmcblk0", "mmcblk0p2"):
            continue
        try:
            read_sectors = int(parts[5])
            write_sectors = int(parts[9])
            found[device] = (read_sectors, write_sectors)
        except (ValueError, IndexError):
            pass

    if "mmcblk0" in found:
        return ("mmcblk0", found["mmcblk0"][0], found["mmcblk0"][1])
    if "mmcblk0p2" in found:
        return ("mmcblk0p2", found["mmcblk0p2"][0], found["mmcblk0p2"][1])
    return (None, 0, 0)


def _read_swap():
    """Parse /proc/swaps for zram0 -> (used_pct, total_mb)."""
    content = _read_file("/proc/swaps", "")
    if not content:
        return (0.0, 0.0)
    lines = content.split("\n")
    for line in lines[1:]:  # skip header
        parts = line.split()
        if len(parts) < 4 or "zram0" not in parts[0]:
            continue
        try:
            total_kb = int(parts[2])
            used_kb = int(parts[3])
        except (ValueError, IndexError):
            continue
        used_pct = 0.0
        if total_kb > 0:
            used_pct = max(0.0, min(100.0, (used_kb / total_kb) * 100.0))
        return (used_pct, total_kb / 1024.0)
    return (0.0, 0.0)


def _read_loadavg():
    """Read /proc/loadavg -> (avg1, avg5, avg15)."""
    content = _read_file("/proc/loadavg", "")
    parts = content.split()
    if len(parts) < 3:
        return (0.0, 0.0, 0.0)
    try:
        return (float(parts[0]), float(parts[1]), float(parts[2]))
    except (ValueError, IndexError):
        return (0.0, 0.0, 0.0)


def _read_uptime_s():
    """Read /proc/uptime -> seconds (float)."""
    content = _read_file("/proc/uptime", "")
    parts = content.split()
    if not parts:
        return 0.0
    try:
        return float(parts[0])
    except (ValueError, IndexError):
        return 0.0


def _read_peripheral_batteries():
    """Iterate /sys/class/power_supply/ generically; keep entries with a capacity.

    Returns list of {model_name, capacity_pct}. Skips anything lacking capacity
    (the board itself has no voltage sensor; do not invent one).
    """
    batteries = []
    try:
        entries = os.listdir("/sys/class/power_supply")
    except OSError:
        return batteries

    for entry in entries:
        base = f"/sys/class/power_supply/{entry}"
        model = _read_file(f"{base}/model_name", entry) or entry
        cap_str = _read_file(f"{base}/capacity", "")
        if cap_str:
            try:
                batteries.append({"model_name": model, "capacity_pct": int(cap_str)})
                continue
            except ValueError:
                pass
        # HID++ peripherals (e.g. the Logitech K400) expose only capacity_level
        # ("Full"/"Normal"/"Low"/"Critical", or "Unknown" until the device has
        # reported in). Show the level rather than dropping the battery.
        level = _read_file(f"{base}/capacity_level", "")
        if level:
            batteries.append({"model_name": model, "level": level})

    return batteries


def _read_sysinfo(prev_disk, dt):
    """Read disk usage/IO, swap, load, uptime, peripheral batteries.

    Returns dict:
      disk: {used_pct, total_gb}
      io: {read_bps, write_bps}
      swap: {used_pct, total_mb}
      load: {avg1, avg5, avg15}
      uptime_s
      batteries: list[{model_name, capacity_pct}]
    plus internal "_disk_sectors": (device_key, read_sectors, write_sectors)
    for the caller to thread into next tick's state.
    """
    # ---- DISK USAGE ----
    try:
        st = os.statvfs("/")
        total_bytes = st.f_blocks * st.f_frsize
        avail_bytes = st.f_bavail * st.f_frsize
        used_bytes = max(0, total_bytes - avail_bytes)
        used_pct = 0.0
        if total_bytes > 0:
            used_pct = max(0.0, min(100.0, (used_bytes / total_bytes) * 100.0))
        total_gb = total_bytes / (1024 ** 3)
    except OSError:
        used_pct = 0.0
        total_gb = 0.0

    # ---- DISK I/O RATE ----
    device_key, read_sectors, write_sectors = _read_diskstats_sectors()
    read_bps = 0.0
    write_bps = 0.0
    if prev_disk and device_key and dt > 0:
        prev_key, prev_read_sec, prev_write_sec = prev_disk
        if prev_key == device_key:
            read_bps = max(0.0, (read_sectors - prev_read_sec) * 512 / dt)
            write_bps = max(0.0, (write_sectors - prev_write_sec) * 512 / dt)

    swap_used_pct, swap_total_mb = _read_swap()
    avg1, avg5, avg15 = _read_loadavg()
    uptime_s = _read_uptime_s()
    batteries = _read_peripheral_batteries()

    return {
        "disk": {"used_pct": used_pct, "total_gb": total_gb},
        "io": {"read_bps": read_bps, "write_bps": write_bps},
        "swap": {"used_pct": swap_used_pct, "total_mb": swap_total_mb},
        "load": {"avg1": avg1, "avg5": avg5, "avg15": avg15},
        "uptime_s": uptime_s,
        "batteries": batteries,
        "_disk_sectors": (device_key, read_sectors, write_sectors) if device_key else None,
    }


def read_all(prev_stat=None):
    """Read all sensors -> (snap, cur_stat).

    prev_stat: the cur_stat returned by the previous call (or None on first
    call, in which case per-core/overall CPU% reads 0.0 for this tick, and
    net/disk rates read 0.0 too).

    Backward compatible: prev_stat may be the OLD plain cpu-stat dict (just
    {'total': ticks, 0: ticks, ...}) from before net/disk/IR were added, or
    the NEW extended dict {'cpu': ..., 'net_bytes': ..., 'disk_sectors': ...,
    'ts': ...}. Detected by the presence of the 'cpu' key.
    """
    ts = time.monotonic()
    cur_cpu_stat = _read_cpu_stat()

    if prev_stat and "cpu" in prev_stat:
        prev_cpu_stat = prev_stat.get("cpu")
        prev_net_bytes = prev_stat.get("net_bytes")
        prev_disk = prev_stat.get("disk_sectors")
        prev_ts = prev_stat.get("ts", ts)
    else:
        # Old-format prev_stat (plain cpu dict) or None.
        prev_cpu_stat = prev_stat
        prev_net_bytes = None
        prev_disk = None
        prev_ts = ts

    dt = max(0.0, ts - prev_ts)

    # ---- CPU ----
    prev_total = prev_cpu_stat.get("total") if prev_cpu_stat else None
    cur_total = cur_cpu_stat.get("total") if cur_cpu_stat else None
    cpu_overall = _cpu_pct_delta(prev_total, cur_total)

    cpu_cores = []
    for core_id in range(8):
        prev_ticks = prev_cpu_stat.get(core_id) if prev_cpu_stat else None
        cur_ticks = cur_cpu_stat.get(core_id) if cur_cpu_stat else None
        pct = _cpu_pct_delta(prev_ticks, cur_ticks)
        mhz = _read_cpu_mhz(core_id)
        cls = "A76" if core_id in BIG_CORES else "A55"
        cpu_cores.append({"id": core_id, "pct": pct, "mhz": mhz, "cls": cls})

    # ---- MEM ----
    total_kb, avail_kb = _read_meminfo()
    used_pct = 0.0
    if total_kb > 0:
        used_pct = max(0.0, min(100.0, (1.0 - (avail_kb / total_kb)) * 100.0))

    # ---- GPU ----
    gpu_pct, gpu_mhz = _read_gpu_load()

    # ---- NPU ----
    npu_cores = _read_npu_load()
    npu_mhz = _read_npu_mhz()
    npu_runtime = _read_npu_runtime()

    # ---- THERMAL ----
    zones = _read_thermal_zones()

    # ---- NETWORK / BT ----
    net, cur_net_bytes = _read_net(prev_net_bytes, dt)

    # ---- IR ----
    ir = _read_ir()

    # ---- DISK / SWAP / LOAD / UPTIME / BATTERY ----
    sysinfo = _read_sysinfo(prev_disk, dt)

    snap = {
        "ts": ts,
        "cpu": {"overall": cpu_overall, "cores": cpu_cores},
        "mem": {"total_kb": total_kb, "avail_kb": avail_kb, "used_pct": used_pct},
        "gpu": {"pct": gpu_pct, "mhz": gpu_mhz, "temp_c": zones.get("gpu-thermal", 0.0)},
        "npu": {
            "cores": npu_cores,
            "mhz": npu_mhz,
            "temp_c": zones.get("npu-thermal", 0.0),
            "runtime": npu_runtime,
        },
        "temps": {
            "soc": zones.get("soc-thermal", 0.0),
            "bigcore0": zones.get("bigcore0-thermal", 0.0),
            "bigcore1": zones.get("bigcore1-thermal", 0.0),
            "littlecore": zones.get("littlecore-thermal", 0.0),
            "center": zones.get("center-thermal", 0.0),
            "gpu": zones.get("gpu-thermal", 0.0),
            "npu": zones.get("npu-thermal", 0.0),
        },
        "net": net,
        "ir": ir,
        "disk": sysinfo["disk"],
        "io": sysinfo["io"],
        "swap": sysinfo["swap"],
        "load": sysinfo["load"],
        "uptime_s": sysinfo["uptime_s"],
