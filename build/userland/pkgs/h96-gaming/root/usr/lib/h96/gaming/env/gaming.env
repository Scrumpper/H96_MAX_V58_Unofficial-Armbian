# gaming.env: shared environment sourced by h96-game-mode. Session-scoped only
# (never exported system-wide) so the X11 Plasma desktop's Panfrost GL is
# unaffected. Per-title box64 dynarec knobs live in /etc/box64.box64rc, not here.

# fixes crackle/underrun on box64 titles
export PULSE_LATENCY_MSEC=60

# box64 global runtime hints (per-title overrides come from box64.box64rc)
export BOX64_LOG=0
export BOX64_NOBANNER=1

# Steam Runtime 3 / Proton compat hints (harmless when not using Steam)
export STEAM_RUNTIME=1
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# Wine: esync on (WINEDEBUG can be overridden by the launcher)
export WINEESYNC=1

# VK_DRIVER_FILES (PanVK ICD), WINEPREFIX, SDL_VIDEODRIVER and DXVK_HUD are set
# by h96-game-mode itself, depending on runtime args and ICD probe.
