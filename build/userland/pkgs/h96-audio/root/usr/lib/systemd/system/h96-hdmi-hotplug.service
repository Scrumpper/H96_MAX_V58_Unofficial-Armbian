[Unit]
Description=H96 Max V58 HDMI hotplug (new display EDID -> modes, audio, CEC address)
Documentation=file:/usr/share/doc/h96-base/COMMANDS.md
# started by /usr/lib/udev/rules.d/99-h96-hdmi-audio.rules; same display = nothing done
ConditionPathExists=!/etc/h96/hdmi-hotplug.off
After=h96-hdmi-audio-detect.service sys-kernel-debug.mount
Wants=sys-kernel-debug.mount
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/sbin/h96-hdmi-hotplug run
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
