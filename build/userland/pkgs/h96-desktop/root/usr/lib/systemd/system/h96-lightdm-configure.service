[Unit]
Documentation=file:/usr/share/doc/h96-base/COMMANDS.md
Description=H96 Max V58 LightDM auto-configure
After=local-fs.target
ConditionPathExists=!/var/lib/h96-lightdm-configure-done

[Service]
Type=oneshot
ExecStart=/usr/lib/h96/h96-lightdm-configure.sh
ExecStartPost=-/usr/bin/systemctl stop h96-lightdm-configure.path
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
