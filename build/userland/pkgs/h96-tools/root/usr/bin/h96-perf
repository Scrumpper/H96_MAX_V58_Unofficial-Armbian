#!/bin/bash
# h96-perf: terminal front end for the system power profile (same setting as the panel applet).

# shared block-letter header; stub avoids command-not-found when banner.sh is missing
[ -r /usr/lib/h96/banner.sh ] && . /usr/lib/h96/banner.sh
command -v h96_banner >/dev/null 2>&1 || h96_banner() { :; }

usage() {
    cat <<'USAGE'
h96-perf: system power profile, same setting as panel applet

  h96-perf                        show profile, CPU and GPU governors
  h96-perf status                 same as no argument
  h96-perf on | performance       performance profile
  h96-perf off | balanced         balanced profile (boot default)
  h96-perf saver | power-saver    power-saver profile
USAGE
}

case "${1:-status}" in
    -h|--help|help) usage; exit 0;;
    on|performance|off|balanced|schedutil|saver|power-saver|powersave|status) ;;
    *) echo "h96-perf: unknown argument '$1'" >&2; usage >&2; exit 2;;
esac

h96_banner "P O W E R   P R O F I L E"

GPU=/sys/class/devfreq/fb000000.gpu

# NPU follow mode: off unless /etc/h96/npu-follow exists (set by `h96-npu power sync on|off`)
npu_follow() {
    [ -e /etc/h96/npu-follow ] || return 0
    [ "$(id -u)" -eq 0 ] || return 0
    command -v h96-npu >/dev/null 2>&1 || return 0
    h96-npu power sync --quiet
}

# profile daemon access: powerprofilesctl when present, else the same D-Bus calls through busctl (Debian has no powerprofilesctl)
PPD_DEST=net.hadess.PowerProfiles; PPD_PATH=/net/hadess/PowerProfiles
ppd_get() {
    if command -v powerprofilesctl >/dev/null 2>&1; then powerprofilesctl get 2>/dev/null; return; fi
    busctl get-property "$PPD_DEST" "$PPD_PATH" "$PPD_DEST" ActiveProfile 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p'
}
ppd_set() {
    if command -v powerprofilesctl >/dev/null 2>&1; then powerprofilesctl set "$1"; return; fi
    busctl set-property "$PPD_DEST" "$PPD_PATH" "$PPD_DEST" ActiveProfile s "$1"
}

set_profile() {
    ppd_set "$1" || { echo "h96-perf: could not set profile $1 (power profile daemon not answering)" >&2; exit 1; }
    echo "$2"
    npu_follow
}

mhz() { echo $(( $(cat "$1" 2>/dev/null || echo 0) / 1000000 )); }

case "${1:-status}" in
    on|performance)              set_profile performance "Performance profile ON (CPU + GPU)";;
    off|balanced|schedutil)      set_profile balanced "Balanced profile ON (CPU + GPU)";;
    saver|power-saver|powersave) set_profile power-saver "Power saver profile ON (CPU + GPU)";;
    status)
        echo "Power profile: $(p=$(ppd_get); echo "${p:-unknown}")"
        echo "H96 Max V58 CPU governors:"
        i=0
        for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            echo "  cpu$i: $(cat "$f" 2>/dev/null)"; ((i++)); done
        echo "H96 Max V58 GPU governor:"
        echo "  GPU (Mali G610): $(cat "$GPU/governor" 2>/dev/null || echo unknown)," \
             "$(mhz "$GPU/min_freq")-$(mhz "$GPU/max_freq") MHz, now $(mhz "$GPU/cur_freq") MHz";;
esac
