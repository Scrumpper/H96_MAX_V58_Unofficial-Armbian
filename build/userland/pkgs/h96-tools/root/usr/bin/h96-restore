#!/usr/bin/env python3
# =============================================================================
# h96-restore - replay an h96-backup archive onto a freshly reflashed H96 Max V58.
#
# Reflashing wipes the eMMC back to the console base. h96-restore reads the
# archive's manifest.json, re-runs the on-demand installers for the features
# that were present, then restores the passive data (configs, WiFi, Waydroid
# /data, emulator saves, wine prefix) to the right paths and owners.
#
#   h96-restore                        list the archives found and ask which one
#   h96-restore <archive>              auto: run each installer, then restore data
#   h96-restore <folder>               use the newest archive in that folder
#   h96-restore --list                 print the archives found, change nothing
#   h96-restore <archive> --open       do NOT auto-run: print/launch the installer
#                                       commands for you to confirm, then restore
#                                       the passive data (configs/wifi/saves)
#   h96-restore <archive> --dry-run    print the plan only, change nothing
#   h96-restore <archive> --force      overwrite files that are newer on disk
#   h96-restore <archive> --only a,b   restore only these categories
#   h96-restore <archive> --skip a,b   restore everything except these categories
#   h96-restore <archive> --emulators x,y   limit which emulators are reinstalled
#   h96-restore <archive> --plan-json  print what the archive holds as JSON (no root)
#
# Categories: desktop configs emulators waydroid waydroid-images widevine gaming
# npu wifi autologin system wol vm. wol applies only when named in --only.
# h96-backup-gui is the graphical front end.
#
# Idempotent and safe: a config file already present and NEWER than the archived
# copy is kept (and noted), not clobbered, unless --force is given. On a fresh
# image a desktop session writes default configs before the restore runs, so
# those defaults count as newer; --force (with the session stopped) is the way
# to get the archived desktop configuration back in that case. WiFi confs
# restore as root:root 0600.
# User files restore owned by the DYNAMICALLY detected desktop user. Any feature
# whose installer is missing is skipped cleanly. Auto-elevates via sudo.
#
# Reads an archive made on v5.0.1 or any later release (schema 1, 2 or 3); a
# schema-1 archive has no display/services/wol/vm state and a schema-2 archive
# no NPU power or mpv HDR state, so those steps are skipped. *.lock members
# (captured by tool 2.2 and older) are never restored. Opt-in features (h96-leds, h96-cec, WoL) are only ever turned ON
# when the archive recorded them on; a feature this box never had is never
# enabled just because the archive is missing the field. h96-leds (enabled by
# the image) recorded off is switched off (tool 2.4). WoL is network state:
# category wol, applied only when --only names it, never by default.
# Tool 2.4: members with absolute or '..' paths, links in system folders and
# writes through links that leave their target folder are refused.
# Tool 2.5: whole archive read before anything is written (damaged or cut archive
# = exit 1, nothing written); NetworkManager/netplan WiFi files; audio passthrough
# choices re-applied through h96-audio-passthrough. Pinhole loader mode
# does not ship (tested, doesn't work); an older archive that recorded it on
# is noted and skipped, never fails.
# Steam ARM settings: H96 Steam ARM 1.2 (/etc/h96) and Steam ARM 2.0 (/etc/steam-arm, v6.2.1 on)
# restore as the flavour this box runs; shared keys and game profiles are translated.
# 8.0: programs moved out of /usr/local and /opt into package paths; v7.2 paths in
# restored ~/.config text follow when the 8.0 file exists and the old one does not.
# Nothing is ever written under /usr, /opt, /bin, /sbin or /lib.
# h96-edid-adapt is retired on v6.2: its service/udev rule are never restored,
# from any archive. /boot is never touched by this tool, on any archive.
# Autologin never restores the archived lightdm.conf/lightdm.conf.d files
# (distro- and h96-image-owned; an old copy can regress a newer install) --
# only the autologin-user (and autologin-session/user-session) setting is
# read out of them and applied through one h96-owned drop-in.
# =============================================================================
import os, sys, io, json, pwd, re, time, shutil, shlex, subprocess, tarfile, zlib, gzip
try:   # Python 3.14+: .tar.zst without the zstd CLI
    from compression import zstd as pyzstd
except ImportError:
    pyzstd = None

TOOL_VERSION = "2.5"   # h96-backup/h96-restore/h96-backup-gui release version

HELP = f"""h96-restore v{TOOL_VERSION} - replay an h96-backup archive after a reflash.

  h96-restore                        list the archives found and ask which one
  h96-restore <archive>              auto: run each installer, then restore data
  h96-restore <folder>               use the newest archive in that folder
  h96-restore --list                 print the archives found, change nothing
  h96-restore <archive> --open       do NOT auto-run; print/launch the installer
                                      commands to confirm, then restore the
                                      passive data (configs/wifi/saves)
  h96-restore <archive> --dry-run    print the plan only, change nothing
  h96-restore <archive> --force      overwrite files that are newer on disk
  h96-restore <archive> --only a,b   restore only these categories
  h96-restore <archive> --skip a,b   restore everything except these categories
  h96-restore <archive> --emulators x,y   limit which emulators are reinstalled
  h96-restore <archive> --plan-json  print what the archive holds as JSON (no root)

Categories: desktop configs emulators waydroid waydroid-images widevine gaming
npu wifi autologin system wol vm. wol (wake-on-LAN) applies only when named in
--only. h96-backup-gui is the graphical front end.

The archive can be a file or a folder: given a folder, the newest archive in it
is used. Given nothing at all on a terminal, the archives found on mounted media
and in home folders are listed to choose from.

Reads manifest.json, reinstalls the recorded features (desktop, emulators,
Waydroid, Widevine, gaming, NPU runtime), then restores configs, WiFi confs,
Waydroid /data, emulator saves and the wine prefix to the right paths/owners.
Newer existing configs are kept, not clobbered, unless --force is given: a
desktop session on a fresh image writes default configs before the restore
runs, so stop the session (sudo systemctl stop lightdm) and use --force to get
the archived desktop configuration back. WiFi restores root:root 0600.
User files chown to the dynamically detected desktop user. Auto-elevates.

Refused members: absolute or '..' paths, symlinks in system folders, symlinks
leading outside target home (wine drive links kept), writes through links
leading outside target folder, targets under /usr, /opt, /bin, /sbin, /lib.
Program paths of earlier releases in ~/.config text files follow 8.0 package
paths. Old home paths in ~/.config text files and Steam
library files follow new home. h96-leds recorded off: switched off. Steam ARM
settings carry owner choices only, never source machine state. Desktop user's
filter-chain and WirePlumber restart around restore when its user manager runs.

Archive is read in full first (checking archive ...); damaged or incomplete
archive: exit 1, nothing written. WiFi also restores NetworkManager and netplan
WiFi files (root:root 0600; netplan generate after netplan files). Audio
passthrough choices and mpv HDR re-apply through h96-audio-passthrough and
h96-hdr; mpv HDR passthrough applies as tonemap.
"""
FORCE = False   # set by --force: overwrite files that are newer on disk

