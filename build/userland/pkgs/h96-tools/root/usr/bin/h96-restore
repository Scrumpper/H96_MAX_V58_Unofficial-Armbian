def is_retired(arcname):
    low = arcname.lower()
    return any(m in low for m in RETIRED_MARKERS)

def is_lock_member(arcname):
    """Lock files are runtime state; skipped from any archive."""
    return arcname.endswith(".lock")

# -- 2.4 member safety: names, links and write targets ----------------------
LINK_KINDS = ("user", "steamuser", "numeric")   # trees where archived symlinks are recreated
WINE_DRIVE_RE = re.compile(r"(^|/)dosdevices/[a-z]::?$")   # wine drive map (z: -> /)

def member_unsafe(member):
    """Reason a member is refused, or None; fifos and devices are never written either."""
    n = member.name
    if not n or "\x00" in n: return "empty name"
    if n.startswith("/"): return "absolute path"
    if ".." in n.split("/"): return "'..' in path"
    if member.islnk() and (member.linkname.startswith("/") or ".." in member.linkname.split("/")):
        return "hard link outside archive"
    return None

def inside(path, base):
    path, base = os.path.normpath(path), os.path.normpath(base)
    return path == base or path.startswith(base.rstrip("/") + "/")

def nearest_existing(path):
    while path and not os.path.lexists(path):
        path = os.path.dirname(path)
    return path or "/"

def target_ok(path, base, kind, uid):
    """path, links resolved, lies inside base, or (user kinds) in a folder the user owns."""
    real = os.path.realpath(path)
    if inside(real, os.path.realpath(base)):
        return True
    if kind in ("user", "steamuser") and uid:
        try:
            return os.stat(nearest_existing(real)).st_uid == uid
        except OSError:
            return False
    return False

def parse_categories(spec, flag):
    out = []
    for c in spec.split(","):
        c = c.strip()
        if not c or c == "none": continue
        if c not in CATEGORIES:
            die(f"{flag}: unknown category '{c}' (choose from {', '.join(CATEGORIES)})")
        out.append(c)
    return out

EMU_APP_IDS = {   # mirrors h96-backup: flatpak app id -> emulator name
    "org.libretro.RetroArch": "retroarch", "org.DolphinEmu.dolphin-emu": "dolphin",
    "org.ppsspp.PPSSPP": "ppsspp", "org.flycast.Flycast": "flycast",
    "net.kuribo64.melonDS": "melonds", "com.github.Rosalie241.RMG": "rmg",
    "org.azahar_emu.Azahar": "azahar",
}
CEMU_SUBDIR = ".local/share/h96-emulators/cemu"
GAMING_PREFIX_SUB = ".local/share/h96-gaming"

def member_category(arcname):
    """(category, emulator-name-or-None) for an archive member."""
    if arcname == "manifest.json":              return None, None
    if is_retired(arcname):                     return None, None  # e.g. edid-adapt: never restored
    if is_lock_member(arcname):                 return None, None
    if arcname.startswith("userhome/.config/"):  return "configs", None
    if arcname.startswith("userhome/.local/share/kscreen") or \
       arcname.startswith("userhome/.local/state/wireplumber"): return "configs", None
    if arcname.startswith("userhome/.var/app/"):
        app = arcname.split("/", 3)[3].split("/", 1)[0] if arcname.count("/") >= 3 else ""
        return "emulators", EMU_APP_IDS.get(app, app)
    if arcname.startswith("userhome/" + CEMU_SUBDIR): return "emulators", "cemu"
    if arcname.startswith("userhome/" + GAMING_PREFIX_SUB): return "gaming", None
    if arcname.startswith("steamhome/"):         return "gaming", None
    if arcname.startswith("wifi/"):              return "wifi", None
    if arcname.startswith(("wifi-nm/", "wifi-netplan/")): return "wifi", None
    if arcname.startswith("system/lightdm/"):    return "autologin", None
    if arcname == "system/etc-h96/vm.conf":      return "vm", None
    if arcname.startswith("system/etc-h96/"):    return "system", None
    if arcname.startswith("system/etc-steam-arm/"): return "system", None
    if arcname.startswith("vm/"):                return "vm", None
    if arcname.startswith("waydroid-data/"):     return "waydroid", None
    if arcname.startswith("waydroid-stash/"):    return "waydroid-images", None
    return None, None

def plan_json(archive):
    """Stream the archive once and describe it: manifest fields plus per-category
    presence, file counts and bytes. No root needed."""
    tf, proc = open_read(archive)
    manifest = None
    cats = {c: {"present": False, "files": 0, "bytes": 0, "detail": ""} for c in CATEGORIES}
    emu_files = {}
    wifi_net = 0
    for member in tf:
        if member.name == "manifest.json":
            manifest = json.loads(tf.extractfile(member).read().decode()); continue
        cat, emu = member_category(member.name)
        if not cat or member_unsafe(member): continue
        if member.isreg() and member.name.startswith(("wifi-nm/", "wifi-netplan/")): wifi_net += 1
        c = cats[cat]; c["present"] = True
        if member.isreg(): c["files"] += 1; c["bytes"] += member.size
        if emu: emu_files[emu] = emu_files.get(emu, 0) + (member.size if member.isreg() else 0)
    tf.close()
    if proc: proc.stdout.close(); proc.wait()
    if manifest is None:
        die("not an h96-backup archive (no manifest.json)")
    f = manifest.get("features", {}); w = f.get("waydroid", {})
    if manifest.get("desktop", "none") != "none":
        cats["desktop"].update(present=True, detail=f"{manifest['desktop']} ({manifest.get('desktop_package')})")
    if f.get("emulators"):
        cats["emulators"].update(present=True, detail=", ".join(f["emulators"]))
    if w.get("profile") or cats["waydroid"]["present"]:
        cats["waydroid"].update(present=True, detail=f"profile {w.get('profile') or 'none'}, /data {'yes' if w.get('data') else 'no'}")
    if cats["waydroid-images"]["present"]:
        cats["waydroid-images"]["detail"] = ", ".join(w.get("stashes", []))
    if f.get("widevine"):   cats["widevine"].update(present=True, detail="L3 CDM (re-downloaded)")
    steam = f.get("steam_arm", {})
    if f.get("gaming"):
        cats["gaming"].update(present=True, detail="wine prefixes + stack fetch"
                              + (f" + Steam ARM ({steam.get('user')}"
                                 + (", Proton prefixes bundled" if steam.get("proton_prefixes_included") else "")
                                 + (", client runtime bundled" if steam.get("runtime_included") else "")
                                 + ")" if steam.get("home_included") else ""))
    if f.get("npu_runtime"): cats["npu"].update(present=True, detail="RKNN runtime")
    if cats["wifi"]["present"]:
        cats["wifi"]["detail"] = f"{cats['wifi']['files'] - wifi_net} conf(s)" + (
            f", {wifi_net} NetworkManager/netplan WiFi file(s)" if wifi_net else "")
    if cats["autologin"]["present"]:
        cats["autologin"]["detail"] = "autologin-user setting (one h96 drop-in, not the raw lightdm files)"
    if cats["configs"]["present"]:   cats["configs"]["detail"] = "~/.config subset, display+audio state"
    display = f.get("display", {}); services = f.get("services", {}); wol = f.get("wol")
    npu_power = f.get("npu_power") or {}; hdr = f.get("mpv_hdr")
    pt = passthrough_value(manifest)
    on_svcs = [s for s, v in services.items() if v]
    if wol in ("on", "off"):
        cats["wol"].update(present=True, detail=f"wake-on-LAN {wol}; applied only when selected (--only wol)")
    if cats["system"]["present"] or display or services or npu_power or hdr or pt:
        cats["system"].update(present=True,
            detail=f"hdmi20_off={display.get('hdmi20_off', False)} frl_off={display.get('frl_off', False)} "
                   f"color={display.get('color') or 'rgb'} range={display.get('range') or 'full'} "
                   f"per_display={len(display.get('per_display', {}))} "
                   f"services_on={','.join(on_svcs) or 'none'}"
                   f"{npu_power_detail(npu_power)} mpv_hdr={hdr or 'off'}"
                   f" passthrough={pt['mode'] + (',codecs' if pt['codecs_on'] else '') if pt else 'off'}")
    vm = f.get("vm", {})
    if cats["vm"]["present"] or vm.get("names"):
        cats["vm"].update(present=True,
            detail=f"{len(vm.get('names', []))} VM(s): {', '.join(vm.get('names', [])) or '(none)'}"
                   + ("; disks bundled" if vm.get("disks_included") else "; disks not bundled"))
    cats["emulators"]["items"] = emu_files
    retired_note = ("h96-edid-adapt from this archive will NOT be restored (retired on v6.2)"
                    if pre_v62(manifest) else None)
    return {"archive": archive, "created": manifest.get("created"), "schema": manifest.get("schema"),
            "source_version": manifest.get("source_version", "unknown"),
            "tool_version": manifest.get("tool_version", "unknown"),
            "desktop": manifest.get("desktop"), "desktop_package": manifest.get("desktop_package"),
            "emulators": f.get("emulators", []), "waydroid": w,
            "widevine": f.get("widevine"), "gaming": f.get("gaming"), "npu_runtime": f.get("npu_runtime"),
            "wifi": f.get("wifi"), "backup_categories": manifest.get("categories"),
            "display": display, "services": services, "wol": wol, "vm": vm,
            "npu_power": npu_power, "mpv_hdr": hdr,
            "audio_passthrough": f.get("audio_passthrough"),
            "retired_note": retired_note,
            "categories": cats}

def pre_v62(manifest):
    """Archive from v6.1 or older: named source version, or schema 1 without one (genuine schema-1 tools wrote none)."""
    src = manifest.get("source_version") or "unknown"
    return src.startswith(("v5", "v6.0", "v6.1")) or (src == "unknown" and manifest.get("schema") == 1)

def apply_selection(manifest, sel, emu_filter):
    """Trim the manifest so the installer steps only see selected features."""
    f = manifest["features"]
    if "desktop" not in sel:
        manifest["desktop"], manifest["desktop_package"] = "none", None
    if "emulators" not in sel:
        f["emulators"] = []
    elif emu_filter is not None:
        f["emulators"] = [e for e in f.get("emulators", []) if e in emu_filter]
    if "waydroid" not in sel:
        f.setdefault("waydroid", {})["profile"] = None
        f["waydroid"]["data"] = False
    if "waydroid-images" not in sel:
        f.setdefault("waydroid", {})["images_included"] = False
    if "widevine" not in sel: f["widevine"] = False
    if "gaming" not in sel:
        f["gaming"] = False
        f.setdefault("steam_arm", {})["home_included"] = False
        f["steam_arm"]["proton_prefixes_included"] = False
        f["steam_arm"]["runtime_included"] = False
    if "npu" not in sel:      f["npu_runtime"] = False
    if "wifi" not in sel:     f["wifi"] = 0
    if "wol" not in sel:      f["wol"] = None
    if "system" not in sel:
        f["display"], f["services"] = {}, {}
        f["npu_power"], f["mpv_hdr"], f["audio_passthrough"] = {}, None, None
    if "vm" not in sel:
        f.setdefault("vm", {})["names"], f["vm"]["disks_included"] = [], False

# Installer tools invoked in auto mode. Absent tools are skipped (warned).
EMU_TOOL      = "h96-emulators"
WAYDROID_TOOL = "h96-waydroid"
WIDEVINE_TOOL = "h96-widevine-setup"
GAMEMODE_TOOL = "h96-game-mode"
NPU_TOOL      = "h96-npu-setup"

WAYDROID_STASHES = {
    "gpu":    "/etc/waydroid-extra/gpu-images",
    "los":    "/etc/waydroid-extra/los-images",
    "custom": "/etc/waydroid-extra/custom-images",
}

# init custom replaces /etc/waydroid-extra/custom-images, so a bundled custom image restores
# beside it and init takes it from there
CUSTOM_RESTORE = "/etc/waydroid-extra/custom-images-restored"
STASH_DIRS = {}   # stash name -> restore folder override, set from the manifest

# Map a recorded Waydroid profile tag to the `h96-waydroid init` argument.
# "sw" (LineageOS) is ambiguous between gapps/vanilla; vanilla is the tool's
# recommended path and restores an equivalent image (or the stash if bundled).
PROFILE_TO_INIT = {"gpu": "gpu", "custom": "custom", "sw": "vanilla"}

# --------------------------------------------------------------- output ------
def c(s, code): return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else s
def info(m): print(">> " + m)
def warn(m): print(c("!! " + m, "93"), file=sys.stderr)
def ok(m):   print(c(m, "92"))
def die(m):  print(c("ERROR: " + m, "91"), file=sys.stderr); sys.exit(1)
def step(m): print(c("== " + m, "96"))

_ART = r"""
   ██╗  ██╗ █████╗  ██████╗    ██╗   ██╗███████╗ █████╗
   ██║  ██║██╔══██╗██╔════╝    ██║   ██║██╔════╝██╔══██╗
   ███████║╚██████║███████╗    ██║   ██║███████╗╚█████╔╝
   ██╔══██║ ╚═══██║██╔═══██╗    ╚██╗ ██╔╝╚════██║██╔══██╗
   ██║  ██║ █████╔╝╚██████╔╝     ╚████╔╝ ███████║╚█████╔╝
   ╚═╝  ╚═╝ ╚════╝  ╚═════╝       ╚═══╝  ╚══════╝ ╚════╝"""

_BANNER_DONE = []

def banner(title):
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return
    if _BANNER_DONE:          # the picker draws it before main() gets there
        return
    _BANNER_DONE.append(True)
    B, P, D, BOLD, X = "\033[96m", "\033[95m", "\033[2m", "\033[1m", "\033[0m"
    def ctr(s): return s.rjust((64 + len(s)) // 2)
    print(B + BOLD + _ART + X)
    print(P + BOLD + ctr("  S C R U M P P E R ' S  ") + X)
    print(P + BOLD + ctr("  " + "   ".join(title) + "  ") + X)
    print(D + ctr("H96 Max V58  ·  Rockchip RK3588") + X)
    print(D + "  " + "─" * 60 + X)

# --------------------------------------------------------------- helpers -----
def have(cmd): return shutil.which(cmd) is not None

def desktop_user():
    """Detect the desktop user dynamically. NEVER hardcode a name."""
    v = os.environ.get("SUDO_USER")
    if v and v != "root": return v
    u = os.environ.get("USER")
    if u and u != "root": return u
    for p in pwd.getpwall():
        if 1000 <= p.pw_uid < 65000 and os.path.isdir(p.pw_dir): return p.pw_name
    die("cannot determine the desktop user")

def user_home(user):
    try: return pwd.getpwnam(user).pw_dir
    except KeyError: return f"/home/{user}"

def elevate():
    if os.geteuid() == 0: return
    if not have("sudo"):
        die("needs root to restore system files (sudo not available); run as root")
    os.execvp("sudo", ["sudo", "-E", sys.executable, os.path.abspath(__file__)] + sys.argv[1:])

def human(n):
    x = float(n)
    for u in ("B", "KB", "MB", "GB", "TB"):
        if x < 1024 or u == "TB":
            return f"{x:.0f}{u}" if u == "B" else f"{x:.1f}{u}"
        x /= 1024.0

ARCHIVE_GLOBS = ("h96-backup-*.tar.zst", "h96-backup-*.tar.gz")


def archives_in(directory):
    """Archives directly in `directory` and one level below it, newest first."""
    import glob as _glob
    found = set()
    for pat in list(ARCHIVE_GLOBS) + [os.path.join("*", g) for g in ARCHIVE_GLOBS]:
        for f in _glob.glob(os.path.join(directory, pat)):
            if os.path.isfile(f):
                found.add(f)
    return sorted(found, key=lambda f: os.path.getmtime(f), reverse=True)


def search_dirs():
    """Where an archive is likely to be: mounted media first, then home folders."""
    import glob as _glob
    out = []
    for pat in ("/media/*/*", "/run/media/*/*", "/mnt/*", "/media/*"):
        for p in sorted(_glob.glob(pat)):
            if os.path.ismount(p) and os.access(p, os.R_OK) and p not in out:
                out.append(p)
    for p in pwd.getpwall():
        if 1000 <= p.pw_uid < 65000 and os.path.isdir(p.pw_dir) and p.pw_dir not in out:
            out.append(p.pw_dir)
    if os.path.isdir("/root"):
        out.append("/root")
    return out


def find_archives():
    found = set()
    for d in search_dirs():
        found.update(archives_in(d))
    return sorted(found, key=lambda f: os.path.getmtime(f), reverse=True)


def describe(path):
    try:
        st = os.stat(path)
    except OSError:
        return path
    return (f"{human(st.st_size):>9}  {time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime))}"
            f"  {path}")


def list_archives(found):
    if not found:
        print("No archive found on mounted media or in the home folders.")
        print("Plug the stick in, or give the path: h96-restore /path/to/archive")
        return
    print(f"{len(found)} archive(s), newest first:\n")
    for i, f in enumerate(found, 1):
        print(f"  {i:>2})  {describe(f)}")


def choose_archive():
    """List what was found and ask. Returns a path, or None to stop."""
    found = find_archives()
    banner("R E S T O R E")
    print()
    list_archives(found)
    if not found:
        return None
    print()
    print("  Type a number, or the path to an archive or a folder. Enter alone stops.")
    try:
        answer = input("  archive > ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if not answer:
        return None
    if answer.isdigit() and 1 <= int(answer) <= len(found):
        return found[int(answer) - 1]
    return resolve_archive(os.path.expanduser(answer))


def resolve_archive(path):
    """Accept a file or a folder. A folder gives up its newest archive."""
    if os.path.isdir(path):
        found = archives_in(path)
        if not found:
            die(f"no h96-backup archive in {path}")
        if len(found) > 1:
            info(f"{len(found)} archives in {path}; using the newest")
        return found[0]
    return path


def run(argv, dry):
    """Run an installer; in dry/open mode only print the command line."""
    line = " ".join(argv)
    if dry:
        print("    would run: " + line); return True
    info("run: " + line)
    try:
        return subprocess.run(argv).returncode == 0
    except FileNotFoundError:
        warn(f"tool not found: {argv[0]} (skipped)")
        return False

# ------------------------------------------------------------ archive io -----
ARCHIVE_OPENED = None   # last archive opened; named in damaged-archive error

def open_read(path):
    """Open the archive for streaming read. .tar.zst: zstd CLI, else Python compression.zstd."""
    global ARCHIVE_OPENED
    ARCHIVE_OPENED = path
    if not os.path.exists(path):
        die(f"archive not found: {path}")
    if path.endswith(".zst"):
        if not have("zstd"):
            if pyzstd is not None:
                return tarfile.open(fileobj=pyzstd.open(path, "rb"), mode="r|"), None
            die("archive is zstd-compressed but 'zstd' is not installed "
                "(apt install zstd)")
        proc = subprocess.Popen(["zstd", "-dc", path], stdout=subprocess.PIPE)
        return tarfile.open(fileobj=proc.stdout, mode="r|"), proc
    if path.endswith((".gz", ".tgz")):
        return tarfile.open(path, "r|gz"), None
    return tarfile.open(path, "r|"), None

TAR_END = b"\0" * 1024   # two zero blocks end every tar stream

def tar_tail_ok(fh):
    """Read a tar stream to its end: size a multiple of 512 and two zero end blocks."""
    total, tail = 0, b""
    while True:
        chunk = fh.read(1 << 20)
        if not chunk: break
        total += len(chunk)
        tail = (tail + chunk)[-1024:]
    return total >= 1536 and total % 512 == 0 and tail == TAR_END

def check_archive(path, to_stderr=False):
    """Whole archive read before anything is written; exits 1 on a damaged or cut archive."""
    global ARCHIVE_OPENED
    ARCHIVE_OPENED = path
    if not os.path.isfile(path):
        die(f"archive not found: {path}")
    print(f">> checking archive {path} ...", file=sys.stderr if to_stderr else sys.stdout, flush=True)
    good = False
    try:
        if path.endswith(".zst"):
            if have("zstd"):
                proc = subprocess.Popen(["zstd", "-dcq", path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                try:
                    good = tar_tail_ok(proc.stdout)
                finally:
                    proc.stdout.close()
                    good = proc.wait() == 0 and good
            elif pyzstd is not None:
                try:
                    with pyzstd.open(path, "rb") as fh:
                        good = tar_tail_ok(fh)
                except pyzstd.ZstdError:
                    good = False
            else:
                die("archive is zstd-compressed but 'zstd' is not installed (apt install zstd)")
        elif path.endswith((".gz", ".tgz")):
            with gzip.open(path, "rb") as fh:
                good = tar_tail_ok(fh)
        else:
            size = os.path.getsize(path)
            with open(path, "rb") as fh:
                fh.seek(max(0, size - 1024))
                good = size >= 1536 and size % 512 == 0 and fh.read() == TAR_END
    except (EOFError, OSError, zlib.error):   # gzip: missing end marker, bad CRC, not gzip
        good = False
    if not good:
        die(f"archive damaged or incomplete: {path}")

# ------------------------------------------------------- member routing ------
def map_dest(arcname, home, wdata_base, steam_home=None):
    """Map an archive member to (dest_path, owner_kind, base) or (None, None, None) to skip.
    owner_kind: 'user' chown to desktop user, 'steamuser' chown to the Steam ARM
    account, 'root' 0600 root, 'root_dir' root dir/file, 'numeric' keep the
    tar-recorded uid/gid (Waydroid /data). dest always lies inside base, never in a package tree."""
    dest, kind, base = _map_dest(arcname, home, wdata_base, steam_home)
    if not dest or not inside(dest, base):
        return None, None, None
    if packaged_tree(dest):
        warn(f"{arcname}: target {dest} lies in a package-managed folder; skipped")
        return None, None, None
    return dest, kind, base

def packaged_tree(path):
    """True when path, as named or with links resolved, lies under a package-managed root."""
    return any(inside(p, r) for p in (os.path.normpath(path), os.path.realpath(path)) for r in PACKAGED_ROOTS)

def _map_dest(arcname, home, wdata_base, steam_home):
    if arcname == "manifest.json":
        return None, None, None
    if is_retired(arcname) or is_lock_member(arcname):
        return None, None, None
    if arcname.startswith("userhome/"):
        return os.path.join(home, arcname[len("userhome/"):]), "user", home
    if arcname.startswith("steamhome/"):
        base = steam_home or home
        rel = arcname[len("steamhome/"):]
        return (os.path.join(base, rel) if rel else base), "steamuser", base
    # Safe to write back verbatim: this file holds only the box's own SSID/PSK,
    # generated by h96-wifi-connect; no package ships a per-interface template
    # here, so there is nothing distro-owned to overwrite.
    if arcname.startswith("wifi/"):
        name = os.path.basename(arcname)
        if not name: return None, None, None
        return os.path.join("/etc/wpa_supplicant", name), "root", "/etc/wpa_supplicant"
    if arcname.startswith("wifi-nm/"):
        name = arcname[len("wifi-nm/"):]
        if not NM_NAME_RE.fullmatch(name): return None, None, None
        return os.path.join(NM_CONN_DIR, name), "root", NM_CONN_DIR
    if arcname.startswith("wifi-netplan/"):
        name = arcname[len("wifi-netplan/"):]
        if not NETPLAN_NAME_RE.fullmatch(name): return None, None, None
        return os.path.join(NETPLAN_DIR, name), "root", NETPLAN_DIR
    # system/lightdm/* is never written back verbatim (distro/h96-image-owned
    # files); scan_autologin_settings()/apply_autologin() handle it instead.
    if arcname.startswith("system/lightdm/"):
        return None, None, None
    if arcname == "system/etc-h96/hotspot.conf":
        return HOTSPOT_CONF, "root", "/etc/h96"          # 0600: SSID/password
    if arcname == "system/etc-h96/vm.conf":
        return VM_CONF, "root_dir", "/etc/h96"
    if arcname == "system/etc-h96/leds.conf":
        return LEDS_CONF, "root_flag", "/etc/h96"        # h96-leds ignores bad content, falls back to steady
    if arcname in STEAM_MEMBERS:
        what, src = STEAM_MEMBERS[arcname]
        dest = steam_dest(what, src)
        return dest, f"{what}:{src}", os.path.dirname(dest)   # GAMEUSER= rewritten; other flavour translated
    if arcname.startswith("system/etc-steam-arm/"):
        return None, None, None
    if arcname == "system/etc-h96/display-nolock":
        return None, None, None          # stale SCDC record; restore clears the target's own instead
    if arcname == "system/etc-h96/display-color":
        return DISPLAY_COLOR, "flag_color", "/etc/h96"
    if arcname == "system/etc-h96/display-range":
        return DISPLAY_RANGE, "flag_range", "/etc/h96"
    if arcname == "system/etc-h96/display-frl.off":
        return DISPLAY_FRL_OFF, "root_flag", "/etc/h96"
    if arcname == "system/etc-h96/display-hdmi20.off":
        return DISPLAY_HDMI20_OFF, "root_flag", "/etc/h96"
    if arcname in EMPTY_FLAGS:
        return EMPTY_FLAGS[arcname], "root_flag", "/etc/h96"
    if arcname.startswith("system/etc-h96/display/"):
        name = arcname[len("system/etc-h96/display/"):]
        if not name or "/" in name or not is_display_conf_name(name):
            return None, None, None
        return os.path.join(DISPLAY_DIR, name), "display_conf", DISPLAY_DIR
    if arcname.startswith("system/etc-h96/"):
        return os.path.join("/etc/h96", arcname[len("system/etc-h96/"):]), "root_dir", "/etc/h96"
    if arcname.startswith("vm/"):
        return os.path.join(VM_VAR_ROOT, arcname[len("vm/"):]), "root_dir", VM_VAR_ROOT
    if arcname.startswith("waydroid-data/"):
        rel = arcname[len("waydroid-data/"):]
        return (os.path.join(wdata_base, rel) if rel else wdata_base), "numeric", wdata_base
    if arcname.startswith("waydroid-stash/"):
        parts = arcname.split("/", 2)          # waydroid-stash/<k>/<rest>
        if len(parts) < 2 or parts[1] not in WAYDROID_STASHES: return None, None, None
        base = STASH_DIRS.get(parts[1], WAYDROID_STASHES[parts[1]])
        return (os.path.join(base, parts[2]) if len(parts) == 3 else base), "root_dir", base
    return None, None, None

STEAM_MEMBERS = {"system/etc-h96/steam-arm.conf": ("steam_conf", "h96"),
                 "system/etc-h96/titles.conf": ("steam_titles", "h96"),
                 "system/etc-steam-arm/steam-arm.conf": ("steam_conf", "steam-arm"),
                 "system/etc-steam-arm/titles.conf": ("steam_titles", "steam-arm")}
_BOX_STEAM = []

def box_steam_variant():
    """Steam ARM flavour of this box: 'steam-arm' (2.0), 'h96' (1.2), or None (no Steam ARM route here)."""
    if _BOX_STEAM: return _BOX_STEAM[0]
    try:
        launcher = open("/usr/local/bin/steam-arm", errors="replace").read()
    except OSError:
        launcher = ""
    if STEAM_ARM_CONF in launcher: v = "h96"
    elif SA_CONF in launcher: v = "steam-arm"
    elif os.path.exists(SA_CONF) or os.path.exists(SA_INSTALLER): v = "steam-arm"
    elif os.path.exists(STEAM_ARM_CONF) or os.path.exists(H96_SA_INSTALLER): v = "h96"
    else: v = None
    _BOX_STEAM.append(v)
    return v

def steam_dest(what, src):
    """Path on this box for a Steam ARM settings member of flavour src."""
    dst = box_steam_variant() or src
    if what == "steam_conf":
        return SA_CONF if dst == "steam-arm" else STEAM_ARM_CONF
    return SA_TITLES if dst == "steam-arm" else STEAM_ARM_TITLES

def parse_kv(text):
    """KEY=VALUE lines of a settings file (last one wins, quotes stripped)."""
    out = {}
    for ln in text.splitlines():
        ln = ln.strip()
        if not ln or ln.startswith("#") or "=" not in ln: continue
        k, v = ln.split("=", 1)
        out[k.strip()] = v.strip().strip("'\"")
    return out

def steam_value_ok(key, val):
    """Shared key value safe to write into a settings file the launcher reads as shell."""
    if key == "ARMHOME_DIR":
        return bool(re.fullmatch(r"[A-Za-z0-9._/-]+", val)) and not val.startswith("/") \
            and ".." not in val.split("/")
    if key == "GAMEUSER":
        return bool(re.fullmatch(r"[A-Za-z0-9._@][A-Za-z0-9._@-]*", val))
    if key == "STEAM_ARM_UI":
        return val in ("desktop", "bigpicture", "")
    if key == "GFX_DEFAULT":
        return val in STEAM_GFX_VALUES
    return bool(re.fullmatch(r"[a-z0-9,-]*", val))

def steam_carry_keys(kv, src, dst):
    """Settings keys carried from flavour src to dst (2.0 names); every other key is machine state."""
    keys = list(STEAM_SHARED_KEYS)
    if src == dst == "steam-arm":
        keys += STEAM_OWNER_KEYS_20
        if kv.get("GPU_FAMILY_SET") == "user":   # installer keeps a hand-set GPU family
            keys += ["GPU_FAMILY", "GPU_FAMILY_SET"]
    return keys

def translate_steam_conf(text, src, target_text, user, dst=None):
    """Owner keys of flavour src's settings merged into flavour dst's settings text; target's other keys kept."""
    dst = dst or ("h96" if src == "steam-arm" else "steam-arm")
    to20 = dict(STEAM_KEY_1_2)
    to12 = {v: k for k, v in to20.items()}
    kv = parse_kv(text)
    if src == "h96":
        kv = {to20.get(k, k): v for k, v in kv.items()}
    kv.setdefault("ARMHOME_DIR", STEAM_DEFAULT_HOME[src])
    if user: kv["GAMEUSER"] = user
    keys = steam_carry_keys(kv, src, dst)
    kv = {k: kv[k] for k in keys if k in kv and steam_value_ok(k, kv[k])}
    if dst == "h96":
        kv = {to12.get(k, k): v for k, v in kv.items()}
        keys = [to12.get(k, k) for k in keys]
    out, done = [], set()
    for ln in target_text.splitlines():
        k = ln.split("=", 1)[0].strip() if "=" in ln and not ln.lstrip().startswith("#") else None
        if k in kv:
            if k not in done: out.append(f"{k}={kv[k]}"); done.add(k)
            continue
        out.append(ln)
    out += [f"{k}={kv[k]}" for k in keys if k in kv and k not in done]
    return "\n".join(out) + "\n"

def merge_titles(arch_text, target_text, header):
    """Target titles.conf text plus archive profile lines for titles it lacks; (new_text, added)."""
    def appid(ln):
        f = ln.split()
        return f[0] if f and not ln.lstrip().startswith("#") and f[0].isdigit() else None
    have = {appid(ln) for ln in target_text.splitlines()} - {None}
    add = []
    for ln in arch_text.splitlines():
        a = appid(ln)
        if a and a not in have:
            add.append(ln.strip()); have.add(a)
    base = target_text if target_text.strip() else header
    if base and not base.endswith("\n"): base += "\n"
    return base + "".join(x + "\n" for x in add), len(add)

def read_text(path):
    try:
        return open(path, errors="replace").read()
    except OSError:
        return ""

def restore_steam_member(tf, member, dest, kind, steam_name, mode):
    """Steam ARM settings or game profiles into this box's flavour; True when a file was written."""
    what, src = kind.split(":", 1)
    dst = box_steam_variant() or src
    text = read_member_text(tf, member)
    if what == "steam_conf" and src == dst:
        # owner keys only; this box keeps its own machine state (linger, fstab, account, GPU)
        old = parse_kv(text).get("GAMEUSER")
        new_text = translate_steam_conf(text, src, read_text(dest), steam_name, dst)
        kv0 = parse_kv(text)
        dropped = sorted(k for k in kv0 if (STEAM_KEY_1_2.get(k, k) if src == "h96" else k)
                         not in steam_carry_keys(kv0, src, dst))
        if old and old != steam_name:
            if mode != "auto": print(f"    would rewrite {dest}: GAMEUSER={old} -> GAMEUSER={steam_name}")
            else: info(f"steam-arm.conf: GAMEUSER {old} -> {steam_name}")
        if dropped and mode != "auto":
            print(f"    would leave out source machine state in {dest}: {', '.join(dropped)}")
        return mode == "auto" and write_text_file(dest, new_text, member)
    if what == "steam_conf":
        new_text = translate_steam_conf(text, src, read_text(dest), steam_name)
        msg = f"{STEAM_LABEL[src]} settings -> {STEAM_LABEL[dst]}: {dest} (client folder, account, components)"
        if mode != "auto":
            print(f"    would translate {msg}"); return False
        if write_text_file(dest, new_text, member):
            info(f"translated {msg}"); return True
        return False
    if src == dst:
        return mode == "auto" and write_text_file(dest, text, member)
    # other flavour's profiles: titles missing here are added, none replaced
    new_text, n = merge_titles(text, read_text(dest), STEAM_TITLES_HEADER[dst])
    if not n:
        return False
    if mode != "auto":
        print(f"    would add {n} game profile(s) from {STEAM_LABEL[src]} to {dest}"); return False
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w") as fh:
        fh.write(new_text)
    try:
        os.chown(dest, 0, 0); os.chmod(dest, 0o644)
    except OSError:
        pass
    info(f"added {n} game profile(s) from {STEAM_LABEL[src]} to {dest}")
    return True

def makedirs_as(path, owner_kind, uid, gid):
    """makedirs; directories it creates for user members belong to the desktop user."""
    missing = []
    p = path
    while p and p != "/" and not os.path.isdir(p):
        missing.append(p)
        p = os.path.dirname(p)
    os.makedirs(path, exist_ok=True)
    if owner_kind in ("user", "steamuser"):
        for d in missing:
            try:
                os.chown(d, uid, gid, follow_symlinks=False)
            except OSError:
                pass

def map_home(path, home_map):
    """Old home prefix in an absolute path -> target home."""
    for old, new in home_map:
        if inside(path, old):
            return new + path[len(old.rstrip("/")):]
    return path

def set_owner(path, member, owner_kind, uid, gid, fd=None):
    """Owner and mode by kind; never follows a link; set-id bits dropped."""
    def own(u, g):
        try:
            if fd is not None: os.fchown(fd, u, g)
            else: os.chown(path, u, g, follow_symlinks=False)
        except OSError:
            pass
    def mode(m):
        if fd is not None: os.fchmod(fd, m)
        elif not os.path.islink(path): os.chmod(path, m)
    try:
        if owner_kind in ("user", "steamuser"):
            own(uid, gid)
            if member.isreg(): mode((member.mode & 0o777) or 0o644)
        elif owner_kind == "root":
            own(0, 0); mode(0o600)
        elif owner_kind == "root_dir":
            own(0, 0)
        elif owner_kind == "root_flag":
            own(0, 0); mode(0o644)
        elif owner_kind == "numeric":
            own(member.uid, member.gid)
            if member.isreg(): mode((member.mode & 0o777) or 0o600)
    except OSError:
        pass

def extract_member(tf, member, dest, owner_kind, uid, gid, base, home_map=(), data=None, tdest=None):
    """Write one member to dest with the right owner/mode; True when written. Newer existing
    files are kept; nothing is written through a link that leaves base (or, for user
    trees, a user-owned folder). tdest: restored path of a hard link's target."""
    if not target_ok(os.path.dirname(dest), base, owner_kind, uid):
        warn(f"{member.name}: parent folder on this box leads outside {base}; skipped")
        return False
    try:
        return _extract(tf, member, dest, owner_kind, uid, gid, base, home_map, data, tdest)
    except OSError as e:
        warn(f"{member.name}: {e.strerror or e}; skipped")
        return False

def link_target(member, dest, base, home_map):
    """(link text to write, True when it leads outside base); wine drive links never count as outside."""
    link = map_home(member.linkname, home_map) if member.linkname.startswith("/") else member.linkname
    to = link if link.startswith("/") else os.path.join(os.path.dirname(dest), link)
    return link, not inside(to, base) and not WINE_DRIVE_RE.search(member.name)

def _extract(tf, member, dest, owner_kind, uid, gid, base, home_map, data, tdest):
    if member.isdir():
        if os.path.islink(dest) and not target_ok(dest, base, owner_kind, uid):
            warn(f"{dest} is a link leading outside {base}; folder not restored")
            return False
        makedirs_as(dest, owner_kind, uid, gid)
        if not os.path.islink(dest): set_owner(dest, member, owner_kind, uid, gid)
        return True
    if member.issym():
        if owner_kind not in LINK_KINDS:
            warn(f"{member.name}: symlink in a system folder; skipped")
            return False
        link = member.linkname
        if owner_kind != "numeric":       # Waydroid /data links are Android paths, kept as is
            link, leaves = link_target(member, dest, base, home_map)
            if leaves:
                warn(f"{member.name}: symlink to {member.linkname} leads outside {base}; skipped")
                return False
        makedirs_as(os.path.dirname(dest) or "/", owner_kind, uid, gid)
        if os.path.isdir(dest) and not os.path.islink(dest):
            warn(f"{dest} is a folder on this box; archived symlink skipped")
            return False
        if os.path.lexists(dest): os.unlink(dest)
        os.symlink(link, dest)
        try:
            os.lchown(dest, *((uid, gid) if owner_kind != "numeric" else (member.uid, member.gid)))
        except OSError:
            pass
        return True
    if member.islnk():
        if not tdest or not os.path.isfile(tdest) or os.path.islink(tdest) \
                or not target_ok(tdest, base, "root_dir", 0):
            return False
        makedirs_as(os.path.dirname(dest) or "/", owner_kind, uid, gid)
        if os.path.lexists(dest):
            if os.path.isdir(dest) and not os.path.islink(dest): return False
            os.unlink(dest)
        os.link(tdest, dest)
        return True
    if not member.isreg():
        return False
    if os.path.islink(dest) and not target_ok(dest, base, owner_kind, uid):
        os.unlink(dest)                   # replace a link that leaves base with the archived file
    if os.path.exists(dest) and not FORCE:
        try:
            if os.path.getmtime(dest) > member.mtime + 1:
                warn(f"kept newer {dest} (archive copy not restored)")
                return False
        except OSError:
            pass
    makedirs_as(os.path.dirname(dest) or "/", owner_kind, uid, gid)
    path = os.path.realpath(dest) if os.path.islink(dest) else dest
    if data is None:
        src = tf.extractfile(member)
        if src is None: return False
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW,
                 0o600 if owner_kind == "root" else 0o666)
    with os.fdopen(fd, "wb") as out:
        if data is None: shutil.copyfileobj(src, out)
        else: out.write(data)
        out.flush()
        set_owner(path, member, owner_kind, uid, gid, fd=out.fileno())
    return True

def read_flag_value(tf, member):
    """First stripped line of a small text member, or '' if unreadable."""
    src = tf.extractfile(member)
    if src is None: return ""
    return src.read().decode(errors="replace").strip()

def read_member_text(tf, member):
    """Full decoded text of a small archive member, or '' if unreadable."""
    src = tf.extractfile(member)
    if src is None: return ""
    return src.read().decode(errors="replace")

# A backup never bundles game content (steamapps/common/*); an appmanifest
# restored without it makes Steam show a game as installed when it is not.
# Only restore an appmanifest when the archive also holds real content for
# its installdir -- checked via a separate prescan since tar order can list
# the appmanifest before the common/<installdir>/ content it describes.
APPMANIFEST_RE = re.compile(r"(.*/steamapps/)appmanifest_(\d+)\.acf$")
COMMON_CONTENT_RE = re.compile(r"(.*/steamapps/)common/([^/]+)/")

WP_STATE_PREFIX = "userhome/.local/state/wireplumber/"

def prescan(archive):
    """One pass before the restore: Steam common/ content, EQ members, WirePlumber state, archived autologin user."""
    tf, proc = open_read(archive)
    pre = {"steam_common": set(), "eq_active": False, "eq_state": False, "eq_default": False,
           "wp_state": False, "autologin_user": None}
    try:
        for member in tf:
            n = member.name
            if member_unsafe(member): continue
            m = COMMON_CONTENT_RE.match(n)
            if m and member.isreg():
                pre["steam_common"].add((m.group(1), m.group(2)))
            elif n == "system/etc-h96/eq/active.txt":
                pre["eq_active"] = True
            elif n == "system/etc-h96/eq/state":
                pre["eq_state"] = True
            elif n.startswith(WP_STATE_PREFIX) and member.isreg():
                pre["wp_state"] = True
                if n == WP_DEFAULT_NODES:
                    pre["eq_default"] = f"default.configured.audio.sink={EQ_SINK}" in \
                        [l.strip() for l in read_member_text(tf, member).splitlines()]
            elif n.startswith("system/lightdm/") and member.isreg():
                al = {}
                scan_autologin_settings(read_member_text(tf, member), al)
                if al.get("autologin-user"): pre["autologin_user"] = al["autologin-user"]
    finally:
        tf.close()
        if proc: proc.stdout.close(); proc.wait()
    return pre

def appmanifest_installdir(tf, member):
    """installdir value out of a Steam .acf manifest member, or None."""
    m = re.search(r'"installdir"\s*"([^"]*)"', read_member_text(tf, member))
    return m.group(1) if m else None

def write_text_file(dest, content, member):
    """Write validated text content to dest, 0644 root:root; keeps a newer copy."""
    if os.path.exists(dest) and not FORCE:
        try:
            if os.path.getmtime(dest) > member.mtime + 1:
                warn(f"kept newer {dest} (archive copy not restored)")
                return False
        except OSError:
            pass
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w") as fh:
        fh.write(content)
    try:
        os.chown(dest, 0, 0)
        os.chmod(dest, 0o644)
    except OSError:
        pass
    return True

def write_flag_file(dest, content, member):
    """Write a validated one-line flag file via write_text_file."""
    return write_text_file(dest, content + "\n", member)

def is_display_conf_name(name):
    """True for <key>.conf, key in [A-Za-z0-9_-]+."""
    if not name.endswith(".conf"): return False
    stem = name[:-5]
    return bool(stem) and all(c.isalnum() or c in "_-" for c in stem)

def parse_display_conf(text):
    """Parse a per-display conf: color=/range= checked, other plain key=value lines (hdr=) kept in order; None if invalid."""
    out = {}
    for ln in text.splitlines():
        s = ln.strip()
        if not s or s.startswith("#"): continue
        if "=" not in s: return None
        k, v = (p.strip() for p in s.split("=", 1))
        if k == "color" and v in PER_DISPLAY_COLOR_VALUES: out["color"] = v
        elif k == "range" and v in PER_DISPLAY_RANGE_VALUES: out["range"] = v
        elif k not in ("color", "range") and PER_DISPLAY_KEY_RE.fullmatch(k) \
                and PER_DISPLAY_VAL_RE.fullmatch(v): out[k] = v
        else: return None
    return out

def extract_stash_prepass(archive, home, wdata_base):
    """Lay the Waydroid image stashes onto /etc/waydroid-extra BEFORE init runs,
    so `h96-waydroid init` reuses them offline instead of downloading. Separate
    streaming pass (a streamed tar cannot rewind); only used in auto mode when
    the archive actually bundled the images."""
    tf, proc = open_read(archive)
    n = 0
    for member in tf:
        if not member.name.startswith("waydroid-stash/") or member_unsafe(member) or member.islnk():
            continue
        dest, kind, base = map_dest(member.name, home, wdata_base)
        if dest and extract_member(tf, member, dest, kind, 0, 0, base):
            n += 1
    tf.close()
    if proc: proc.stdout.close(); proc.wait()
    info(f"pre-restored {n} Waydroid image file(s) for offline init")


# ------------------------------------------------------- installer plan ------
def do_desktop(manifest, mode):
    de = manifest.get("desktop", "none")
    pkg = manifest.get("desktop_package")
    if de == "none" or not pkg:
        return
    # Already present? Skip a reinstall.
    try:
        r = subprocess.run(["dpkg-query", "-W", "-f=${Status}", pkg],
                           capture_output=True, text=True)
        present = r.returncode == 0 and "install ok installed" in r.stdout
    except FileNotFoundError:
        present = False   # no dpkg on this host (not the target box)
    if present:
        info(f"desktop {pkg} already installed; skipping")
        return
    step(f"desktop: {de} ({pkg})")
    run(["apt-get", "install", "-y", pkg], dry=(mode != "auto"))

def do_emulators(manifest, mode):
    emus = manifest["features"].get("emulators", [])
    if not emus:
        return
    step(f"emulators: {', '.join(emus)}")
    if not have(EMU_TOOL) and mode == "auto":
        warn(f"{EMU_TOOL} not found; skipping emulator install")
        return
    run([EMU_TOOL, "install"] + emus, dry=(mode != "auto"))

def do_waydroid(manifest, mode, have_stash):
    w = manifest["features"].get("waydroid", {})
    prof = w.get("profile")
    if not prof:
        return
    initarg = PROFILE_TO_INIT.get(prof, "vanilla")
    custom_bundled = have_stash and "custom" in w.get("stashes", [])
    if initarg == "custom" and not custom_bundled:
        step("waydroid: custom image (not in archive)")
        print("    after restore, run: sudo h96-waydroid init custom <folder holding system.img + vendor.img>")
        if have(WAYDROID_TOOL) and not have("waydroid"):
            run([WAYDROID_TOOL, "install"], dry=(mode != "auto"))
        return
    step(f"waydroid: init {initarg}"
         + ("  (stashed images restored from archive)" if have_stash else
            "  (images re-downloaded)"))
    if not have(WAYDROID_TOOL) and mode == "auto":
        warn(f"{WAYDROID_TOOL} not found; skipping waydroid init")
        return
    # A fresh flash ships the h96-waydroid tool but not the waydroid package
    # itself; `init` refuses until `install` has run. Install first when the
    # waydroid binary is absent (the install step is idempotent otherwise).
    if not have("waydroid"):
        run([WAYDROID_TOOL, "install"], dry=(mode != "auto"))
    # Stash images (if bundled) are laid down BEFORE init so init reuses them
    # offline instead of downloading; that extraction happens in the data pass.
    run([WAYDROID_TOOL, "init", initarg] + ([CUSTOM_RESTORE] if initarg == "custom" else []), dry=(mode != "auto"))

def do_widevine(manifest, mode):
    if not manifest["features"].get("widevine"):
        return
    step("widevine: L3 CDM")
    if not have(WIDEVINE_TOOL) and mode == "auto":
        warn(f"{WIDEVINE_TOOL} not found; skipping widevine")
        return
    # h96-widevine-setup has no accept flag; it prompts on a tty, else runs
    # non-interactively. Nothing else to pass.
    run([WIDEVINE_TOOL], dry=(mode != "auto"))

def do_gaming(manifest, mode):
    if not manifest["features"].get("gaming"):
        return
    step("gaming: wine/DXVK stack")
    # Wine (about 100 MB) downloads on first h96-game-mode run as desktop user; not run as root here
    info(f"Wine downloads on first {GAMEMODE_TOOL} run (as desktop user, not sudo)")

def do_npu(manifest, mode):
    if not manifest["features"].get("npu_runtime"):
        return
    step("npu: RKNN runtime")
    if not have(NPU_TOOL) and mode == "auto":
        warn(f"{NPU_TOOL} not found; skipping npu runtime")
        return
    run([NPU_TOOL, "--accept-license"], dry=(mode != "auto"))

def scan_autologin_settings(text, settings):
    """Extract autologin-user/-session/user-session from an archived lightdm [Seat:*] block."""
    in_seat = False
    for ln in text.splitlines():
        s = ln.strip()
        if not s or s.startswith("#"):
            continue
        if s.startswith("["):
            in_seat = s.lower().startswith("[seat")
            continue
        if not in_seat or "=" not in s:
            continue
        k, v = s.split("=", 1)
        k = k.strip().lower()
        if k in ("autologin-user", "autologin-session", "user-session"):
            settings[k] = v.strip()

def apply_autologin(settings, user, mode):
    """Apply autologin-user via one h96-owned lightdm drop-in; never write back the archived lightdm files."""
    if not settings.get("autologin-user"):
        return
    if not os.path.isdir(LIGHTDM_DIR):
        warn("lightdm not installed on this box; autologin setting skipped")
        return
    existing = {}
    try:
        with open(H96_AUTOLOGIN_CONF) as fh:
            scan_autologin_settings(fh.read(), existing)
    except OSError:
        pass
    lines = ["[Seat:*]", f"autologin-user={user}"]
    for k in ("autologin-session", "user-session"):
        v = existing.get(k) or settings.get(k)
        if v:
            lines.append(f"{k}={v}")
    content = "\n".join(lines) + "\n"
    if mode != "auto":
        print(f"    would write: {H96_AUTOLOGIN_CONF}")
        for ln in lines:
            print(f"        {ln}")
        print(f"    would write: {AUTOLOGIN_FLAG}")
        return
    try:
        os.makedirs(os.path.dirname(H96_AUTOLOGIN_CONF), exist_ok=True)
        with open(H96_AUTOLOGIN_CONF, "w") as fh:
            fh.write(content)
        os.chown(H96_AUTOLOGIN_CONF, 0, 0)
        os.chmod(H96_AUTOLOGIN_CONF, 0o644)
        info(f"lightdm: autologin-user={user} via {H96_AUTOLOGIN_CONF}")
    except OSError as e:
        warn(f"could not write {H96_AUTOLOGIN_CONF}: {e}")
        return
    try:   # boot setup then keeps the restored user
        os.makedirs(os.path.dirname(AUTOLOGIN_FLAG), exist_ok=True)
        open(AUTOLOGIN_FLAG, "a").close()
    except OSError as e:
        warn(f"could not write {AUTOLOGIN_FLAG}: {e}")

def steam_client_present(steam_home):
    """The native ARM64 client binary, resolved under the account's
    ACTUAL home on this box (before or after restore, whichever is asked)."""
    return bool(steam_home) and os.path.exists(os.path.join(steam_home, STEAM_CLIENT_BIN))

def resolve_steam_user(manifest, fallback_user, fallback_home, fallback_uid, fallback_gid):
    """(name, home, uid, gid) for the Steam ARM account, nested under its recorded ARMHOME_DIR; falls back to the desktop user if that account is missing."""
    steam = manifest.get("features", {}).get("steam_arm", {})
    name = steam.get("user")
    armhome_dir = steam.get("armhome_dir") or ".local/share/steam-arm"
    if name:
        try:
            pw = pwd.getpwnam(name)
            return name, os.path.join(pw.pw_dir, armhome_dir), pw.pw_uid, pw.pw_gid
        except KeyError:
            warn(f"Steam ARM account '{name}' not found on this box yet; "
                 f"restoring its home under '{fallback_user}' instead")
    return fallback_user, os.path.join(fallback_home, armhome_dir), fallback_uid, fallback_gid

def apply_services(manifest, mode):
    """Enable each opt-in service recorded on; image-enabled units recorded off are switched off; unmentioned units untouched."""
    services = manifest.get("features", {}).get("services", {})
    for s in RETIRED_SERVICES:
        if services.get(s) is True:
            info(f"{s}: archive has it on, but pinhole loader mode does not ship; skipped")
    on = [s for s in OPT_IN_SERVICES if services.get(s) is True]
    for unit, cmd in IMAGE_ON_SERVICES.items():
        if services.get(unit) is False:
            apply_service_off(unit, cmd, mode)
    if not on:
        return
    step(f"opt-in services: {', '.join(on)}")
    for unit in on:
        if mode != "auto":
            print(f"    would run: systemctl enable {unit}"); continue
        r = subprocess.run(["systemctl", "list-unit-files", unit],
                           capture_output=True, text=True)
        if unit not in r.stdout:
            warn(f"{unit} not installed on this box; skipped"); continue
        subprocess.run(["systemctl", "enable", unit], stdout=subprocess.DEVNULL)
        info(f"enabled {unit}")

def apply_service_off(unit, cmd, mode):
    """Archive recorded an image-enabled unit off: switch it off through its own tool."""
    step(f"{unit}: off (recorded off in archive)")
    if mode != "auto":
        print(f"    would run: {' '.join(cmd)}"); return
    r = subprocess.run(["systemctl", "is-enabled", unit], capture_output=True, text=True)
    if r.stdout.strip() not in ("enabled", "enabled-runtime"):
        info(f"{unit} already off or not installed"); return
    argv = cmd if have(cmd[0]) else ["systemctl", "disable", unit]
    subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    info(f"{unit} off via {' '.join(argv)}")

def apply_wol(manifest, mode):
    """Set WoL to match the archive's recorded state; no-op when the archive has none."""
    state = manifest.get("features", {}).get("wol")
    if state not in ("on", "off"):
        return
    step(f"wake-on-LAN: {state}")
    if mode != "auto":
        print(f"    would run: h96-wol {state}"); return
    if not have("h96-wol"):
        warn("h96-wol not installed on this box; skipped"); return
    subprocess.run(["h96-wol", state], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def npu_power_detail(npu):
    """Short text for the plan: follow flag and a user-set governor."""
    if not npu: return ""
    gov = npu.get("governor") if npu.get("user_set") else None
    return f" npu_follow={'on' if npu.get('follow') else 'off'} npu_governor={gov or 'image default'}"

def apply_npu_power(manifest, mode):
    """Re-apply a user-set NPU governor and follow mode via h96-npu; never turns follow on unless recorded on."""
    npu = manifest.get("features", {}).get("npu_power") or {}
    gov = npu.get("governor") if npu.get("user_set") else None
    follow = npu.get("follow") is True
    if not gov and not follow:
        return
    prof = NPU_GOVERNOR_PROFILE.get(gov) if gov else None
    step("npu power: " + ", ".join(x for x in (f"profile {prof}" if prof else "",
                                                 "follow on" if follow else "") if x))
    if gov and not prof:
        warn(f"NPU governor '{gov}' was set outside h96-npu; not restored")
    cmds = ([[NPU_TOOL_CMD, "power", prof]] if prof else []) + ([[NPU_TOOL_CMD, "power", "sync", "on"]] if follow else [])
    if mode != "auto":
        for c_ in cmds: print("    would run: " + " ".join(c_))
        return
    if not have(NPU_TOOL_CMD):
        warn(f"{NPU_TOOL_CMD} not installed on this box; NPU power skipped"); return
    for c_ in cmds:
        subprocess.run(c_, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    info("NPU power restored")

def apply_hdr(manifest, mode):
    """Turn h96-hdr on in the recorded mode; never turns it off, no-op when the archive has it off."""
    hdr = manifest.get("features", {}).get("mpv_hdr")
    if not hdr:
        return
    if hdr in HDR_TRANSLATE:
        info(f"mpv HDR {hdr} recorded: applied as {HDR_TRANSLATE[hdr]} (HDR10 output: h96-hdr play)")
        hdr = HDR_TRANSLATE[hdr]
    if hdr not in HDR_MODES:
        info(f"mpv HDR mode '{hdr}' was hand-edited on the source; not restored"); return
    step(f"mpv HDR: {hdr}")
    if mode != "auto":
        print(f"    would run: {HDR_TOOL} {hdr}"); return
    if not have(HDR_TOOL):
        warn(f"{HDR_TOOL} not installed on this box; skipped"); return
    subprocess.run([HDR_TOOL, hdr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    info(f"mpv HDR {hdr} via {HDR_TOOL}")

def passthrough_value(manifest):
    """Validated passthrough block (tool 2.5 archive), or None when absent or nothing on."""
    pt = manifest.get("features", {}).get("audio_passthrough")
    if not isinstance(pt, dict):
        return None
    mode = pt.get("mode") if pt.get("mode") in PT_MODES else "off"
    codecs = pt.get("codecs_on") is True
    if mode == "off" and not codecs:
        return None
    dev = pt.get("device")
    return {"codecs_on": codecs, "mode": mode,
            "channels": pt.get("channels") if pt.get("channels") in PT_CHANNELS else None,
            "device": dev if isinstance(dev, str) and PT_DEVICE_RE.fullmatch(dev) else None}

def pt_device_here(dev):
    """Recorded ALSA device when this box lists it, else None (the tool picks one)."""
    if not dev or not have("aplay"):
        return None
    try:
        r = subprocess.run(["aplay", "-L"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    return dev if dev in [l.strip() for l in r.stdout.splitlines() if l and not l[0].isspace()] else None

def pt_codecs_opt_in():
    """True when this box's tool has the compressed codecs opt-in (v7.1 and later)."""
    path = shutil.which(PT_TOOL)
    try:
        return bool(path) and PT_CODECS_ON.encode() in open(path, "rb").read()
    except OSError:
        return False

def pt_run(argv):
    """Run the passthrough tool, output indented; returns the exit code."""
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for l in r.stdout.splitlines():
        print("    " + l)
    return r.returncode

def apply_passthrough(manifest, mode):
    """Re-apply recorded passthrough choices through the tool; refused or older tool leaves it off."""
    pt = passthrough_value(manifest)
    if not pt:
        return
    step(f"audio passthrough: {pt['mode']}" + (", compressed codecs on" if pt["codecs_on"] else ""))
    m, ch = pt["mode"], pt["channels"]
    if mode != "auto":
        if pt["codecs_on"]: print(f"    would run: {PT_TOOL} codecs on")
        if m == "lpcm": print(f"    would run: {PT_TOOL} lpcm {shlex.quote(pt['device'] or '')} {ch or ''}".rstrip())
        if m == "bitstream": print(f"    would run: {PT_TOOL} bitstream")
        return
    if not have(PT_TOOL):
        warn(f"{PT_TOOL} not installed on this box; passthrough left off"); return
    codecs = False
    if pt["codecs_on"]:
        if not pt_codecs_opt_in():
            info(f"{PT_TOOL} on this box has no compressed codecs opt-in; codecs left off")
        else:
            codecs = pt_run([PT_TOOL, "codecs", "on"]) == 0 and os.path.exists(PT_CODECS_ON)
            if not codecs:
                info("compressed codecs refused on this box (kernel without passthrough support); left off")
    if m == "bitstream":
        if codecs and pt_run([PT_TOOL, "bitstream"]) == 0:
            info("audio passthrough: bitstream restored"); return
        info("bitstream not available on this box; passthrough left off "
             f"(multichannel PCM: sudo {PT_TOOL} lpcm)")
        return
    if m == "lpcm":
        dev = pt_device_here(pt["device"])
        argv = [PT_TOOL, "lpcm"] + ([dev or ""] if dev or ch else []) + ([ch] if ch else [])
        if pt_run(argv) == 0:
            info(f"audio passthrough: lpcm {ch or ''}".rstrip() + " restored")
        else:
            warn("lpcm refused on this box; passthrough left off")

def apply_hdmi20(manifest, mode):
    """Stop h96-scdc and re-detect when the archive recorded hdmi20 scrambling off; never re-enables it."""
    if not manifest.get("features", {}).get("display", {}).get("hdmi20_off"):
        return
    step("hdmi 2.0 scrambling: off (applying live)")
    if mode != "auto":
        print("    would run: systemctl stop h96-scdc.service; h96-display detect --quiet")
        return
    subprocess.run(["systemctl", "stop", "h96-scdc.service"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if have("h96-display"):
        subprocess.run(["h96-display", "detect", "--quiet"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        info("h96-scdc stopped; display re-detected")
    else:
        warn("h96-display not installed on this box; mode list not re-detected")

def clear_nolock(mode):
    """Clear the target's own stale SCDC lock-failed record; never carried forward from the archive."""
    if not os.path.exists(DISPLAY_NOLOCK):
        return
    step("clearing stale SCDC lock-failed record")
    if mode != "auto":
        print(f"    would remove: {DISPLAY_NOLOCK}")
        return
    try:
        os.remove(DISPLAY_NOLOCK)
        info(f"removed {DISPLAY_NOLOCK}")
    except OSError as e:
        warn(f"could not remove {DISPLAY_NOLOCK}: {e}")

def migrate_hdmi_sink(home, mode):
    """Rewrite a v6.1-era HDMI sink node name in the restored WirePlumber
    state, if h96-hdmi-sink-migrate.sh is installed on this box."""
    if mode != "auto" or not os.path.exists(HDMI_SINK_MIGRATE):
        if mode != "auto":
            print(f"    would run: {HDMI_SINK_MIGRATE} {home}")
        return
    subprocess.run(["bash", HDMI_SINK_MIGRATE, home],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def apply_eq(pre, mode):
    """Pre-v7.0 EQ (active.txt read by PipeWire) -> h96-audio-eq inline layout. Archives without
    an EQ state file turn EQ on only when the EQ sink was the archived default output; True when run."""
    try:
        if b"migrate)" not in open(EQ_TOOL, "rb").read():
            return False                # pre-v7.0 tool: active.txt is still its own format
    except OSError:
        return False
    act, state, was_default = pre["eq_active"], pre["eq_state"], pre["eq_default"]
    if not act and not state:
        return False
    argv = [EQ_TOOL, "migrate", "--no-restart"]
    if not state:
        argv += ["--enabled", "yes" if was_default else "no"]
    step("EQ: " + ("pre-v7.0 active.txt -> inline filters" if act else "regenerating config from state"))
    if mode != "auto":
        print("    would run: " + " ".join(argv)); return True
    r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for l in r.stdout.splitlines():
        print("    " + l)
    if r.returncode:
        warn(f"h96-audio-eq migrate failed ({r.returncode}); run 'sudo h96-audio-eq migrate' after login")
    return True

