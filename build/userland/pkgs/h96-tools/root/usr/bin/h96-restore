MOVES_80 = {}
PACKAGED_ROOTS = ("/usr", "/opt", "/bin", "/sbin", "/lib")
PATH_TOKEN_RE = re.compile(rb"/[A-Za-z0-9_.@+-][A-Za-z0-9_./@+-]*")

def translate_paths_80(data):
    """(new_bytes, hits): v7.2 program paths -> 8.0 paths present here (old path absent); binary untouched."""
    if not PATH_MOVES_80 or b"\x00" in data:
        return data, 0
    if not MOVES_80:
        MOVES_80.update((os.fsencode(a), os.fsencode(b)) for a, b in PATH_MOVES_80)
    hits = 0
    def sub(mo):
        nonlocal hits
        tok = mo.group(0)
        core = tok.rstrip(b"./")
        p = core
        while p.count(b"/") > 1:
            new = MOVES_80.get(p)
            if new is not None:
                full = new + core[len(p):]
                if os.path.lexists(os.fsdecode(full)) and not os.path.lexists(os.fsdecode(core)):
                    hits += 1
                    return full + tok[len(core):]
                break
            p = p.rsplit(b"/", 1)[0]
        return tok
    return PATH_TOKEN_RE.sub(sub, data), hits

def home_pairs(manifest, pre, home, steam_home):
    """[(old_home, new_home)]: manifest home (2.4+), else archived autologin user's home; plus Steam account."""
    out = []
    old = manifest.get("home") or (f"/home/{pre['autologin_user']}" if pre.get("autologin_user") else None)
    if old and old.startswith("/") and os.path.normpath(old) not in ("/", os.path.normpath(home)):
        out.append((os.path.normpath(old), os.path.normpath(home)))
    steam = manifest.get("features", {}).get("steam_arm", {})
    su, rel = steam.get("user"), (steam.get("armhome_dir") or "").strip("/")
    if su and rel and steam_home and not (steam.get("armhome_dir") or "").startswith("/") \
            and steam_home.endswith("/" + rel):
        new_acct = steam_home[:-len(rel) - 1]
        if f"/home/{su}" != new_acct and all(o != f"/home/{su}" for o, _ in out):
            out.append((f"/home/{su}", new_acct))
    return out

def rewrite_home_text(data, pairs):
    """(new_bytes, hits): old home prefixes replaced in a text file; binary data untouched."""
    if not pairs or b"\x00" in data:
        return data, 0
    hits = 0
    for old, new in pairs:
        rx = re.compile(re.escape(old.encode()) + rb"(?=[/\s\"'=:;,]|$)", re.M)
        data, n = rx.subn(new.encode(), data)
        hits += n
    return data, hits

STEAM_TEXT_RE = re.compile(r"steamhome/\.local/share/Steam/(config/[^/]+|steamapps/libraryfolders)\.vdf$")

def home_text_member(member, kind):
    """Text members whose old home paths are rewritten: ~/.config files, Steam library and config .vdf."""
    if not member.isreg() or member.size > HOME_TEXT_MAX: return False
    return (kind == "user" and member.name.startswith(HOME_TEXT_PREFIX)) or \
        (kind == "steamuser" and bool(STEAM_TEXT_RE.match(member.name)))

# -- 2.4: user audio services (linger keeps them running across logout) -----
AUDIO_UNITS = ("filter-chain.service", "wireplumber.service")

def user_manager(uid):
    """True when the desktop user's systemd manager runs (session or linger)."""
    return uid is not None and os.path.exists(f"/run/user/{uid}/bus") and have("runuser")

def user_systemctl(user, uid, *args):
    """systemctl --user for the desktop user from root; None when that user has no running manager."""
    if not user_manager(uid):
        return None
    argv = ["runuser", "-u", user, "--", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
            f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus", "systemctl", "--user"] + list(args)
    return subprocess.run(argv, capture_output=True, text=True)

def audio_units(sel, pre):
    """User audio units whose state this restore replaces."""
    units = []
    if "system" in sel and (pre["eq_active"] or pre["eq_state"]): units.append("filter-chain.service")
    if "configs" in sel and pre["wp_state"]: units.append("wireplumber.service")
    return units

def audio_stop(user, uid, units):
    """Stop the user's running audio units before their state is replaced; returns the stopped ones."""
    stopped = []
    for u in units:
        r = user_systemctl(user, uid, "is-active", u)
        if r is None: return []
        if r.stdout.strip() == "active":
            user_systemctl(user, uid, "stop", u); stopped.append(u)
    if stopped: info(f"audio: stopped {', '.join(stopped)} for {user} (restored state loads on start)")
    return stopped

def audio_start(user, uid, stopped):
    for u in AUDIO_UNITS:
        if u in stopped:
            user_systemctl(user, uid, "start", u)
    if stopped: info(f"audio: started {', '.join(stopped)} for {user}")

def linger_on(user):
    return os.path.exists(f"/var/lib/systemd/linger/{user}")

# --------------------------------------------------------------- main --------
def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help", "help") for a in args):
        print(HELP); return
    if any(a in ("-v", "--version") for a in args):
        print(f"h96-restore v{TOOL_VERSION}"); return
    if "--list" in args:
        list_archives(find_archives()); return

    global FORCE
    mode = "auto"     # auto | open
    dry = False
    archive = None
    only, skip, emu_filter, want_plan = None, [], None, False
    it_args = iter(args)
    for a in it_args:
        if a == "--open":     mode = "open"
        elif a == "--dry-run": dry = True
        elif a == "--force":   FORCE = True
        elif a == "--plan-json": want_plan = True
        elif a == "--list":      pass
        elif a.startswith("--only="):      only = parse_categories(a[7:], "--only")
        elif a == "--only":                only = parse_categories(next(it_args, ""), "--only")
        elif a.startswith("--skip="):      skip = parse_categories(a[7:], "--skip")
        elif a == "--skip":                skip = parse_categories(next(it_args, ""), "--skip")
        elif a.startswith("--emulators="): emu_filter = [x.strip() for x in a[12:].split(",") if x.strip()]
        elif a == "--emulators":           emu_filter = [x.strip() for x in next(it_args, "").split(",") if x.strip()]
        elif a.startswith("-"): die(f"unknown option '{a}' (see --help)")
        elif archive is None:  archive = a
        else:                  die("only one archive may be given")
    if not archive:
        # Nothing named. On a terminal, offer what is on the box rather than
        # making the path a guessing game; anywhere else, print the usage.
        if sys.stdin.isatty() and sys.stdout.isatty() and not want_plan:
            archive = choose_archive()
            if not archive:
                print("nothing chosen; nothing was changed.")
                return
            # elevate() re-runs this tool with sys.argv[1:]; without the choice
            # in there, the prompt would come back a second time under sudo.
            sys.argv.insert(1, archive)
        else:
            die("usage: h96-restore <archive|folder> [--open] [--dry-run] [--force] "
                "[--only a,b] [--skip a,b] [--emulators x,y] [--plan-json] [--list]")
    archive = resolve_archive(archive)
    sel = set(c for c in CATEGORIES if (only is None or c in only) and c not in skip
              and (c not in OPT_IN_CATEGORIES or (only is not None and c in only)))

    if want_plan:
        check_archive(archive, to_stderr=True)   # stdout stays pure JSON (GUI reads it)
        print(json.dumps(plan_json(archive), indent=2)); return

    # dry-run needs no privilege; a real restore does.
    if not dry:
        elevate()
    banner("R E S T O R E")
    check_archive(archive)

    # after elevate() (which re-execs the process): computed once, not twice.
    pre = prescan(archive) if sel & {"gaming", "configs", "system"} else \
        {"steam_common": set(), "eq_active": False, "eq_state": False, "eq_default": False,
         "wp_state": False, "autologin_user": None}
    steam_common = pre["steam_common"]

    user = desktop_user()
    home = user_home(user)
    try:
        pw = pwd.getpwnam(user)
        uid, gid = pw.pw_uid, pw.pw_gid
    except KeyError:
        uid = gid = None
    wdata_base = os.path.join(home, ".local/share/waydroid/data")

    # ---- read manifest (first member of the stream) ------------------------
    tf, proc = open_read(archive)
    it = iter(tf)
    try:
        first = next(it)
    except StopIteration:
        die("archive is empty")
    if first.name != "manifest.json":
        die(f"not an h96-backup archive (first member is '{first.name}', "
            "expected manifest.json)")
    manifest = json.loads(tf.extractfile(first).read().decode())
    if manifest.get("schema") not in (1, 2, 3):
        warn(f"archive schema {manifest.get('schema')} not recognised (attempting anyway)")

    apply_selection(manifest, sel, emu_filter)
    feats = manifest["features"]
    w = feats.get("waydroid", {})
    if w.get("profile") == "custom":
        STASH_DIRS["custom"] = CUSTOM_RESTORE
    have_stash = w.get("images_included") and bool(w.get("stashes"))
    steam = feats.get("steam_arm", {})
    # Resolved unconditionally: steam-arm.conf's GAMEUSER= is remapped to this
    # user even on a run that excludes the "gaming" category (no home copied).
    steam_name, steam_home, steam_uid, steam_gid = resolve_steam_user(manifest, user, home, uid, gid)
    # true once the client program will actually be there: already on this box
    # (independently installed, or a previous restore), or bundled this time
    steam_client_ready = bool(steam.get("home_included")) and (
        steam.get("runtime_included") or steam_client_present(steam_home))
    src_version = manifest.get("source_version", "unknown")
    src_tool_version = manifest.get("tool_version", "unknown")
    pairs = home_pairs(manifest, pre, home, steam_home) if sel & {"configs", "gaming"} else []

    # ---- report the plan ---------------------------------------------------
    info(f"archive : {archive}   (h96-backup v{src_tool_version} on this restore v{TOOL_VERSION})")
    info(f"created : {manifest.get('created', '?')}   source version: {src_version}")
    info(f"target user : {user}   (HOME {home})")
    info(f"mode    : {'DRY-RUN' if dry else mode.upper()}"
         + (" + FORCE" if FORCE else ""))
    if sel != set(CATEGORIES) - set(OPT_IN_CATEGORIES):
        info(f"categories : {', '.join(c for c in CATEGORIES if c in sel) or '(none)'}")
    if emu_filter is not None:
        info(f"emulators  : limited to {', '.join(emu_filter) or '(none)'}")
    print()
    step("plan")
    print(f"  desktop     : {manifest.get('desktop')} ({manifest.get('desktop_package')})")
    print(f"  emulators   : {', '.join(feats.get('emulators', [])) or '(none)'}")
    print(f"  waydroid    : profile={w.get('profile') or '(none)'} "
          f"data={'yes' if w.get('data') else 'no'} "
          f"images={'bundled' if have_stash else 'redownload'}")
    print(f"  widevine    : {feats.get('widevine')}")
    print(f"  gaming      : {feats.get('gaming')}"
          + (f"  (+ Steam ARM home under {steam_name}"
             + (", Proton prefixes bundled" if steam.get("proton_prefixes_included") else "")
             + (", client runtime bundled" if steam.get("runtime_included") else "")
             + ")" if steam.get("home_included") else ""))
    if steam.get("home_included") and not steam_client_ready:
        print("  note: Steam ARM client program will NOT be on this box after this restore "
              "(it was excluded from the archive to save space). After restoring, run:")
        print("          sudo h96-steam install --keep")
        print("        (or: sudo h96-steam install emulated --keep, for the x86/FEX route)")
        print("        This tool never launches Steam itself.")
    print(f"  npu runtime : {feats.get('npu_runtime')}")
    print(f"  wifi confs  : {feats.get('wifi')}")
    display = feats.get("display", {}); services = feats.get("services", {}); wol = feats.get("wol")
    on_svcs = [s for s in OPT_IN_SERVICES if services.get(s) is True]
    print(f"  display     : hdmi20_off={display.get('hdmi20_off', False)} frl_off={display.get('frl_off', False)} "
          f"color={display.get('color') or 'rgb'} range={display.get('range') or 'full'} "
          f"per_display={len(display.get('per_display', {}))} "
          f"nolock={display.get('nolock', False)} (cleared on target, not restored)"
          + ("  (hdmi-sink.json is never restored; run 'h96-display detect' after)" if "system" in sel else ""))
    print(f"  services on : {', '.join(on_svcs) or '(none)'}   wol : "
          f"{wol or ('not selected (--only wol)' if 'wol' not in sel else '(unset)')}")
    npu_power = feats.get("npu_power") or {}
    print(f"  npu power   : follow={'on' if npu_power.get('follow') else 'off'} "
          f"governor={(npu_power.get('governor') if npu_power.get('user_set') else None) or 'image default (left alone)'}"
          f"   mpv hdr : {feats.get('mpv_hdr') or 'off (left alone)'}")
    pt = passthrough_value(manifest)
    print("  passthrough : " + (f"{pt['mode']} channels={pt['channels'] or '-'} codecs={'on' if pt['codecs_on'] else 'off'}"
                                if pt else "off (left alone)"))
    vm = feats.get("vm", {})
    print(f"  h96-vm      : {', '.join(vm.get('names', [])) or '(none)'}"
          + ("  (disk images bundled)" if vm.get("disks_included") else "  (definitions only)" if vm.get("names") else ""))
    if w.get("profile") and not have_stash:
        print("  note: Waydroid images not in archive; init will re-download "
              f"(~{'5 GB' if w.get('profile') == 'gpu' else '900 MB'}).")
    if pre_v62(manifest):
        print("  note: h96-edid-adapt from " + (src_version if src_version != "unknown" else "a v6.1 or older archive")
              + " is retired on v6.2; not restored.")
    for old, new in pairs:
        print(f"  home paths  : {old} -> {new} (config text files and symlinks)")

    # ---- installers --------------------------------------------------------
    print()
    if mode == "open" and not dry:
        step("OPEN MODE: run these installer commands yourself, then this tool "
             "restores your data")
    do_desktop(manifest, "open" if mode == "open" else ("dry" if dry else "auto"))
    inst_mode = "dry" if dry else mode
    do_emulators(manifest, inst_mode)
    # Auto mode runs init itself, so images must be on disk first. Open mode
    # leaves init to the user; its stash is restored in the data pass below,
    # before the user runs init manually.
    stash_prepassed = False
    if mode == "auto" and not dry and have_stash and have(WAYDROID_TOOL):
        extract_stash_prepass(archive, home, wdata_base)
        stash_prepassed = True
    do_waydroid(manifest, inst_mode, have_stash)
    do_widevine(manifest, inst_mode)
    do_gaming(manifest, inst_mode)
    do_npu(manifest, inst_mode)
    if "wol" in sel:
        apply_wol(manifest, inst_mode)
    if "system" in sel:
        apply_services(manifest, inst_mode)
        apply_hdmi20(manifest, inst_mode)
        clear_nolock(inst_mode)
        apply_npu_power(manifest, inst_mode)
        apply_hdr(manifest, inst_mode)
        if inst_mode != "auto":
            apply_passthrough(manifest, inst_mode)   # auto mode: after the data restore

    if dry:
        # Consume nothing more; the stream is closed below.
        step("data restore (dry-run: nothing written)")
        # Summarised by category. Listing every path put thousands of lines on
        # the terminal and buried the part worth reading.
        SAMPLE = 6
        skipped = 0
        appmanifests_total = appmanifests_skipped = 0
        counts = {c: [0, 0, []] for c in CATEGORIES}   # files, bytes, samples
        autologin_settings = {}
        refused = rewritten = moved80 = netplan_files = 0
        for member in it:
            why = member_unsafe(member)
            if why:
                warn(f"{member.name!r}: {why}; would be skipped"); refused += 1; continue
            cat, emu = member_category(member.name)
            if cat not in sel or (emu and emu_filter is not None and emu not in emu_filter):
                skipped += 1; continue
            if cat == "gaming":
                m = APPMANIFEST_RE.match(member.name)
                if m and member.isreg():
                    appmanifests_total += 1
                    installdir = appmanifest_installdir(tf, member)
                    if not installdir or (m.group(1), installdir) not in steam_common:
                        appmanifests_skipped += 1
                        continue
            if member.name.startswith("system/lightdm/"):
                if member.isreg():
                    src = tf.extractfile(member)
                    if src is not None:
                        scan_autologin_settings(src.read().decode(errors="replace"), autologin_settings)
                continue
            dest, kind, base = map_dest(member.name, home, wdata_base, steam_home)
            if dest and member.issym() and kind not in LINK_KINDS:
                warn(f"{member.name}: symlink in a system folder; would be skipped"); refused += 1; continue
            if dest and member.issym() and kind != "numeric" and link_target(member, dest, base, pairs)[1]:
                warn(f"{member.name}: symlink to {member.linkname} leads outside {base}; would be skipped")
                refused += 1; continue
            if dest and member.isreg() and member.name.startswith("wifi-netplan/"):
                netplan_files += 1
            if not dest or not member.isreg():
                if not dest and not member.isdir() and member.name.startswith("system/etc-h96/display/"):
                    warn(f"{member.name}: unexpected name in archive display/ folder; would be skipped")
                continue
            if home_text_member(member, kind):
                text = tf.extractfile(member).read()
                rewritten += rewrite_home_text(text, pairs)[1] > 0
                moved80 += translate_paths_80(text)[1] > 0
            if kind in ("flag_color", "flag_range"):
                valid = DISPLAY_COLOR_VALUES if kind == "flag_color" else DISPLAY_RANGE_VALUES
                val = read_flag_value(tf, member)
                if val not in valid:
                    warn(f"{dest}: invalid value '{val}' in archive (want {'/'.join(valid)}); would be skipped")
                    continue
            if kind == "display_conf":
                if parse_display_conf(read_flag_value(tf, member)) is None:
                    warn(f"{dest}: invalid content in archive; would be skipped")
                    continue
            if member.name in EMPTY_FLAGS and member.size != 0:
                warn(f"{dest}: flag file not empty in archive; would be skipped")
                continue
            if kind.startswith(("steam_conf:", "steam_titles:")):
                restore_steam_member(tf, member, dest, kind, steam_name, "dry")
            row = counts[cat]
            row[0] += 1
            row[1] += member.size
            if len(row[2]) < SAMPLE:
                row[2].append(dest)
        total = sum(r[0] for r in counts.values())
        for cat in CATEGORIES:
            files, size, samples = counts[cat]
            if not files:
                continue
            print(f"    {cat:<16} {files:>6} file(s)  {human(size):>9}")
            for d in samples:
                print(f"        {d}")
            if files > len(samples):
                print(f"        ... and {files - len(samples)} more")
        if autologin_settings.get("autologin-user"):
            print(f"    {'autologin':<16} {'1 setting':>6}  (via one h96 drop-in, not raw file copy)")
            apply_autologin(autologin_settings, user, "dry")
        total_incl_autologin = total + (1 if autologin_settings.get("autologin-user") else 0)
        if not total_incl_autologin:
            print("    (no data members in the selected categories)")
        else:
            print(f"    {total_incl_autologin} file(s) would be written in total")
        if skipped:
            print(f"    ({skipped} member(s) outside the selected categories skipped)")
        if refused:
            print(f"    ({refused} unsafe member(s) refused)")
        if rewritten:
            print(f"    {rewritten} config file(s) would get old home paths rewritten")
        if moved80:
            print(f"    {moved80} config file(s) would get earlier program paths changed to 8.0 paths")
        if netplan_files:
            print("    would run: netplan generate")
        if appmanifests_total:
            print(f"    {appmanifests_skipped} game install record(s) skipped "
                  "(game files not in archive; reinstall from Steam)")
        if "configs" in sel:
            migrate_hdmi_sink(home, "dry")
        if "system" in sel:
            apply_eq(pre, "dry")
        if user_manager(uid) and audio_units(sel, pre):
            print(f"    would restart {', '.join(audio_units(sel, pre))} for {user} around the data restore")
        tf.close()
        if proc: proc.stdout.close(); proc.wait()
        ok("\ndry-run complete: nothing was changed.")
        return

    # ---- passive data restore (auto AND open) ------------------------------
    print()
    step("restoring passive data (configs, wifi, saves, /data)")
    if uid is None:
        warn(f"desktop user '{user}' has no passwd entry; user files left root-owned")
    restored = moved80 = 0
    wifi_net = {"wifi-nm/": 0, "wifi-netplan/": 0}
    autologin_settings = {}
    appmanifests_total = appmanifests_skipped = 0
    audio_stopped = audio_stop(user, uid, audio_units(sel, pre))
    for member in it:
        # stash already laid down in the auto-mode pre-pass; do not redo it
        if stash_prepassed and member.name.startswith("waydroid-stash/"):
            continue
        why = member_unsafe(member)
        if why:
            warn(f"{member.name!r}: {why}; skipped"); continue
        cat, emu = member_category(member.name)
        if cat not in sel or (emu and emu_filter is not None and emu not in emu_filter):
            continue
        if cat == "gaming":
            m = APPMANIFEST_RE.match(member.name)
            if m and member.isreg():
                appmanifests_total += 1
                installdir = appmanifest_installdir(tf, member)
                if not installdir or (m.group(1), installdir) not in steam_common:
                    appmanifests_skipped += 1
                    continue
        if member.name.startswith("system/lightdm/"):
            if member.isreg():
                src = tf.extractfile(member)
                if src is not None:
                    scan_autologin_settings(src.read().decode(errors="replace"), autologin_settings)
            continue
        dest, kind, base = map_dest(member.name, home, wdata_base, steam_home)
        if not dest:
            if not member.isdir() and member.name.startswith("system/etc-h96/display/"):
                warn(f"{member.name}: unexpected name in archive display/ folder; skipped")
            continue
        if kind in ("flag_color", "flag_range") and member.isreg():
            valid = DISPLAY_COLOR_VALUES if kind == "flag_color" else DISPLAY_RANGE_VALUES
            val = read_flag_value(tf, member)
            if val not in valid:
                warn(f"{dest}: invalid value '{val}' in archive (want {'/'.join(valid)}); skipped")
                continue
            if write_flag_file(dest, val, member):
                restored += 1
            continue
        if member.name in EMPTY_FLAGS and member.isreg() and member.size != 0:
            warn(f"{dest}: flag file not empty in archive; skipped")
            continue
        if kind == "display_conf" and member.isreg():
            parsed = parse_display_conf(read_flag_value(tf, member))
            if parsed is None:
                warn(f"{dest}: invalid content in archive; skipped")
                continue
            content = "".join(f"{k}={v}\n" for k, v in parsed.items())
            if write_text_file(dest, content, member):
                restored += 1
            continue
        if kind.startswith(("steam_conf:", "steam_titles:")):
            if member.isreg() and restore_steam_member(tf, member, dest, kind, steam_name, "auto"):
                restored += 1
            continue
        if kind.startswith(("flag_", "steam_", "display_")) or (member.name in EMPTY_FLAGS and not member.isreg()):
            continue                      # validated members only; links or folders there are not restored
        tdest = map_dest(member.linkname, home, wdata_base, steam_home)[0] if member.islnk() else None
        data = None
        if home_text_member(member, kind):
            src = tf.extractfile(member)
            data, n80 = translate_paths_80(rewrite_home_text(src.read() if src else b"", pairs)[0])
            moved80 += n80 > 0
        if kind == "steamuser":
            done = extract_member(tf, member, dest, "steamuser", steam_uid or 0, steam_gid or 0,
                                  base, pairs, data, tdest)
        else:
            if kind == "user" and uid is None:
                kind = "root_dir"
            done = extract_member(tf, member, dest, kind, uid or 0, gid or 0, base, pairs, data, tdest)
        restored += bool(done)
        if done and member.isreg():
            for k in wifi_net:
                if member.name.startswith(k): wifi_net[k] += 1
    tf.close()
    if proc: proc.stdout.close(); proc.wait()
    apply_autologin(autologin_settings, user, "auto")

    # v6.1-era HDMI sink name -> current ACP name, in the restored WirePlumber state
    if "configs" in sel:
        migrate_hdmi_sink(home, "auto")
    # pre-v7.0 EQ file -> inline layout (after configs, so the archived default sink is known)
    if "system" in sel:
        apply_eq(pre, "auto")
    audio_start(user, uid, audio_stopped)
    if wifi_net["wifi-netplan/"]:
        if have("netplan"):
            r = subprocess.run(["netplan", "generate"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            if r.returncode: warn("netplan generate failed: " + (r.stdout.strip().splitlines() or ["no output"])[-1])
            else: info(f"netplan: {wifi_net['wifi-netplan/']} WiFi file(s) restored, netplan generate done")
        else:
            warn("netplan not installed on this box; restored netplan WiFi files unused")
    if "system" in sel and mode == "auto":
        apply_passthrough(manifest, "auto")

    print()
    ok(f"restore complete: {restored} item(s) written.")
    if moved80:
        print(f"  {moved80} config file(s): earlier program paths changed to 8.0 paths")
    if appmanifests_total:
        print(f"  {appmanifests_skipped} game install record(s) skipped "
              "(game files not in archive; reinstall from Steam)")
    if w.get("profile"):
        print("  Waydroid: start a session to finish first boot "
              "(h96-waydroid, then launch it).")
    if mode == "open":
        print("  OPEN MODE: run the installer commands listed above to reinstall "
              "the features; your data is already in place for them.")
    if "system" in sel:
        print("  Run 'h96-display detect' to rebuild the HDMI sink cache (never restored).")
        if os.path.exists(HOTSPOT_CONF):
            print("  hotspot.conf restored; the hotspot itself stays off (h96-hotspot on to start it).")
    if vm.get("names") and not vm.get("disks_included"):
        print(f"  h96-vm: {len(vm['names'])} definition(s) restored without disk images; "
              "recreate disks with h96-vm create, or re-run backup --with-vm-disks.")
    if wifi_net["wifi-nm/"] or wifi_net["wifi-netplan/"]:
        print("  WiFi networks load at next boot (or now: sudo nmcli connection reload).")
    print("  Log out / back in for desktop config and autologin to take effect.")
    if audio_units(sel, pre) and not audio_stopped:
        if linger_on(user):
            print(f"  Audio: user services of {user} keep running across logout (linger on);"
                  " reboot, or run as that user: systemctl --user restart filter-chain.service wireplumber.service")
        else:
            print("  Audio: restored EQ and default output load at next login.")

if __name__ == "__main__":
    try:
        main()
    except (tarfile.TarError, EOFError, zlib.error):   # short or corrupt gz/zst stream
        die(f"archive damaged or incomplete: {ARCHIVE_OPENED}")
