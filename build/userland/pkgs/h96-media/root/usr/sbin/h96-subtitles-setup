#!/usr/bin/env python3
"""
h96-subtitles-setup - fetch the ASR engine and model for h96-subtitles.

WHY ON DEMAND: engine archive 28 MB, English model 310 MB, bilingual zh-en model 510 MB.
All are Apache-2.0 and could legally be bundled; size is the reason they are not. Nothing
proprietary is involved here, unlike the NPU inference runtime, which cannot be redistributed.

Every archive is checked against a pinned SHA-256 before extraction; a mismatch refuses the
install. Digests are also recorded in sha256sums.json and re-verified on later runs.

Deployed to /usr/sbin/h96-subtitles-setup.
"""
import hashlib, json, os, shutil, subprocess, sys, tarfile, tempfile, urllib.request

sys.path.insert(0, "/usr/lib/h96")

HOME    = "/var/lib/h96/subtitles"
BINDIR  = f"{HOME}/bin"
LIBDIR  = f"{HOME}/lib"
MODELS  = f"{HOME}/models"
SUMS    = f"{HOME}/sha256sums.json"

SHERPA_VER = "1.13.6"
ENGINE_URL = (f"https://github.com/k2-fsa/sherpa-onnx/releases/download/v{SHERPA_VER}/"
              f"sherpa-onnx-v{SHERPA_VER}-linux-aarch64-shared-cpu.tar.bz2")
MODEL_URLS = {
    "en": "https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/"
          "sherpa-onnx-streaming-zipformer-en-2023-06-26.tar.bz2",
    "zh-en": "https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/"
             "sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20.tar.bz2",
}
# sha256 pins, computed 2026-10-06 from the URLs above
PINS = {
    "engine": "3a11e89b5a12cd1f8809e385087df7194e8463ab240cf530e5d7cc6d7b27fae7",
    "en": "639e25b578e9e997131402199419c13a941f8e4e198e2da1ce57dbf5cf401282",
    "zh-en": "27ffbd9ee24ad186d99acc2f6354d7992b27bcab490812510665fa8f9389c5f8",
}


def banner(sub=""):
    try:
        from banner import banner as b
        b(sub)
    except Exception:
        pass


def die(m):
    print(f"h96-subtitles-setup: {m}", file=sys.stderr)
    sys.exit(1)


def need_root():
    if os.geteuid() != 0:
        die("needs root (try: sudo h96-subtitles-setup)")


def load_sums():
    try:
        return json.load(open(SUMS))
    except Exception:
        return {}


def save_sums(d):
    os.makedirs(HOME, exist_ok=True)
    json.dump(d, open(SUMS, "w"), indent=2, sort_keys=True)


def fetch(url, dest, label):
    print(f"  fetching {label} ...", flush=True)
    tmp = dest + ".part"
    try:
        with urllib.request.urlopen(url, timeout=60) as r, open(tmp, "wb") as fh:
            total = int(r.headers.get("Content-Length") or 0)
            got = 0
            while True:
                b = r.read(1 << 20)
                if not b:
                    break
                fh.write(b); got += len(b)
                if total:
                    print(f"\r    {got/1e6:6.0f} / {total/1e6:.0f} MB", end="", flush=True)
        print()
    except Exception as e:
        if os.path.exists(tmp):
            os.unlink(tmp)
        die(f"download failed: {e}")
    os.replace(tmp, dest)
    h = hashlib.sha256()
    with open(dest, "rb") as fh:
        for b in iter(lambda: fh.read(1 << 22), b""):
            h.update(b)
    return h.hexdigest()


def verify_pin(key, digest):
    if digest != PINS[key]:
        die(f"SHA-256 MISMATCH for {key}\n"
            f"  pinned:   {PINS[key]}\n  actual:   {digest}\n"
            "  Refusing to install (pins in PINS of this tool); nothing extracted.")
    print("    sha256 verified against the pinned digest")


def verify_or_record(key, digest, sums):
    if key in sums:
        if sums[key] != digest:
            die(f"SHA-256 MISMATCH for {key}\n"
                f"  recorded: {sums[key]}\n  actual:   {digest}\n"
                "  Refusing to install. Delete the recorded digest only if you are certain.")
        print(f"    sha256 verified against the recorded digest")
    else:
        sums[key] = digest
        print(f"    sha256 recorded: {digest[:32]}...")


def cmd_install(lang):
    need_root()
    if lang not in MODEL_URLS:
        die(f"unknown language '{lang}' (choose: {', '.join(MODEL_URLS)})")
    banner("S U B T I T L E S")
    print("  Everything here is Apache-2.0. Nothing proprietary is downloaded.\n")
    for d in (BINDIR, LIBDIR, MODELS):
        os.makedirs(d, exist_ok=True)
    sums = load_sums()
    tmp = tempfile.mkdtemp(prefix="h96-subs-setup-")
    try:
        # --- engine ---
        if os.path.isfile(f"{BINDIR}/sherpa-onnx"):
            print("  engine already installed")
        else:
            tgz = os.path.join(tmp, "engine.tar.bz2")
            digest = fetch(ENGINE_URL, tgz, f"sherpa-onnx {SHERPA_VER} (CPU, aarch64)")
            verify_pin("engine", digest)
            verify_or_record("engine", digest, sums)
            with tarfile.open(tgz, "r:bz2") as t:
                t.extractall(tmp)
            root = next((os.path.join(tmp, d) for d in os.listdir(tmp)
                         if os.path.isdir(os.path.join(tmp, d)) and d.startswith("sherpa-onnx-v")), None)
            if not root:
                die("unexpected archive layout for the engine")
            got = False
            for sub in ("bin", "."):
                p = os.path.join(root, sub, "sherpa-onnx")
                if os.path.isfile(p):
                    shutil.copy2(p, f"{BINDIR}/sherpa-onnx"); os.chmod(f"{BINDIR}/sherpa-onnx", 0o755); got = True
                    break
            if not got:
                die("sherpa-onnx binary not found inside the archive")
            for sub in ("lib", "."):
                d = os.path.join(root, sub)
                if os.path.isdir(d):
                    for f in os.listdir(d):
                        if ".so" in f:
                            shutil.copy2(os.path.join(d, f), os.path.join(LIBDIR, f))
            print(f"    installed {BINDIR}/sherpa-onnx")

        # --- model ---
        name = MODEL_URLS[lang].rsplit("/", 1)[-1].replace(".tar.bz2", "")
        if os.path.isdir(os.path.join(MODELS, name)):
            print(f"  model {name} already installed")
        else:
            tgz = os.path.join(tmp, "model.tar.bz2")
            digest = fetch(MODEL_URLS[lang], tgz, f"model {name}")
            verify_pin(lang, digest)
            verify_or_record(f"model:{lang}", digest, sums)
            with tarfile.open(tgz, "r:bz2") as t:
                t.extractall(MODELS)
            print(f"    installed {MODELS}/{name}")
        save_sums(sums)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print("\n  Done.  Try:   h96-subtitles file /path/to/video.mkv")
    print("  Measured here: RTF 0.124 on ONE A76 core, i.e. ~8x realtime.")
    print("  A 2-hour film takes roughly 15 minutes and leaves 7 cores free.\n")


def cmd_uninstall():
    need_root()
    if not os.path.isdir(HOME):
        print("  nothing installed"); return
    n = sum(len(f) for _, _, f in os.walk(HOME))
    sz = sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(HOME) for f in fs)
    shutil.rmtree(HOME, ignore_errors=True)
    print(f"  removed {HOME}  ({n} files, {sz/1e6:.0f} MB)")


def cmd_status():
    banner("S U B T I T L E S")
    eng = f"{BINDIR}/sherpa-onnx"
    print(f"  engine : {'installed at ' + eng if os.path.isfile(eng) else 'not installed'}"
          f"  (sherpa-onnx {SHERPA_VER}, 28 MB download)")
    for lang, url in MODEL_URLS.items():
        name = url.rsplit("/", 1)[-1].replace(".tar.bz2", "")
        size = "310 MB" if lang == "en" else "510 MB"
        state = "installed" if os.path.isdir(os.path.join(MODELS, name)) else "not installed"
        print(f"  model {lang:<6}: {state}  ({size} download)")
    print(f"  digests: {SUMS if os.path.isfile(SUMS) else 'none recorded'}")


USAGE = """h96-subtitles-setup - fetch the ASR engine and model

  sudo h96-subtitles-setup              install engine + English model (en)
  sudo h96-subtitles-setup --lang zh-en install engine + bilingual model instead
  h96-subtitles-setup status            show what is installed (no download)
  sudo h96-subtitles-setup --uninstall  remove everything it installed

Downloads: engine 28 MB, en model 310 MB, zh-en model 510 MB. All Apache-2.0, fetched
for size. Each archive is checked against a pinned SHA-256 before extraction.
"""


def usage_error(msg):
    print(f"h96-subtitles-setup: {msg}\n", file=sys.stderr)
    print(USAGE, file=sys.stderr)
    sys.exit(2)


def main(a):
    if not a:
        return cmd_install("en")
    if a[0] in ("-h", "--help"):
        print(USAGE)
    elif a[0] in ("status", "--status") and len(a) == 1:
        cmd_status()
    elif a[0] == "--uninstall" and len(a) == 1:
        cmd_uninstall()
    elif a[0] == "--lang" and len(a) == 2 and a[1] in MODEL_URLS:
        cmd_install(a[1])
    elif a[0] in MODEL_URLS and len(a) == 1:
        cmd_install(a[0])
    else:
        usage_error(f"unknown arguments: {' '.join(a)} (languages: {', '.join(MODEL_URLS)})")


if __name__ == "__main__":
    main(sys.argv[1:])
