#!/bin/bash
# h96-widevine-setup: fetches the Widevine L3 CDM (AsahiLinux widevine-installer, proprietary blob) and wires it system-wide for Chromium/Firefox DRM playback. L3 caps DRM streams at SD (~480p).

[ -r /usr/lib/h96/banner.sh ] && . /usr/lib/h96/banner.sh
command -v h96_banner >/dev/null 2>&1 || h96_banner() { :; }

set -e

case "${1:-}" in
  -h|--help)
    echo "usage: sudo h96-widevine-setup [status|remove]"
    echo "  (no argument)  download Widevine L3 CDM on request and wire Chromium/Firefox"
    echo "  status         show whether CDM is installed and Chromium is wired"
    echo "  remove         remove CDM and browser wiring"
    echo "  -h, --help     show this help"
    exit 0;;
esac

h96_banner "W I D E V I N E   S E T U P"

[ "$(id -u)" = 0 ] || { echo "h96-widevine-setup: needs root (sudo)" >&2; exit 1; }

# Pinned commit (repo publishes no release tags): main @ 2024-08-11
WVI_COMMIT="eab8c668ad3f9db27a444ee1f94b82d8f3ab5336"
WVI_URL="https://github.com/AsahiLinux/widevine-installer/archive/${WVI_COMMIT}.tar.gz"
WVI_SHA256="17ed53ad4073f4bc2bfd87087979bde73530370e2cedae57501cef10fbce1f5d"
# Same LaCrOS image the pinned installer names, fetched here and checked before use.
LACROS_BASE="https://commondatastorage.googleapis.com/chromeos-localmirror/distfiles"
LACROS_NAME="chromeos-lacros-arm64-squash-zstd"
LACROS_VERSION="120.0.6098.0"
LACROS_SHA256="38a57cc3975af68675a1219b00354f08890ff58d0c54b690dcf5d2dd904b1576"
CDM_SHA256="8cb3119cd4f319ea16546d3260b47fc8c81350e311cc053fc557ee3d994f693d"  # libwidevinecdm.so after the installer ELF fixup, 4K pages
DEST=/var/lib/widevine
WORK=$(mktemp -d /var/tmp/h96-widevine.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

# sha256 check; prints the pin name on mismatch
check_sha() {  # file pin-value pin-name
  local got
  got=$(sha256sum "$1" | cut -d' ' -f1)
  [ "$got" = "$2" ] && { echo "      sha256 verified ($3)"; return 0; }
  echo "sha256 mismatch for $1: expected $3=$2, got $got; nothing installed" >&2
  return 1
}

# Chromium bundle dir; a CDM symlinked at <bundle>/WidevineCdm loads for every user and survives profile-sync-daemon's tmpfs profiles.
CHROMIUM_BUNDLE_DIRS="/usr/lib/chromium /usr/lib/chromium-browser /usr/lib64/chromium /opt/chromium"

chromium_bundle_dir() {
  local d
  for d in $CHROMIUM_BUNDLE_DIRS; do
    if [ -e "$d/chromium" ] || [ -e "$d/chrome" ]; then echo "$d"; return 0; fi
  done
  return 1
}

wire_browsers() {
  # Chromium: system-wide bundle symlink; Firefox wiring is done by the installer itself.
  CDM_SRC="$DEST/WidevineCdm"
  [ -e "$CDM_SRC/manifest.json" ] || return 1
  local bdir
  if bdir=$(chromium_bundle_dir); then
    ln -sfn "$CDM_SRC" "$bdir/WidevineCdm"
    echo "  Chromium: wired system-wide at $bdir/WidevineCdm (all users)"
  else
    echo "  Chromium bundle dir not found; Chromium wiring skipped" >&2
    echo "  (Firefox wiring still applied by installer)" >&2
  fi
}

case "$1" in
  status)
    if [ -e "$DEST/WidevineCdm/manifest.json" ]; then
      echo "Widevine CDM: INSTALLED at $DEST"
      bdir=$(chromium_bundle_dir) && [ -L "$bdir/WidevineCdm" ] \
        && echo "  Chromium: wired at $bdir/WidevineCdm" \
        || echo "  Chromium: NOT wired (run: sudo h96-widevine-setup)"
    else
      echo "Widevine CDM: not installed (run: sudo h96-widevine-setup)"
    fi
    exit 0 ;;
  remove)
    rm -rf "$DEST" /etc/profile.d/gmpwidevine.sh /etc/profile.d/h96-widevine.sh \
           /usr/lib64/firefox/defaults/pref/gmpwidevine.js /usr/lib/environment.d/50-gmpwidevine.conf
    # upstream installer wiring under /usr/lib64 (symlink only), then folders it left empty
    [ -L /usr/lib64/chromium-browser/WidevineCdm ] && rm -f /usr/lib64/chromium-browser/WidevineCdm
    rmdir /usr/lib64/chromium-browser /usr/lib64/firefox/defaults/pref /usr/lib64/firefox/defaults \
          /usr/lib64/firefox /usr/lib64 2>/dev/null || true
    # remove ONLY our symlinks, never a package-bundled real CDM directory
    for d in $CHROMIUM_BUNDLE_DIRS; do
      [ -L "$d/WidevineCdm" ] && rm -f "$d/WidevineCdm"
    done
    # clean any stray per-user hint files written by older versions of this tool
    for h in /root /home/*; do
      rm -f "$h/.config/chromium/WidevineCdm/latest-component-updated-widevine-cdm" 2>/dev/null || true
    done
    echo "Widevine CDM removed."
    exit 0 ;;
esac

if [ -e "$DEST/WidevineCdm/manifest.json" ]; then
  wire_browsers
  echo "Widevine CDM already installed at $DEST; browser wiring refreshed."
  echo "Reinstall: sudo h96-widevine-setup remove, then run again."
  exit 0
fi

cat <<'EOF'
This installs the Widevine L3 content-decryption module so browser DRM
streams (Discovery+, Netflix, Prime, Disney+) can play.

  * The CDM is PROPRIETARY Google software, extracted from a ChromeOS
    recovery image downloaded from Google. It is not part of this image
    and is fetched now, on your request.
  * Download is a Chrome (LaCrOS) image, roughly 150 MB, for one 8 MB blob.
  * DRM streams cap at SD (~480p): this box is Widevine L3, on Android
    firmware too. A hardware limit; no firmware changes it.
  * Works in Chromium. Firefox wiring is set up but is best-effort.
  * EXPERIMENTAL: verify with https://bitmovin.com/demos/drm afterwards.

EOF
if [ -t 0 ]; then
  printf "Continue? [y/N] "
  read -r ans
  case "$ans" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac
fi

command -v curl >/dev/null || { echo "curl missing: sudo apt install curl" >&2; exit 1; }
command -v python3 >/dev/null || { echo "python3 missing" >&2; exit 1; }
if ! command -v unsquashfs >/dev/null; then
  echo "[deps] installing squashfs-tools (unsquashfs)..."
  apt-get install -y squashfs-tools || { echo "squashfs-tools install failed" >&2; exit 1; }
fi

echo "[1/4] fetching widevine-installer ${WVI_COMMIT:0:12} (MIT, AsahiLinux)..."
curl -fsSL "$WVI_URL" -o "$WORK/wvi.tar.gz"
check_sha "$WORK/wvi.tar.gz" "$WVI_SHA256" WVI_SHA256 || exit 1
tar -xzf "$WORK/wvi.tar.gz" -C "$WORK"
WVI_DIR=$(echo "$WORK"/widevine-installer-*)
[ -x "$WVI_DIR/widevine-installer" ] || chmod +x "$WVI_DIR/widevine-installer"

echo "[2/4] downloading Chrome (LaCrOS) image ${LACROS_VERSION} and extracting the CDM"
echo "      (large download; takes a while on this box)..."
mkdir -p "$WORK/dist"
curl -fL --progress-bar "$LACROS_BASE/$LACROS_NAME-$LACROS_VERSION" -o "$WORK/dist/$LACROS_NAME-$LACROS_VERSION" || {
  echo "LaCrOS image download failed; nothing installed" >&2; exit 1; }
check_sha "$WORK/dist/$LACROS_NAME-$LACROS_VERSION" "$LACROS_SHA256" LACROS_SHA256 || exit 1
# installer copies the verified local image (file://) instead of downloading again
yes | DISTFILES_BASE="file://$WORK/dist" LACROS_NAME="$LACROS_NAME" LACROS_VERSION="$LACROS_VERSION" \
  "$WVI_DIR/widevine-installer" || {
  echo "widevine-installer failed; nothing was changed outside $DEST" >&2
  exit 1
}
[ -e "$DEST/WidevineCdm/manifest.json" ] || { echo "install did not produce $DEST/WidevineCdm" >&2; exit 1; }
check_sha "$DEST/libwidevinecdm.so" "$CDM_SHA256" CDM_SHA256 || {
  rm -rf "$DEST" /etc/profile.d/gmpwidevine.sh /usr/lib/environment.d/50-gmpwidevine.conf \
    /usr/lib64/firefox/defaults/pref/gmpwidevine.js
  [ -L /usr/lib64/chromium-browser/WidevineCdm ] && rm -f /usr/lib64/chromium-browser/WidevineCdm
  echo "installed CDM removed again" >&2; exit 1; }

echo "[3/4] wiring Chromium system-wide (all users)..."
wire_browsers || echo "warning: CDM component not found under $DEST; Chromium wiring skipped" >&2

echo "[4/4] Firefox wiring (done by installer: /etc/profile.d/gmpwidevine.sh)..."

echo
echo "Widevine L3 installed."
echo "  * Restart the browser fully (all windows), then test:"
echo "      https://bitmovin.com/demos/drm"
echo "  * DRM streams play at SD (~480p): L3 hardware limit, see docs."
echo "  * Remove:  sudo h96-widevine-setup remove"
echo "  * Status:  sudo h96-widevine-setup status"
