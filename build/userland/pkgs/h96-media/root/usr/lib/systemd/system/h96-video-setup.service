[Unit]
Documentation=file:/usr/share/doc/h96-base/COMMANDS.md
Description=H96 hardware-video (rkmpp) first-boot setup (offline)
ConditionPathExists=!/var/lib/h96-video-setup-done
After=local-fs.target armbian-resize-filesystem.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/h96/h96-video-setup.sh
[Install]
WantedBy=multi-user.target
