# HDMI-CEC device (RK3588 dw-hdmi-qp-cec) defaults to root-only; grants the video group read/write so desktop tooling can use cec-ctl/cec-client.
SUBSYSTEM=="cec", KERNEL=="cec[0-9]*", GROUP="video", MODE="0660", TAG+="systemd"

# uinput: the CEC daemon injects key events through it; grants the input group access and ensures the node exists.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
