#!/bin/sh
# purge removes links, masks and seeded files created by postinst
set -e
dpkg-maintscript-helper rm_conffile /etc/modules-load.d/h96-bcmdhd.conf 8.0.0~r26~ h96-net -- "$@"
R="${DPKG_ROOT:-}"
rmlink() { [ -L "$R$1" ] && [ "$(readlink "$R$1")" = "$2" ] && rm -f "$R$1"; return 0; }
case "$1" in
purge)
  rmlink /etc/systemd/system/multi-user.target.wants/h96-dhcpcd-wlan0.service /usr/lib/systemd/system/h96-dhcpcd-wlan0.service
  rmlink /etc/systemd/system/multi-user.target.wants/h96-hotspot-repair.service /usr/lib/systemd/system/h96-hotspot-repair.service
  rmlink /etc/systemd/system/multi-user.target.wants/h96-wpa-supplicant-wlan0.service /usr/lib/systemd/system/h96-wpa-supplicant-wlan0.service
  rmlink /etc/systemd/system/systemd-rfkill.service /dev/null
  rmlink /etc/systemd/system/systemd-rfkill.socket /dev/null
  rm -f "$R/etc/wpa_supplicant/wpa_supplicant-wlan0.conf"
  ;;
esac
if [ "$1" = abort-install ]; then
  while read -r _ _ p; do
    if { [ -e "$R$p.h96-v72" ] || [ -L "$R$p.h96-v72" ]; } && ! { [ -e "$R$p" ] || [ -L "$R$p" ]; }; then
      mv -f "$R$p.h96-v72" "$R$p"
    fi
  done <<'EOF'
f 61c4d7ef6ac39336edeae68f65e9b7a762f9ac3f87548f20914c97d81731f68c /etc/modules-load.d/h96-bcmdhd.conf
f 62394ee76938d7bc6038d1414955acac8dfca08a5c27b327b0815bee29180388 /etc/systemd/system/h96-hotspot-repair.service
l /etc/systemd/system/h96-hotspot-repair.service /etc/systemd/system/multi-user.target.wants/h96-hotspot-repair.service
f 8f482ff2f3c45304de21169d3f3b486c090d38e9804bf93097903c08a97f1c1c /usr/local/bin/h96-hotspot
f 5de68cb5f5995a2b4d71fbf98b16b447e0e1bbadc76da7e15844ab926603c0cd /usr/local/bin/h96-wifi-connect
f 73383fc4086c89757acc102f86a4ae8426729f07979f18fefbf76f6b89445f57 /usr/local/bin/h96-wifi-diag
f 67a6a40d5beac76021959bb3970d8b00c3187eb55c23490b94231398464ce91e /usr/local/bin/h96-wol
EOF
fi
case "$1" in
remove)
  dpkg-divert --package h96-net --remove --no-rename --divert /usr/lib/firmware/brcm/BCM4362A2.hcd.distrib /usr/lib/firmware/brcm/BCM4362A2.hcd
  dpkg-divert --package h96-net --remove --rename --divert /lib/firmware/brcm/BCM4362A2.hcd.distrib /lib/firmware/brcm/BCM4362A2.hcd
  ;;
purge)
  dpkg-divert --package h96-net --remove --rename --divert /etc/udev/rules.d/10-wifi-disable-powermanagement.rules.distrib /etc/udev/rules.d/10-wifi-disable-powermanagement.rules
  ;;
abort-install|disappear)
  dpkg-divert --package h96-net --remove --rename --divert /etc/udev/rules.d/10-wifi-disable-powermanagement.rules.distrib /etc/udev/rules.d/10-wifi-disable-powermanagement.rules
  dpkg-divert --package h96-net --remove --no-rename --divert /usr/lib/firmware/brcm/BCM4362A2.hcd.distrib /usr/lib/firmware/brcm/BCM4362A2.hcd
  dpkg-divert --package h96-net --remove --rename --divert /lib/firmware/brcm/BCM4362A2.hcd.distrib /lib/firmware/brcm/BCM4362A2.hcd
  ;;
esac
if [ -z "$R" ] && [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
exit 0
