+// an RGA filter (scale_rkrga, vpp_rkrga) in --vf converts NV15/NV20 before the VO maps it
+static bool rga_filter_follows(struct mp_filter *vd)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+    if (!ctx->rga_vf) {
+        struct MPOpts *o = mp_get_config_group(NULL, vd->global, &mp_opt_root);
+        bool r = false;
+        for (int n = 0; o->vf_settings && o->vf_settings[n].name; n++) {
+            struct m_obj_settings *s = &o->vf_settings[n];
+            r |= s->enabled && strstr(s->name, "rkrga");
+            for (int i = 0; s->enabled && s->attribs && s->attribs[i]; i++)
+                r |= !!strstr(s->attribs[i], "rkrga");
+        }
+        talloc_free(o);
+        ctx->rga_vf = r ? 2 : 1;
+    }
+    return ctx->rga_vf == 2;
+}
