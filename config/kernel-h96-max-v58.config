# H96 Max V58 (RK3588) kernel options: the diff summary.
#
# This is NOT the file the build consumes. The Armbian framework takes a full
# kernel configuration; that file is config/linux-rk35xx-vendor.config, the
# exact .config the v6.0 kernel (6.1.115-h96) was built with. Copy it to
# userpatches/config/kernel/linux-rk35xx-vendor.config as the README says.
#
# This fragment lists the options that differ from a stock rockchip-rk3588
# vendor kernel and that the open-GPU, video, Bluetooth and controller stack
# depends on. Every value below matches config/linux-rk35xx-vendor.config; use
# it to read what changed, or to merge into a different base configuration
# (scripts/kconfig/merge_config.sh) at your own risk.
#
# Kernel source: armbian/linux-rockchip, branch rk-6.1-rkr5.1, commit
# 95e85f6cb496c75807c5b16f158853578e7e7d1b, plus patch/kernel/*.patch.

# --- Open Mali "Panthor" DRM driver (replaces the closed vendor Mali blob) ---
# Panfrost/PanVK (Mesa) run on top of this. Built as a module; it binds through
# the device tree.
CONFIG_DRM_PANTHOR=m

# --- Pressure Stall Information (required by Android/Waydroid; enables systemd-oomd) ---
# The stock rockchip-rk3588 kernel ships with CONFIG_PSI unset. Android 13's init and
# lmkd require PSI (/proc/pressure): without it the Waydroid LXC container boots and
# then dies in about 15 s. Active by default, no psi= boot argument needed.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# --- v6.0: cluster-aware scheduling ---
# The RK3588 exposes three CPU clusters: 4x Cortex-A55 (cpu0, cpu5, cpu6, cpu7),
# 2x Cortex-A76 (cpu1, cpu2) and 2x Cortex-A76 (cpu3, cpu4); the A76 pairs are
# separate DVFS clusters. SCHED_CLUSTER adds the CLS scheduling domain so the
# scheduler sees that layout instead of one flat group. Topology correctness
# only; no throughput change was measured and none is claimed.
CONFIG_SCHED_CLUSTER=y

# --- v6.0: BPF Type Format (BTF) ---
# /sys/kernel/btf/vmlinux describes the kernel's types and every module exports
# its own, so bpftool, bcc, bpftrace kprobes and CO-RE BPF programs read kernel
# types without kernel headers.
# BTF is data read by BPF tools; the machine code is the same with or without
# it. DWARF is generated at build time for pahole and stripped from the Image.
# The Armbian framework turns these on by itself; do not pass KERNEL_BTF=no.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# --- v6.0: secure OTP driver off ---
# The vendor secure-OTP nvmem driver is not used on this board; disabled by
# config rather than by patching the source.
# CONFIG_NVMEM_ROCKCHIP_SEC_OTP is not set

# --- v6.0: release string and module symbol versioning ---
# The kernel reports 6.1.115-h96 and its modules install to /lib/modules/6.1.115-h96.
# MODVERSIONS gives every module symbol versions, so the loader rejects a module built
# against a different kernel layout instead of loading it unchecked. Install the modules
# built with this kernel (make modules_install from the same tree); a module set from
# another build does not load on it.
CONFIG_LOCALVERSION="-h96"
CONFIG_MODVERSIONS=y

# --- v6.0: realtime scheduling outside the root cgroup ---
# The vendor Android config enables RT_GROUP_SCHED, which confines SCHED_FIFO/SCHED_RR
# to cgroups with an rt_runtime allocation; on a systemd system that is the root cgroup
# only, so rtkit could not raise PipeWire's data-loop threads ("Failed to make ourselves
# RT: Operation not permitted") and cyclictest refused to run. With it off, PipeWire's
# data-loop threads run at SCHED_RR priority 20 through rtkit and keep their priority
# under CPU load. The Armbian framework sets this option back to y for Docker; the
# board file's custom_kernel_config hook turns it off again.
# CONFIG_RT_GROUP_SCHED is not set

# --- Rockchip VPU / hardware video decode (used by the mpv + Rockchip-MPP stack) ---
# Built in, as in the vendor configuration.
CONFIG_VIDEO_ROCKCHIP_VDEC=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
# ROCKCHIP_IEP has no Kconfig entry in the rk-6.1-rkr5.1 vendor tree; not set here.

# --- IR: mainline gpio-ir-receiver (rc-core) for the front-IR overlay in patch/overlays ---
# IR_GPIO_CDEV has no Kconfig entry in the rk-6.1-rkr5.1 vendor tree; the gpio-ir-receiver
# driver is IR_GPIO_CIR. Scancode learning with ir-keytable uses rc-core and evdev; the
# LIRC character device is not built.
CONFIG_IR_GPIO_CIR=m
CONFIG_RC_CORE=y
# CONFIG_LIRC is not set

# --- PCIe (onboard WiFi 6 is a PCIe BCM43752/AP6275P, NOT SDIO) ---
CONFIG_PCIE_DW_ROCKCHIP=y
CONFIG_PCIEASPM=y

# --- Bluetooth RFCOMM (Hands-Free profile = headset MICROPHONE) ---
# The stock rockchip-rk3588 kernel builds core Bluetooth (=m) but leaves RFCOMM
# out. HFP/HSP run over RFCOMM, so without it a Bluetooth headset can play audio
# (A2DP) but its mic never works ("socket(RFCOMM): Protocol not supported"), and
# the audio stack falls back to A2DP-only roles. Built as a module; it autoloads
# through packages/bsp/h96-max-v58/modules-load.d/rfcomm.conf and
# packages/bsp/h96-max-v58/systemd/h96-rfcomm.service, and the HFP roles in
# packages/bsp/h96-max-v58/wireplumber/30-h96-bluetooth.conf then expose the
# headset mic.
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y

# --- USB game controllers (X-input pads + 2.4GHz dongles: Xbox and others) ---
# The base rk3588 kernel shipped no xpad at all, so X-input dongles did nothing
# over USB (only D-input/HID worked). Built as a module; it autoloads through
# packages/bsp/h96-max-v58/modules-load.d/xpad.conf and h96-rfcomm.service, and
# packages/bsp/h96-max-v58/udev/99-h96-xpad.rules force-binds any X-input
# interface whose USB product id is not in xpad's table.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
# v6.0: player LEDs and force feedback; dongles that wait for the player-LED command (8BitDo Ultimate 2C) need LEDS.
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_JOYSTICK_XPAD_FF=y
