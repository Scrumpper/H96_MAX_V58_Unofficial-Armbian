# Kernel config fragment for the H96 Max V58 (RK3588). Merge into the
# Armbian kernel .config (edge/mainline branch) before building.
#
# The board otherwise builds on a standard rockchip-rk3588 kernel; these
# are the options that matter for the open-GPU + video + panel stack.

# --- Open Mali "Panthor" DRM driver (replaces the closed vendor Mali blob) ---
# Panfrost/PanVK (Mesa) run on top of this. Present in mainline >= 6.10 and in
# Armbian's edge kernel. Build as a module so it binds via the device tree.
CONFIG_DRM_PANTHOR=m

# --- Pressure Stall Information (required by Android/Waydroid; enables systemd-oomd) ---
# The stock rockchip-rk3588 kernel ships with CONFIG_PSI unset. Android 13's init and
# lmkd hard-require PSI (/proc/pressure): without it the Waydroid LXC container boots and
# then dies in ~15s. Enabling it (active by default, no psi= boot arg needed) also lets
# systemd-oomd shed memory pressure gracefully instead of the box hard-freezing under a
# heavy Steam/emulator/Android load.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# --- Rockchip VPU / hardware video decode (used by the mpv + Rockchip-MPP stack) ---
CONFIG_VIDEO_ROCKCHIP_VDEC=m
CONFIG_ROCKCHIP_IEP=m
CONFIG_V4L_MEM2MEM_DRIVERS=y

# --- IR: mainline gpio-ir-receiver (rc-core) for the front-IR overlay in patch/overlays ---
CONFIG_IR_GPIO_CDEV=m
CONFIG_RC_CORE=y
CONFIG_LIRC=y

# --- PCIe (onboard WiFi 6 is a PCIe BCM43752/AP6275P, NOT SDIO) ---
CONFIG_PCIE_ROCKCHIP_DW=y
CONFIG_PCIEASPM=y

# --- Bluetooth RFCOMM (Hands-Free profile = headset MICROPHONE) ---
# The stock rockchip-rk3588 kernel builds core Bluetooth (=m) but leaves RFCOMM
# out. HFP/HSP run over RFCOMM, so without it a Bluetooth headset can play audio
# (A2DP) but its mic never works ("socket(RFCOMM): Protocol not supported"), and
# the audio stack falls back to A2DP-only roles. Build RFCOMM as a module; it
# autoloads via packages/bsp/.../modules-load.d/rfcomm.conf, and the HFP roles in
# packages/bsp/.../wireplumber/30-h96-bluetooth.conf then expose the headset mic.
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y

# --- USB game controllers (X-input pads + 2.4GHz dongles: Xbox and others) ---
# The base rk3588 kernel shipped no xpad at all, so X-input dongles did nothing
# over USB (only D-input/HID worked). Build xpad as a module; it autoloads via
# packages/bsp/.../modules-load.d/xpad.conf, and udev/99-h96-xpad.rules force-binds
# any X-input-interface device whose USB product id is not in xpad's table.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
